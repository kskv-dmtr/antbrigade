# Заголовки для Cloudflare Pages. Файл копируется в dist как есть.
# Внимание: Astro собирает страницы файлами вида slug.html, и хостинг должен
# отдавать их без расширения. У Vercel за это отвечает cleanUrls в vercel.json;
# Cloudflare Pages делает это сам.

# Иконки лежат под неизменными именами: icon-512.png остаётся icon-512.png,
# даже когда картинка внутри другая. Поэтому кэш короткий и с перепроверкой:
# годовой immutable однажды уже оставил на телефонах июльскую иконку после
# августовской замены. Файлов пять и они мелкие, ответ «не изменилось»
# стоит копейки.
/icons/*
  Cache-Control: public, max-age=3600, must-revalidate

# Имя файла обложки содержит идентификатор вложения из Notion и меняется
# вместе с картинкой, поэтому кэшировать можно навсегда.
/covers/*
  Cache-Control: public, max-age=31536000, immutable

# Тип отдаётся явно: без него часть браузеров игнорирует манифест.
# Кэш короткий, чтобы правки манифеста доезжали быстро.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

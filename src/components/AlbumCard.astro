---
import { coverSrc, coverSrcSet } from '../lib/db.js';

// всё лишнее (data-* для фильтров) пробрасывается на <li> как есть
const { album, showArtist = true, ...rest } = Astro.props;
---
<li class="card" {...rest}>
  <a href={`/albums/${album.slug}`}>
    <div class="card__art">
      {album.cover && (
        <img
          src={coverSrc(album, 400)}
          srcset={coverSrcSet(album)}
          sizes="(max-width: 640px) 45vw, 200px"
          width="400"
          height="400"
          loading="lazy"
          decoding="async"
          alt=""
        />
      )}
    </div>
    {showArtist && <div class="card__artist">{album.artist}</div>}
    <div class="card__album">{album.album}</div>
    {album.year && <div class="card__meta">{album.year}</div>}
  </a>
</li>

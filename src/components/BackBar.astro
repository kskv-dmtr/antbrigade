---
/* Полоса с кнопкой «назад» на внутренних страницах — релиза, клипа,
   исполнителя.

   Устроена как полоса раздела на витрине: две равные половины, высота 64,
   во всю ширину экрана, вертикальная черта ровно посередине, липкая. Слева
   кнопка — ровно так же, как справа на витрине стоит View all: занимает
   свою половину целиком, подпись по центру, 12 кеглем Medium. Справа пока
   пусто; половина держит черту.

   Кнопка, а не ссылка, и не всегда: возвращаться по истории есть куда
   только когда пришли изнутри сайта. Пришли из поиска или по ссылке из
   переписки — history.back() увёл бы с сайта совсем, а кнопка обещает
   обратное; полоса тогда не показывается вовсе. Ровно то же правило, что
   было у кнопки в строке пути, откуда она сюда и переехала. */
---
<div class="head head--sticky head--dot head--backbar" hidden>
  <button type="button" class="back-bar">
    <span class="back-bar__caret" aria-hidden="true"></span>Back
  </button>
  <div class="head__side" aria-hidden="true"></div>
</div>

<script is:inline>
  (function () {
    var полоса = document.currentScript.previousElementSibling;
    var кнопка = полоса && полоса.querySelector('.back-bar');
    if (!кнопка) return;

    var откуда = document.referrer;
    if (!откуда || откуда.indexOf(location.origin + '/') !== 0) return;

    полоса.hidden = false;
    кнопка.addEventListener('click', function () { history.back(); });
  })();
</script>

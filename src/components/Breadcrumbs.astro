---
/* Путь до страницы: раздел, необязательные промежуточные звенья и текущая
   запись.

   Только на внутренних страницах — у списков разделов путь состоял бы из
   одного звена, а в меню наверху текущий раздел и так подчёркнут. Первым
   звеном не ставим главную: на неё ведёт слово слева в шапке, и в коротком
   пути «ant brigade / Music / …» первое звено — шум.

   Промежуточным звеном у релиза и клипа идёт исполнитель: на сайте релиз и
   называется «исполнитель — альбом», а его дискография живёт как раз на
   странице исполнителя. У соавторов выводим всех — выбирать «главного» из
   двоих значило бы решать за составителя, а в Notion их порядок ничего не
   значит. Таких релизов два десятка из тысячи.

   Последнее звено не ссылка: это страница, на которой человек уже стоит.
   Оно повторяет заголовок ниже, но у пути своя работа — показать, откуда
   пришёл и куда вернуться. */

const { section, trail = [], name } = Astro.props;
---
<nav class="crumbs mono mono--sm" aria-label="Breadcrumb">
  <a href={section.href}>{section.label}</a>

  {trail.length > 0 && (
    <>
      <span class="crumbs__sep" aria-hidden="true">/</span>
      {/* Соавторы внутри одного звена: между ними точка, а не косая черта —
          косая читалась бы как ещё один уровень вложенности, которого нет. */}
      <span class="crumbs__trail">
        {trail.map((звено, i) => (
          <>
            {i > 0 && <span class="sep"> · </span>}
            <a href={звено.href}>{звено.label}</a>
          </>
        ))}
      </span>
    </>
  )}

  <span class="crumbs__sep" aria-hidden="true">/</span>
  <span class="crumbs__here">{name}</span>
</nav>

---
/* Путь до страницы и кнопка «назад» над ним.

   В пути стоят только имена — исполнитель, лейбл, жанр, название релиза.
   Слов-разделов больше нет: «Music», «Artists», «Videos», «Labels» и
   «Genres» и так стоят в шапке строкой выше, и в пути они занимали место,
   ничего не добавляя. Осталось то, что бывает только здесь.

   Первое звено — место, откуда пришли, если пришли из каталога: со
   страницы жанра, лейбла или исполнителя. Механика в скрипте под
   разметкой.

   Промежуточным звеном у релиза и клипа идёт исполнитель: на сайте релиз и
   называется «исполнитель — альбом», а его дискография живёт как раз на
   странице исполнителя. У соавторов выводим всех — выбирать «главного» из
   двоих значило бы решать за составителя, а в Notion их порядок ничего не
   значит. Таких релизов два десятка из тысячи.

   Последнее звено не ссылка: это страница, на которой человек уже стоит.

   place — эта страница сама может стать местом, куда возвращаются.
   Ставится у жанра, лейбла и исполнителя; у релиза и клипа нет:
   возвращаться «в релиз» из соседнего релиза незачем. */

import Icon from './Icon.astro';

const { trail = [], name, place = false } = Astro.props;

/* У жанра, лейбла и исполнителя промежуточных звеньев нет, и без
   слова-раздела путь состоял бы из одного имени — того самого, что стоит
   заголовком строкой ниже. Такую строку прячем целиком и показываем,
   только когда в неё есть что поставить: кнопку «назад» или место, откуда
   пришли. */
const bare = trail.length === 0;
---
<nav
  class="crumbs mono mono--sm"
  aria-label="Breadcrumb"
  data-place={place ? name : undefined}
  hidden={bare}
>
  <button type="button" class="crumbs__back" hidden>
    <Icon name="caret-left" class="crumbs__chevron" />Back
  </button>

  {/* Пустая заготовка под место, откуда пришли: адрес и имя подставляет
      скрипт. Отдавать её с сервера заполненной нечем — сервер один на всех,
      а пришёл каждый по-своему. */}
  <a class="crumbs__from" hidden></a>

  {trail.length > 0 && (
    <>
      {/* Своя черта у подставленного звена нужна только когда за ним идёт
          исполнитель. Без него черту рисует хвост, и вторая была бы лишней. */}
      <span class="crumbs__sep" data-sep="from" aria-hidden="true" hidden>/</span>

      {/* Соавторы внутри одного звена: между ними точка, а не косая черта —
          косая читалась бы как ещё один уровень вложенности, которого нет. */}
      <span class="crumbs__trail">
        {trail.map((звено, i) => (
          <>
            {i > 0 && <span class="sep"> · </span>}
            <a href={звено.href}>{звено.label}</a>
          </>
        ))}
      </span>
    </>
  )}

  {/* Название и черта перед ним — одним куском: сжимаются вместе, и когда
      места не остаётся вовсе, черта исчезает вместе с названием. Порознь
      путь обрывался бы висящей косой в конце — так и было, пока кнопка не
      забрала себе семьдесят пикселей. */}
  <span class="crumbs__tail" hidden={bare}>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__here">{name}</span>
  </span>
</nav>

{/* Скрипт стоит вплотную под разметкой и намеренно is:inline: обычный Astro
    собирает в модуль, а тот выполняется после разбора страницы — строка
    успела бы отрисоваться пустой и на глазах наполниться.

    Имя места берём не из адреса, а из sessionStorage: по /genres/post-punk
    восстанавливается только огрызок «post punk», а настоящее написание —
    «Post-Punk», и у имён вроде «O’Flynn» из адреса не выйдет вовсе. Поэтому
    каждая страница-место записывает своё имя сама, а следующая читает — но
    применяет, только если записанный адрес совпал с document.referrer. Без
    совпадения (пришли из поиска, из закладки, по ссылке из переписки)
    строка остаётся такой, какой её отдал сервер.

    Записываем после чтения, а не до: в хранилище лежит имя предыдущей
    страницы, и обратный порядок затёр бы его собой. */}
<script is:inline>
  (function () {
    var nav = document.currentScript.previousElementSibling;
    if (!nav || !nav.classList.contains('crumbs')) return;

    var KEY = 'crumb';
    // Адреса сравниваем без расширения: снаружи Vercel отдаёт их чистыми,
    // но по прямой ссылке на .html человек тоже может прийти.
    var clean = function (p) { return p.replace(/\.html$/, ''); };

    var back    = nav.querySelector('.crumbs__back');
    var from    = nav.querySelector('.crumbs__from');
    // Своей черты у подставленного звена нет там, где нет исполнителя.
    var fromSep = nav.querySelector('[data-sep="from"]');
    var tail    = nav.querySelector('.crumbs__tail');
    var trail   = nav.querySelector('.crumbs__trail');

    var ref = document.referrer;
    var inside = !!ref && ref.indexOf(location.origin + '/') === 0;

    /* Кнопка «назад» — только когда возвращаться есть куда внутри сайта.
       Пришли из поиска или по ссылке из переписки — history.back() увёл бы
       с сайта совсем, а кнопка обещает обратное. */
    if (inside) {
      back.hidden = false;
      nav.hidden = false;
      back.addEventListener('click', function () { history.back(); });
    }

    var was = null;
    try { was = JSON.parse(sessionStorage.getItem(KEY)); } catch (e) {}

    if (was && inside && clean(new URL(ref).pathname) === was.p) {
      var links = trail ? trail.getElementsByTagName('a') : [];
      var already = false;

      /* Если место уже стоит в пути, подставлять его нечего: со страницы
         исполнителя на его же релиз дало бы «Lusine / Lusine / …». */
      for (var i = 0; i < links.length; i++) {
        if (links[i].getAttribute('href') === was.p) already = true;
      }

      if (!already) {
        from.href = was.p;
        from.textContent = was.l;
        from.hidden = false;
        if (fromSep) fromSep.hidden = false;
        nav.hidden = false;
        // На странице места собственное имя показываем только теперь, когда
        // перед ним появился путь и оно перестало быть строкой в одиночку.
        tail.hidden = false;
      }
    }

    if (nav.dataset.place) {
      try {
        sessionStorage.setItem(KEY, JSON.stringify({
          p: clean(location.pathname), l: nav.dataset.place
        }));
      } catch (e) {}
    }
  })();
</script>

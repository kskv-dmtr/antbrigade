---
/* Карточка указателя имён — то, чем становится строка в плиточном виде.

   Два ряда, в каждом слева имя собственное, справа величина, разводит их
   space-between: тот же приём, что в строке списка и в полосе жанра.

   Первый ряд — имя и пометка при нём: у исполнителя и лейбла страна, у
   жанра счётчик релизов. Второй — счёт того, из чего запись состоит:
   релизы и клипы у исполнителя, релизы и исполнители у лейбла, одни
   исполнители у жанра.

   Обложек в карточке нет: у исполнителя, лейбла и жанра своей картинки не
   бывает, а собирать её из обложек релизов — значит показывать чужое.
   Плитки с обложками релизов внутри стояли здесь до 5 сентября 2026 и были
   убраны ровно поэтому.

   Сама карточка и есть ячейка решётки (класс view-tile на ней же): поле и
   линии берёт у ячейки, а заливка по наведению ложится на всю ячейку, а не
   на текст внутри — как у строки списка. */

/* Полный адрес картинки из короткой метки: «c» — обложка релиза, «v» —
   кадр клипа. Тот же вид меток, что в указателе поиска. */
const адрес = (м) =>
  м[0] === 'c' ? `/covers/${м.slice(1)}-400.webp` : `/videos/${м.slice(1)}-480.webp`;

const { href, name, note, left, right, covers, counts } = Astro.props;
---
<a class="brief view-tile" href={href}>
  {/* Рамка с обложкой — пока только у исполнителей (19 сентября 2026, проба
      владельца): поле 16:9 ровно в размер кадра клипа на /video, по углам
      Г-образные фигуры, как у обложки на странице релиза, по центру —
      квадратом обложка свежего релиза исполнителя. cover === undefined —
      рамки нет вовсе (лейблы, жанры); null — рамка без обложки. */}
  {/* Миниатюра — обложка одного из релизов записи: квадрат по центру поля,
      по углам поля Г-образные фигуры, как у обложки на странице релиза
      (20 сентября 2026, просьба владельца). Нет обложек — остаются одни
      фигуры.

      Меток несколько: какую показать, решает скрипт ниже при каждой
      загрузке. Первая стоит в разметке — она же видна без скрипта. */}
  {covers !== undefined && (
    <span class="brief__art" aria-hidden="true" data-covers={covers.join(' ')}>
      {covers[0] && (
        <img src={адрес(covers[0])} alt="" width="400" height="400" loading="lazy" decoding="async" />
      )}
    </span>
  )}
  <span class="brief__line">
    <span class="brief__name">{name}</span>
    {note && <span class="brief__note">{note}</span>}
  </span>

  {/* Опись — одной строкой через точку, как подпись под плиткой на Music
      и Video (20 сентября 2026, просьба владельца; до того стояла
      столбцом, по строке на род). */}
  {counts ? (
    <span class="brief__sub">{counts.join(' · ')}</span>
  ) : (
    <span class="brief__line brief__line--sub">
      <span>{left}</span>
      {right && <span>{right}</span>}
    </span>
  )}
</a>

<script>
  /* Какую из обложек записи показать — решается здесь, при каждой загрузке
     страницы: тот же приём, что у «Random Picks» на витрине и у находок
     поиска (20 сентября 2026, просьба владельца). Жребий при сборке обложку
     не обновлял — без нового коммита сайт не пересобирается.

     Скрипт один на страницу, сколько бы карточек на ней ни было. Меняем src
     до того, как картинка попала в поле зрения: все они ленивые, и браузер
     ещё не начинал их грузить — подмена ничего не перерисовывает. */
  const адрес = (м) =>
    м[0] === 'c' ? `/covers/${м.slice(1)}-400.webp` : `/videos/${м.slice(1)}-480.webp`;

  for (const поле of document.querySelectorAll('.brief__art[data-covers]')) {
    const метки = поле.dataset.covers.split(' ').filter(Boolean);
    const картинка = поле.querySelector('img');
    if (метки.length < 2 || !картинка) continue;

    картинка.src = адрес(метки[Math.floor(Math.random() * метки.length)]);
  }
</script>

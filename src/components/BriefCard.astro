---
/* Карточка указателя имён — то, чем становится строка в плиточном виде.

   Два ряда, в каждом слева имя собственное, справа величина, разводит их
   space-between: тот же приём, что в строке списка и в полосе жанра.

   Первый ряд — имя и пометка при нём: у исполнителя и лейбла страна, у
   жанра счётчик релизов. Второй — счёт того, из чего запись состоит:
   релизы и клипы у исполнителя, релизы и исполнители у лейбла, одни
   исполнители у жанра.

   Обложек в карточке нет: у исполнителя, лейбла и жанра своей картинки не
   бывает, а собирать её из обложек релизов — значит показывать чужое.
   Плитки с обложками стояли здесь до 5 сентября 2026 и были убраны ровно
   поэтому; 20 сентября их вернули на день, а 21-го убрали снова — вместе с
   пробой узора из квадратов и кругов (просьба владельца).

   Сама карточка и есть ячейка решётки (класс view-tile на ней же): поле и
   линии берёт у ячейки, а заливка по наведению ложится на всю ячейку, а не
   на текст внутри — как у строки списка. */

const { href, name, note, left, right, counts } = Astro.props;
---
<a class="brief view-tile" href={href}>
  <span class="brief__line">
    <span class="brief__name">{name}</span>
    {note && <span class="brief__note">{note}</span>}
  </span>

  {/* Опись — по строке на род, с тонкой чертой между ними (21 сентября
      2026, просьба владельца; так она уже стояла 20 сентября, потом была
      строкой через точку). Стоит сразу под именем. */}
  {/* Строка описи — либо готовая строка («2 Albums»), либо пара [род,
      число]: тогда род слева, число в квадратных скобках справа, «Albums
      [2]», разведены space-between (у исполнителя, лейбла и жанра, 21–22
      сентября 2026). */}
  {counts ? (
    <span class="brief__counts">
      {counts.map((строка) => Array.isArray(строка)
        ? <span class="brief__count brief__count--split"><span>{строка[0]}</span><span>[{строка[1]}]</span></span>
        : <span class="brief__count">{строка}</span>)}
    </span>
  ) : (
    <span class="brief__line brief__line--sub">
      <span>{left}</span>
      {right && <span>{right}</span>}
    </span>
  )}
</a>

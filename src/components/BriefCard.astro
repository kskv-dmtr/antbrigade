---
/* Карточка указателя имён — то, чем становится строка в плиточном виде.

   Два ряда, в каждом слева имя собственное, справа величина, разводит их
   space-between: тот же приём, что в строке списка и в полосе жанра.

   Первый ряд — имя и пометка при нём: у исполнителя и лейбла страна, у
   жанра счётчик релизов. Второй — счёт того, из чего запись состоит:
   релизы и клипы у исполнителя, релизы и исполнители у лейбла, одни
   исполнители у жанра.

   Обложек в карточке нет: у исполнителя, лейбла и жанра своей картинки не
   бывает, а собирать её из обложек релизов — значит показывать чужое.
   Плитки с обложками релизов внутри стояли здесь до 5 сентября 2026 и были
   убраны ровно поэтому.

   Сама карточка и есть ячейка решётки (класс view-tile на ней же): поле и
   линии берёт у ячейки, а заливка по наведению ложится на всю ячейку, а не
   на текст внутри — как у строки списка. */

const { href, name, note, left, right, cover, counts } = Astro.props;
---
<a class="brief view-tile" href={href}>
  {/* Рамка с обложкой — пока только у исполнителей (19 сентября 2026, проба
      владельца): поле 16:9 ровно в размер кадра клипа на /video, по углам
      Г-образные фигуры, как у обложки на странице релиза, по центру —
      квадратом обложка свежего релиза исполнителя. cover === undefined —
      рамки нет вовсе (лейблы, жанры); null — рамка без обложки. */}
  {/* Миниатюра — обложка одного из релизов записи, выбранная наугад при
      сборке: квадрат в четверть карточки, ровно по её середине (20 сентября
      2026, проба владельца). */}
  {cover && (
    <img class="brief__thumb" src={cover} alt="" width="400" height="400" loading="lazy" decoding="async" />
  )}
  <span class="brief__line">
    <span class="brief__name">{name}</span>
    {note && <span class="brief__note">{note}</span>}
  </span>

  {/* Опись — по строке на род, с тонкой чертой между ними (20 сентября
      2026, просьба владельца; до того — одной строкой через точку, как в
      списке). Прижата к низу карточки. */}
  {counts ? (
    <span class="brief__counts">
      {counts.map((строка) => <span class="brief__count">{строка}</span>)}
    </span>
  ) : (
    <span class="brief__line brief__line--sub">
      <span>{left}</span>
      {right && <span>{right}</span>}
    </span>
  )}
</a>

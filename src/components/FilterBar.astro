---
/* Полоса отбора — отдельной строкой под заголовком, одной ячейкой.

   Слева слово «Filters» — оно называет строку целиком, как имя называет
   отдельный отбор. Справа сами отборы: имя с двоеточием, за ним список, и
   так все пять — тип, жанр, год, сортировка и, самым крайним, вид.

   Перемычек внутри нет: столбцы стояли здесь 5 сентября 2026 несколько
   часов и мешали — отборы разной длины сидели каждый в своей четверти, и
   глазу приходилось прыгать через пустоту от имени к списку.

   Полоса липкая и встаёт под заголовок раздела: обе держатся на экране,
   пока листаешь каталог.

   На телефоне, с 18 сентября 2026 (просьба владельца), полоса другая: слева
   кнопка «Filters», справа Grid / List. Кнопка открывает
   снизу шторку со всеми отборами и сортировкой — это тот же набор отборов,
   .filters-row__set, только выложенный столбцом. До того отборы стояли одной
   строкой, уезжавшей за край экрана, и дальние приходилось искать сдвигом
   вбок. Кнопка, заголовок шторки, второй переключатель вида и затемнение
   есть в разметке всегда, а показывает их только мобильный медиазапрос. */

import Icon from './Icon.astro';
import ViewSwitch from './ViewSwitch.astro';
---
<div class="filters-row">
  {/* Счётчик применённых отборов — в квадратных скобках за словом, на всех
      ширинах (18 сентября 2026, просьба владельца). Пишет его скрипт ниже. */}
  <span class="filters-row__name">Filters<span class="filters-row__count"></span></span>

  <button
    type="button"
    class="filters-row__toggle"
    aria-expanded="false"
    aria-controls="filters-sheet"
  >
    {/* Подпись без треугольника, набрана как Grid / List справа (18 сентября
        2026, просьба владельца): линия под словом — у открытой шторки. */}
    <span class="filters-row__label">Filters<span class="filters-row__count"></span></span>
  </button>

  <div class="filters-row__set" id="filters-sheet" role="dialog" aria-label="Filters">
    <div class="filters-row__head">
      <span class="filters-row__title">Filters</span>
      <button type="button" class="filters-row__close" aria-label="Close filters">
        <Icon name="x" class="filters-row__close-x" />
      </button>
    </div>
    <slot />

    {/* Кнопка внизу шторки (18 сентября 2026, просьба владельца). Отборы
        срабатывают сразу, по выбору, — Apply закрывает шторку и, если страница
        уже ушла ниже начала списка, возвращает к нему: найденное начинается
        сверху. */}
    <div class="filters-row__foot">
      <button type="button" class="filters-row__apply">Apply</button>
    </div>
  </div>

  {/* Переключатель вида на телефоне стоит в самой полосе, справа, а в шторке
      его нет: выбирают вид взглядом, и прятать его за кнопку незачем. */}
  <span class="filters-row__view"><ViewSwitch /></span>

  <div class="filters-row__scrim" aria-hidden="true"></div>
</div>

<script>
  /* Шторка отборов на телефоне. Открывается кнопкой «Filters», закрывается
     крестиком в своём заголовке, нажатием на затемнение и клавишей Escape.
     Состояние — атрибут на полосе, как у меню и поиска в шапке: по нему CSS
     выдвигает шторку и прячет прокрутку страницы под ней. */
  const полоса = document.querySelector('.filters-row');
  const кнопка = полоса?.querySelector('.filters-row__toggle');

  if (полоса && кнопка) {
    const узкий = matchMedia('(max-width: 640px)');

    const шторка = (on) => {
      полоса.toggleAttribute('data-sheet', on);
      кнопка.setAttribute('aria-expanded', String(on));
      if (!on) {
        // Раскрытые списки внутри закрываем вместе со шторкой.
        for (const список of полоса.querySelectorAll('details.multi[open]')) список.open = false;
        for (const коробка of полоса.querySelectorAll('.select[data-open]')) коробка._раскрыть?.(false);
      }
    };

    кнопка.addEventListener('click', () => шторка(!полоса.hasAttribute('data-sheet')));
    полоса.querySelector('.filters-row__close')?.addEventListener('click', () => {
      шторка(false);
      кнопка.focus();
    });
    полоса.querySelector('.filters-row__scrim')?.addEventListener('click', () => шторка(false));

    полоса.querySelector('.filters-row__apply')?.addEventListener('click', () => {
      шторка(false);
      const верх = полоса.getBoundingClientRect().top;
      if (верх < 0) scrollTo({ top: scrollY + верх, behavior: 'smooth' });
    });

    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !полоса.hasAttribute('data-sheet')) return;
      // Открытый список внутри закрывается своим обработчиком — сначала он.
      if (полоса.querySelector('details.multi[open]')) return;
      шторка(false);
      кнопка.focus();
    });

    // На широком экране шторки нет: забытое «открыто» держало бы страницу
    // без прокрутки.
    узкий.addEventListener('change', () => шторка(false));

    const набор = полоса.querySelector('.filters-row__set');
    const списки = [...набор.querySelectorAll('details.multi')];

    /* Сортировка в шторке — раскрывающимся списком, как тип, жанр и год
       (18 сентября 2026, просьба владельца). Системный <select> открывал
       на телефоне выбор во весь экран. Пункты собираем из его же <option>,
       а выбор кладём обратно в него и шлём change: страница слушает
       сортировку по-прежнему, у <select>. Сам <select> в шторке не
       нажимается — стилями. */
    for (const коробка of набор.querySelectorAll('.filter > .select')) {
      const поле = коробка.querySelector('select');
      if (!поле) continue;

      const панель = document.createElement('div');
      панель.className = 'multi__panel filters-row__pick';
      панель.hidden = true;
      const лист = document.createElement('div');
      лист.className = 'multi__list';

      for (const вариант of поле.options) {
        const пункт = document.createElement('label');
        пункт.className = 'multi__item';
        const радио = document.createElement('input');
        радио.type = 'radio';
        радио.name = 'sheet-' + поле.id;
        радио.value = вариант.value;
        радио.checked = вариант.selected;
        const имя = document.createElement('span');
        имя.className = 'multi__name';
        имя.textContent = вариант.textContent;
        пункт.append(радио, имя);
        лист.append(пункт);

        радио.addEventListener('change', () => {
          поле.value = радио.value;
          поле.dispatchEvent(new Event('change', { bubbles: true }));
          раскрыть(false);
        });
      }

      панель.append(лист);
      коробка.after(панель);

      const раскрыть = (on) => {
        панель.hidden = !on;
        коробка.toggleAttribute('data-open', on);
        if (on) for (const с of списки) с.open = false;
      };
      коробка._раскрыть = раскрыть;

      // Раскрыли тип, жанр или год — сортировка сворачивается.
      for (const с of списки) с.addEventListener('toggle', () => { if (с.open) раскрыть(false); });

      // Выбор, сделанный иначе (возврат назад, сброс), — отметку за ним.
      поле.addEventListener('change', () => {
        for (const р of лист.querySelectorAll('input')) р.checked = р.value === поле.value;
      });
    }

    /* Раскрытый список в шторке — во всю ширину строки, от её левого края,
       а не только под кнопкой в правой колонке: пункты нажимаются по всей
       ширине (18 сентября 2026, просьба владельца). Список лежит внутри
       <details> в правой колонке, поэтому вытягиваем его влево отрицательным
       полем ровно на расстояние до края строки. У сортировки список — сама
       ячейка строки, ей хватает правила в стилях. */
    const вширь = (список) => {
      const панель = список.querySelector('.multi__panel');
      if (!панель) return;
      if (!узкий.matches || !список.open) { панель.style.marginLeft = ''; return; }
      const строка = список.closest('.filter');
      const сдвиг = строка.getBoundingClientRect().left - список.getBoundingClientRect().left;
      панель.style.marginLeft = сдвиг + 'px';
    };
    for (const с of списки) с.addEventListener('toggle', () => вширь(с));
    addEventListener('resize', () => { for (const с of списки) вширь(с); });

    /* Нажимается вся строка отбора, а не только кнопка справа: имя слева
       раскрывает свой список так же. Щелчки внутри раскрытого списка и по
       самой кнопке — их собственные, их не трогаем. Дальше документа
       событие не пускаем: общий обработчик списков закрыл бы только что
       раскрытый, раз щелчок пришёлся мимо него. */
    набор.addEventListener('click', (e) => {
      if (!узкий.matches) return;
      const строка = e.target.closest('.filter');
      if (!строка || e.target.closest('.multi__panel, summary')) return;

      const список = строка.querySelector('details.multi');
      const коробка = строка.querySelector('.select');
      if (список) {
        e.preventDefault();
        e.stopPropagation();
        список.open = !список.open;
      } else if (коробка?._раскрыть) {
        e.preventDefault();
        e.stopPropagation();
        коробка._раскрыть(!коробка.hasAttribute('data-open'));
      }
    });

    /* Apply виден, только когда что-то выбрано: отмечен пункт в типе,
       жанре или годе либо сортировка не та, с которой страница пришла. */
    const выбрано = () =>
      Boolean(набор.querySelector('.multi input:checked')) ||
      [...набор.querySelectorAll('select')].some((поле) => {
        const исходный = [...поле.options].find((о) => о.defaultSelected) ?? поле.options[0];
        return поле.value !== исходный?.value;
      });
    /* Счётчик за словом Filters: сколько пунктов отмечено во всех отборах
       вместе. Сортировка — не отбор, её не считаем. Пусто, пока не отмечено
       ничего. */
    const счёт = () => {
      const n = набор.querySelectorAll('.multi input:checked').length;
      for (const место of полоса.querySelectorAll('.filters-row__count')) {
        // Неразрывный пробел: на широком экране слово стоит во флексе, и
        // обычный пробел в начале счётчика там отбрасывался — «FILTERS[3]».
        место.textContent = n ? ` [${n}]` : '';
      }
    };

    const отметить = () => {
      полоса.toggleAttribute('data-dirty', выбрано());
      счёт();
    };

    набор.addEventListener('change', отметить);
    addEventListener('pageshow', отметить);
    отметить();
  }
</script>

---
/* Полоса отбора — отдельной строкой под заголовком, одной ячейкой.

   Слева слово «Filters» — оно называет строку целиком, как имя называет
   отдельный отбор. Справа сами отборы: имя с двоеточием, за ним список, и
   так все пять — тип, жанр, год, сортировка и, самым крайним, вид.

   Перемычек внутри нет: столбцы стояли здесь 5 сентября 2026 несколько
   часов и мешали — отборы разной длины сидели каждый в своей четверти, и
   глазу приходилось прыгать через пустоту от имени к списку.

   Полоса липкая и встаёт под заголовок раздела: обе держатся на экране,
   пока листаешь каталог.

   С 18 сентября 2026 на телефоне, а с 19-го и на широком экране (просьба
   владельца) полоса другая: слева
   кнопка «Filters», справа Grid / List. Кнопка открывает
   снизу шторку со всеми отборами и сортировкой — это тот же набор отборов,
   .filters-row__set, только выложенный столбцом. До того отборы стояли одной
   строкой, уезжавшей за край экрана, и дальние приходилось искать сдвигом
   вбок. Кнопка, заголовок шторки, второй переключатель вида и затемнение
   есть в разметке всегда; без скрипта их нет, и полоса остаётся строкой. */

import Icon from './Icon.astro';
import ViewSwitch from './ViewSwitch.astro';
---
<div class="filters-row">
  {/* Счётчик применённых отборов — в квадратных скобках за словом, на всех
      ширинах (18 сентября 2026, просьба владельца). Пишет его скрипт ниже. */}
  <span class="filters-row__name">Filters<span class="filters-row__count"></span></span>

  {/* Сортировка на телефоне — значком рядом с отборами (19 сентября 2026,
      просьба владельца): открывает снизу шторку «Sort by». На широком
      экране кнопки нет — там в полосе стоит сам список сортировки. */}
  <button
    type="button"
    class="filters-row__sort"
    aria-label="Sort by"
    aria-expanded="false"
    aria-controls="sort-sheet"
  >
    <Icon name="arrows-down-up" class="filters-row__icon" />
  </button>
  <button
    type="button"
    class="filters-row__toggle"
    aria-expanded="false"
    aria-controls="filters-sheet"
  >
    {/* Подпись без треугольника, набрана как Grid / List справа (18 сентября
        2026, просьба владельца): линия под словом — у открытой шторки. */}
    {/* На телефоне вместо слова — значок, счётчик за ним (19 сентября 2026). */}
    <Icon name="sliders-horizontal" class="filters-row__icon" />
    <span class="filters-row__count filters-row__count--icon"></span>
    <span class="filters-row__label">Filters<span class="filters-row__count"></span></span>
  </button>

  <div class="filters-row__set" id="filters-sheet" role="dialog" aria-label="Filters">
    <div class="filters-row__head">
      <span class="filters-row__title">Filters</span>
      <button type="button" class="filters-row__close" aria-label="Close filters">
        <Icon name="x" class="filters-row__close-x" />
      </button>
    </div>
    <slot />

    {/* Кнопка внизу шторки (18 сентября 2026, просьба владельца). Отборы
        срабатывают сразу, по выбору, — Apply закрывает шторку и, если страница
        уже ушла ниже начала списка, возвращает к нему: найденное начинается
        сверху. */}
    {/* Reset all — рядом с Apply, когда выбрано в двух отборах и больше
        (19 сентября 2026, просьба владельца): сбрасывает все отборы разом;
        сортировку не трогает — она не отбор. */}
    <div class="filters-row__foot">
      <button type="button" class="filters-row__apply">Apply</button>
      <button type="button" class="filters-row__reset-all">Reset all</button>
    </div>
  </div>

  {/* Шторка сортировки — только на телефоне: снизу, с заголовком «Sort by»,
      пункты строками, как раскрытый список отборов. Пункты собирает скрипт
      из <option> самого <select>. */}
  <div class="filters-row__sorter" id="sort-sheet" role="dialog" aria-label="Sort by">
    <div class="filters-row__head">
      {/* Крестика нет (19 сентября 2026, просьба владельца): закрывают
          выбор пункта, нажатие на затемнение и Escape. */}
      <span class="filters-row__title">Sort by</span>
    </div>
    <div class="multi__list filters-row__sorter-list"></div>
  </div>
  {/* Галочка для меню сортировки на широком экране — его пункты собирает
      скрипт, а значок берём отсюда. */}
  <template class="filters-row__check"><Icon name="check" class="filters-row__menu-check" /></template>
  {/* Переключатель вида на телефоне стоит в самой полосе, справа, а в шторке
      его нет: выбирают вид взглядом, и прятать его за кнопку незачем. */}
  <span class="filters-row__view"><ViewSwitch /></span>

  <div class="filters-row__scrim" aria-hidden="true"></div>
</div>

<script>
  /* Шторка отборов на телефоне. Открывается кнопкой «Filters», закрывается
     крестиком в своём заголовке, нажатием на затемнение и клавишей Escape.
     Состояние — атрибут на полосе, как у меню и поиска в шапке: по нему CSS
     выдвигает шторку и прячет прокрутку страницы под ней. */
  const полоса = document.querySelector('.filters-row');
  const кнопка = полоса?.querySelector('.filters-row__toggle');

  if (полоса && кнопка) {
    const узкий = matchMedia('(max-width: 640px)');

    /* Открытыми не бывают две панели сразу: шторка отборов и панель поиска
       (по косой черте) закрывают друг друга (19 сентября 2026). Иначе вторая
       ложилась поверх первой, а полоса отбора, поднятая над шапкой, оставалась
       светлой среди затемнённого — и линия между ней и полосой раздела
       пропадала. Поиск шлёт drawer:open, отборы — sheet:open. */
    const кнопкаСорт = полоса.querySelector('.filters-row__sort');
    const сортер = полоса.querySelector('.filters-row__sorter');

    /* Шторка сортировки на телефоне — снизу, как прежняя шторка отборов.
       Открытыми вместе с отборами и поиском не бывает. */
    const сорт = (on) => {
      if (!кнопкаСорт) return;
      if (on) document.dispatchEvent(new CustomEvent('sheet:open'));
      if (on && полоса.hasAttribute('data-sheet')) шторка(false);
      полоса.toggleAttribute('data-sort', on);
      кнопкаСорт.setAttribute('aria-expanded', String(on));
    };

    const шторка = (on) => {
      if (on) document.dispatchEvent(new CustomEvent('sheet:open'));
      if (on && полоса.hasAttribute('data-sort')) сорт(false);
      полоса.toggleAttribute('data-sheet', on);
      кнопка.setAttribute('aria-expanded', String(on));
      if (!on) {
        // Раскрытые списки внутри закрываем вместе со шторкой.
        for (const список of полоса.querySelectorAll('details.multi[open]')) список.open = false;
        for (const коробка of полоса.querySelectorAll('.select[data-open]')) коробка._раскрыть?.(false);
      }
    };

    кнопка.addEventListener('click', () => шторка(!полоса.hasAttribute('data-sheet')));

    /* Клавиша F открывает и закрывает шторку — как косая черта поиск (19
       сентября 2026, просьба владельца). По коду клавиши, а не по букве: в
       русской раскладке на том же месте «А», и шторка открывается так же.
       Сочетания не трогаем — Ctrl+F и Cmd+F остаются поиском по странице в
       браузере. Пока человек набирает текст, F должна набраться. */
    addEventListener('keydown', (e) => {
      if (e.code !== 'KeyF' || e.metaKey || e.ctrlKey || e.altKey || e.repeat) return;
      const el = document.activeElement;
      if (el && (el.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName))) return;
      e.preventDefault();
      шторка(!полоса.hasAttribute('data-sheet'));
    });
    document.addEventListener('drawer:open', () => {
      if (полоса.hasAttribute('data-sheet')) шторка(false);
      if (полоса.hasAttribute('data-sort')) сорт(false);
    });
    кнопкаСорт?.addEventListener('click', () => сорт(!полоса.hasAttribute('data-sort')));
    полоса.querySelector('.filters-row__set .filters-row__close')?.addEventListener('click', () => {
      шторка(false);
      кнопка.focus();
    });
    полоса.querySelector('.filters-row__scrim')?.addEventListener('click', () => { шторка(false); сорт(false); });

    полоса.querySelector('.filters-row__apply')?.addEventListener('click', () => {
      шторка(false);
      const верх = полоса.getBoundingClientRect().top;
      if (верх < 0) scrollTo({ top: scrollY + верх, behavior: 'smooth' });
    });

    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && полоса.hasAttribute('data-sort')) { сорт(false); return; }
      if (e.key !== 'Escape' || !полоса.hasAttribute('data-sheet')) return;
      // Открытый список внутри закрывается своим обработчиком — сначала он.
      if (полоса.querySelector('details.multi[open]')) return;
      шторка(false);
      кнопка.focus();
    });

    // На широком экране шторки нет: забытое «открыто» держало бы страницу
    // без прокрутки.
    узкий.addEventListener('change', () => { шторка(false); сорт(false); });

    const набор = полоса.querySelector('.filters-row__set');
    const списки = [...набор.querySelectorAll('details.multi')];

    /* Раскрытый список в шторке прокручивается сам, а всё остальное стоит
       на месте: заголовок, строки отборов под списком (раскрыли жанр — год
       остаётся внизу на виду и нажимается) и Apply (19 сентября 2026,
       просьба владельца). Высота списка — остаток: вся высота шторки
       (на телефоне — её потолок, 85 % экрана) минус всё, что в ней стоит,
       пока сам список сжат в ноль. Не меньше 96 — хотя бы три пункта. */
    function уместить() {
      const открытый = набор.querySelector('details.multi[open] .multi__list, .filters-row__pick:not([hidden]) .multi__list');
      for (const л of набор.querySelectorAll('.multi__list')) {
        if (л !== открытый) { л.style.maxHeight = ''; л.style.overflowY = ''; }
      }
      // Раскрытый список доводит шторку до низа, и последний отбор встаёт
      // вплотную к блоку Apply — черту под ним тогда снимает CSS.
      набор.toggleAttribute('data-full', Boolean(открытый));
      if (!открытый) return;

      открытый.style.maxHeight = '0px';
      const потолок = getComputedStyle(набор).maxHeight;
      // Потолок на телефоне считается с рамкой сверху — её пиксель вычитаем.
      const рамка = parseFloat(getComputedStyle(набор).borderTopWidth) || 0;
      const предел = потолок !== 'none' ? parseFloat(потолок) - рамка : набор.clientHeight;
      let занято = 0;
      for (const ч of набор.children) занято += ч.getBoundingClientRect().height;
      // Вниз до целого: дробные высоты строк иначе давали шторке лишний
      // пиксель прокрутки.
      открытый.style.maxHeight = Math.max(Math.floor(предел - занято), 96) + 'px';
      открытый.style.overflowY = 'auto';
    }

    /* Сортировка на телефоне — шторкой снизу «Sort by» (19 сентября 2026,
       просьба владельца; с 18-го была строкой в шторке отборов). Системный
       <select> открывал на телефоне выбор во весь экран, поэтому пункты
       собираем из его же <option>, а выбор кладём обратно в него и шлём
       change: страница слушает сортировку по-прежнему, у <select>. Выбрали —
       шторка закрывается: сортировка срабатывает сразу. */
    const поле = полоса.querySelector('.filter > .select select');
    const лист = сортер?.querySelector('.filters-row__sorter-list');
    /* Ось сортировки пункта — по ней пункты делятся чертой на группы, и в
       шторке, и в меню на широком экране: по дате, по артисту, по альбому
       (названию), по имени, по числу релизов. */
    const ось = (v) =>
      /^(new|old)$/.test(v) ? 'date' : /^(az|za)$/.test(v) ? 'name' : v.replace(/-(az|za|asc)$/, '');

    if (поле && лист) {
      let прежняяОсь = null;
      for (const вариант of поле.options) {
        // Первый пункт новой группы — с чертой сверху (19 сентября 2026).
        const осьПункта = ось(вариант.value);
        const новаяГруппа = прежняяОсь !== null && осьПункта !== прежняяОсь;
        прежняяОсь = осьПункта;
        const пункт = document.createElement('label');
        пункт.className = 'multi__item';
        if (новаяГруппа) пункт.dataset.group = '';
        const радио = document.createElement('input');
        радио.type = 'radio';
        радио.name = 'sheet-' + поле.id;
        радио.value = вариант.value;
        радио.checked = вариант.selected;
        const имя = document.createElement('span');
        имя.className = 'multi__name';
        имя.textContent = вариант.textContent;
        пункт.append(радио, имя);
        // Отметка — галочкой справа, как в меню на широком экране (19 сентября
        // 2026, просьба владельца); сам кружок спрятан, но работает.
        const галочкаСорт = полоса.querySelector('.filters-row__check');
        if (галочкаСорт) пункт.append(галочкаСорт.content.cloneNode(true));
        лист.append(пункт);

        радио.addEventListener('change', () => {
          поле.value = радио.value;
          поле.dispatchEvent(new Event('change', { bubbles: true }));
          сорт(false);
        });
      }

      // Выбор, сделанный иначе (список на широком экране, возврат назад), —
      // отметку за ним.
      поле.addEventListener('change', () => {
        for (const р of лист.querySelectorAll('input')) р.checked = р.value === поле.value;
      });
    }

    /* Раскрытый список в шторке — во всю ширину строки, от её левого края,
       а не только под кнопкой в правой колонке: пункты нажимаются по всей
       ширине (18 сентября 2026, просьба владельца). Список лежит внутри
       <details> в правой колонке, поэтому вытягиваем его влево отрицательным
       полем ровно на расстояние до края строки. У сортировки список — сама
       ячейка строки, ей хватает правила в стилях. */
    const вширь = (список) => {
      const панель = список.querySelector('.multi__panel');
      if (!панель) return;
      if (!список.open) { панель.style.marginLeft = ''; return; }
      const строка = список.closest('.filter');
      const сдвиг = строка.getBoundingClientRect().left - список.getBoundingClientRect().left;
      панель.style.marginLeft = сдвиг + 'px';
    };
    for (const с of списки) с.addEventListener('toggle', () => { вширь(с); уместить(); });
    addEventListener('resize', () => уместить(), { passive: true });
    addEventListener('resize', () => { for (const с of списки) вширь(с); });

    /* Нажимается вся строка отбора, а не только кнопка справа: имя слева
       раскрывает свой список так же. Щелчки внутри раскрытого списка и по
       самой кнопке — их собственные, их не трогаем. Дальше документа
       событие не пускаем: общий обработчик списков закрыл бы только что
       раскрытый, раз щелчок пришёлся мимо него. */
    набор.addEventListener('click', (e) => {
      const строка = e.target.closest('.filter');
      if (!строка || e.target.closest('.multi__panel, summary')) return;

      const список = строка.querySelector('details.multi');
      const коробка = строка.querySelector('.select');
      if (список) {
        e.preventDefault();
        e.stopPropagation();
        список.open = !список.open;
      } else if (коробка?._раскрыть) {
        e.preventDefault();
        e.stopPropagation();
        коробка._раскрыть(!коробка.hasAttribute('data-open'));
      }
    });

    /* Apply виден, только когда что-то выбрано: отмечен пункт в типе,
       жанре или годе либо сортировка не та, с которой страница пришла. */
    const выбрано = () =>
      Boolean(набор.querySelector('.multi input:checked')) ||
      [...набор.querySelectorAll('select')].some((поле) => {
        const исходный = [...поле.options].find((о) => о.defaultSelected) ?? поле.options[0];
        return поле.value !== исходный?.value;
      });
    /* Счётчик за словом Filters: сколько пунктов отмечено во всех отборах
       вместе. Сортировка — не отбор, её не считаем. Пусто, пока не отмечено
       ничего. */
    const счёт = () => {
      const n = набор.querySelectorAll('.multi input:checked').length;
      for (const место of полоса.querySelectorAll('.filters-row__count')) {
        // Неразрывный пробел: на широком экране слово стоит во флексе, и
        // обычный пробел в начале счётчика там отбрасывался — «FILTERS[3]».
        место.textContent = n ? ` [${n}]` : '';
      }
    };

    /* Отборов с выбором два и больше — рядом с Apply встаёт Reset all. */
    const выбраноВНескольких = () => набор.querySelectorAll('details.multi[data-chosen]').length >= 2;

    полоса.querySelector('.filters-row__reset-all')?.addEventListener('click', () => {
      for (const список of набор.querySelectorAll('details.multi')) {
        const отмечено = [...список.querySelectorAll('input:checked')];
        if (!отмечено.length) continue;
        for (const флажок of отмечено) флажок.checked = false;
        список.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });

    const отметить = () => {
      полоса.toggleAttribute('data-dirty', выбрано());
      полоса.toggleAttribute('data-several', выбраноВНескольких());
      счёт();
      // Появился или пропал Apply — места под раскрытый список стало иначе.
      уместить();
    };

    /* Сортировка — в самой полосе, а в шторке только отборы (19 сентября
       2026, просьба владельца). На широком экране — списком перед «Filters»,
       без подписи «Sort by»; на телефоне список спрятан, вместо него значок,
       открывающий шторку «Sort by». Узел один — страница слушает этот самый
       <select>, — поэтому переставляем его из шторки в полосу, перед
       кнопками. */
    const сортировка = поле?.closest('.filter');
    if (сортировка) полоса.insertBefore(сортировка, кнопкаСорт ?? кнопка);
    // Сортировки на странице нет — нет и значка.
    if (!сортировка && кнопкаСорт) кнопкаСорт.hidden = true;

    /* Меню сортировки на широком экране — по образцу контекстного меню
       Spotify (19 сентября 2026, просьба владельца): под подписью
       выпадает панель в рамке, пункты строками, наведённый подсвечен,
       у выбранного галочка справа; оси сортировки разделены чертой —
       по дате, по артисту, по альбому, по имени, по числу релизов.
       Системный список не нажимается (стилями) — открывал бы своё окно
       поверх. Выбор кладём в <select> и шлём change, как шторка на
       телефоне. Закрывают выбор, нажатие мимо и Escape. */
    const коробка = сортировка?.querySelector('.select');
    if (сортировка && коробка && поле) {
      const меню = document.createElement('div');
      меню.className = 'filters-row__menu';
      меню.setAttribute('role', 'menu');
      const галочка = полоса.querySelector('.filters-row__check');

      let прежняя = null;
      for (const вариант of поле.options) {
        const своя = ось(вариант.value);
        if (прежняя !== null && своя !== прежняя) {
          const черта = document.createElement('div');
          черта.className = 'filters-row__menu-line';
          меню.append(черта);
        }
        прежняя = своя;

        const пункт = document.createElement('button');
        пункт.type = 'button';
        пункт.className = 'filters-row__menu-item';
        пункт.setAttribute('role', 'menuitemradio');
        пункт.dataset.value = вариант.value;
        const имя = document.createElement('span');
        имя.textContent = вариант.textContent;
        пункт.append(имя);
        if (галочка) пункт.append(галочка.content.cloneNode(true));
        пункт.addEventListener('click', () => {
          поле.value = вариант.value;
          поле.dispatchEvent(new Event('change', { bubbles: true }));
          раскрытьМеню(false);
        });
        меню.append(пункт);
      }
      сортировка.append(меню);

      const отметитьМеню = () => {
        for (const п of меню.querySelectorAll('.filters-row__menu-item')) {
          const да = п.dataset.value === поле.value;
          п.toggleAttribute('data-chosen', да);
          п.setAttribute('aria-checked', String(да));
        }
      };
      const раскрытьМеню = (on) => {
        сортировка.toggleAttribute('data-menu', on);
        if (on) отметитьМеню();
      };
      поле.addEventListener('change', отметитьМеню);
      коробка.addEventListener('click', (e) => {
        if (узкий.matches) return;
        e.preventDefault();
        раскрытьМеню(!сортировка.hasAttribute('data-menu'));
      });
      document.addEventListener('click', (e) => {
        if (сортировка.hasAttribute('data-menu') && !сортировка.contains(e.target)) раскрытьМеню(false);
      });
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && сортировка.hasAttribute('data-menu')) раскрытьМеню(false);
      });
      document.addEventListener('sheet:open', () => раскрытьМеню(false));
      document.addEventListener('drawer:open', () => раскрытьМеню(false));
      узкий.addEventListener('change', () => раскрытьМеню(false));
    }

    набор.addEventListener('change', отметить);
    addEventListener('pageshow', отметить);
    отметить();
  }
</script>

---
/* Столбец полосы отбора: слева имя с двоеточием, справа список.

   Двоеточие стоит в самом имени, а не дорисовывается стилями: это часть
   подписи, и в разметке ей место рядом со словом — так её видно и при
   поиске по странице, и экранному диктору. */
const { name } = Astro.props;
---
<div class="filter">
  <span class="filter__name">{name}</span>
  <slot />
</div>

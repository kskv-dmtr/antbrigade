---
/* Список жанров ссылками на их страницы.
   Название берём каноническое, а не то, что записано у конкретного релиза:
   в базе попадаются описки в регистре, и показывать их посетителю незачем.

   Оформлены как ссылки на лейблы — подчёркиванием и через точку, а не
   чипсами в рамках. Рамки читались кнопками, хотя ведут они туда же, куда
   имя лейбла рядом: на страницу списка. Одинаковые по смыслу ссылки должны
   выглядеть одинаково. */

import { genreFor } from '../lib/db.js';

const { names = [] } = Astro.props;
const items = names.map((name) => genreFor(name)).filter(Boolean);
---
{items.length > 0 && (
  <p class="meta-line">
    {items.map((genre, i) => (
      <>
        {i > 0 && <span class="sep"> · </span>}
        <a href={`/genres/${genre.slug}`}>{genre.name}</a>
      </>
    ))}
  </p>
)}

---
/* Ведущая работа — полоса 16:7 из макета.

   Обложка в базе квадратная, и растянуть её на 16:7 по `cover` значит
   выбросить больше половины картинки. Поэтому полосу заливает размытая
   копия той же обложки, а сама обложка лежит на ней целиком слева.
   Пропорция полосы и крупный заголовок из макета при этом сохранены. */

import { coverSrc } from '../lib/db.js';

const { album, cta = 'Listen ▶' } = Astro.props;
const kicker = [album.artist, album.types.join(' / ')].filter(Boolean).join(' · ');
const src = coverSrc(album, 800);
---
<a class="hero bleed" href={`/albums/${album.slug}`}>
  {src && <img class="hero__backdrop" src={src} alt="" aria-hidden="true" decoding="async" />}
  <div class="hero__in">
    {src && (
      <img class="hero__art" src={src} width="800" height="800"
           alt={`${album.album} cover`} fetchpriority="high" decoding="async" />
    )}
    <div class="hero__body">
      <span class="hero__text">
        <span class="hero__kicker">{kicker}</span>
        <span class="hero__title">{album.album}</span>
      </span>
      <span class="hero__cta">{cta}</span>
    </div>
  </div>
</a>

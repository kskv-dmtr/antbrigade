---
/* Иконки Phosphor (MIT), начертание regular.

   Контуры вставлены сюда, а не подключены пакетом: их немного, а
   @phosphor-icons/core весит десятки мегабайт. Добавляете новую — берите
   её из assets/regular того же пакета, чтобы набор не расползался.

   Размер задаётся кеглем родителя (1em), цвет — currentColor: иконка
   выворачивается вместе с текстом, рядом с которым стоит. */

/* Заливкой. Так Phosphor и отдаёт свои контуры: обводка в них уже обведена
   и превращена в заливаемую фигуру. */
const PATHS = {
  'arrow-elbow-down-right':
    'M221.66,181.66l-48,48a8,8,0,0,1-11.32-11.32L196.69,184H72a8,8,0,0,1-8-8V32a8,8,0,0,1,16,0V168H196.69l-34.35-34.34a8,8,0,0,1,11.32-11.32l48,48A8,8,0,0,1,221.66,181.66Z',
  'magnifying-glass':
    'M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z',
  'caret-down':
    'M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z',
  'caret-left':
    'M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z'
};

/* Обводкой. Пришлось завести отдельно: солнце и полумесяц собраны здесь
   руками, а не взяты из пакета — его в проекте нет, а вписывать контур по
   памяти значит вписывать неизвестно что.

   Поэтому фигуры заданы простой геометрией, которую видно и можно
   проверить: окружность с восемью лучами и серп из двух дуг одного
   радиуса. Вес обводки 16 на сетке 256 — тот же, что у regular, так что
   рядом с заливаемыми они не выбиваются.

   Лучи идут от радиуса 76 до 100 через каждые 45°; круглые концы добавляют
   по 8, то есть внешний край на 236 из 256. */
const SHAPES = {
  sun: `<circle cx="128" cy="128" r="52"/>
        <line x1="128" y1="52"  x2="128" y2="28"/>
        <line x1="182" y1="74"  x2="199" y2="57"/>
        <line x1="204" y1="128" x2="228" y2="128"/>
        <line x1="182" y1="182" x2="199" y2="199"/>
        <line x1="128" y1="204" x2="128" y2="228"/>
        <line x1="74"  y1="182" x2="57"  y2="199"/>
        <line x1="52"  y1="128" x2="28"  y2="128"/>
        <line x1="74"  y1="74"  x2="57"  y2="57"/>`,

  /* Серп: дуга радиусом 103 от (231,156) к (100,25) и большая дуга того же
     радиуса обратно. Хорда между концами 185.3 при диаметре 206 — обе дуги
     существуют.

     Радиус подобран так, чтобы размах серпа совпал с размахом солнца — 200
     из 256. При прежних 88 он занимал 171, и рядом с солнцем читался мельче
     при одинаковом заданном размере. */
  moon: `<path d="M231,156A103,103,0,0,1,100,25a103,103,0,1,0,131,131Z"/>`
};

const { name, class: extra } = Astro.props;
const d = PATHS[name];
const shape = SHAPES[name];

if (!d && !shape) {
  throw new Error(`Icon: нет контура для «${name}». Добавьте его в PATHS или SHAPES.`);
}
---
{d && (
  <svg
    class:list={['icon', extra]}
    viewBox="0 0 256 256"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  ><path d={d}/></svg>
)}

{shape && (
  <svg
    class:list={['icon', extra]}
    viewBox="0 0 256 256"
    fill="none"
    stroke="currentColor"
    stroke-width="16"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    set:html={shape}
  />
)}

/* Значки `moon` и `sun-dim` 3 сентября 2026 сначала удалили — переключатель
   темы был на словах, — и в тот же день вернули: он снова значковый, но с
   логикой кнопки вида, показывающей не текущее состояние, а то, куда
   переключит. */

const { name, class: extra } = Astro.props;
const знак = PATHS[name];

if (!знак) throw new Error(`Icon: нет контура для «${name}». Добавьте его в PATHS.`);

const d   = typeof знак === 'string' ? знак : знак.d;
const box = typeof знак === 'string' ? '0 0 256 256' : знак.box;
---
<svg
  class:list={['icon', extra]}
  viewBox={box}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
><path d={d}/></svg>

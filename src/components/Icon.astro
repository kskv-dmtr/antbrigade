---
/* Иконки Phosphor (MIT), начертание regular — кроме двух кружков внизу,
   они заливкой (fill): знак сплошной, и обводка ему не нужна.

   Контуры вставлены сюда, а не подключены пакетом: их немного, а
   @phosphor-icons/core весит десятки мегабайт. Добавляете новую — ставьте
   пакет временно, берите контур из assets/regular и снимайте пакет обратно,
   чтобы набор не расползался и в зависимостях не оседал.

   Размер задаётся кеглем родителя (1em), цвет — currentColor: иконка
   выворачивается вместе с текстом, рядом с которым стоит.

   Значение — строка с контуром на сетке Phosphor 256×256 либо пара
   { d, box }, если знак нарисован на другой сетке. Второе нужно было
   логотипам площадок: они приходили со своей сеткой. Логотипов больше нет,
   но разбор пары оставлен — следующий чужой знак придёт так же. */

const PATHS = {
  'magnifying-glass':
    'M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z',
  /* Логотипы площадок — spotify-logo, bandcamp, youtube-logo — и звено цепи
     link удалены 6 сентября 2026 вместе с употреблением: кнопки площадок
     стоят теперь без значков, одними названиями. Глобус globe ушёл вместе
     с ними — ссылка на сайт лейбла удалена ещё раньше. Достать контуры
     обратно можно из истории этого файла. */
  /* Каретки caret-down и caret-left удалены 5 сентября 2026: и указатель у
     списков, и стрелка у кнопки «назад» стали треугольниками. Сплошная
     фигура из трёх точек контура не требует — её обрезает CSS, как и метку
     раздела в полосах. */
  list:
    'M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z',
  x:
    'M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z',
  /* Контуры squares-four и rows приходили сюда дважды — 4 и 5 сентября
     2026, оба раза под кнопку вида, — и оба раза ушли вместе с ней. Теперь
     вид выбирают обычным списком, значка ему не нужно. Достать контуры
     обратно можно из истории этого файла.

     Пара moon и sun-dim держала переключатель темы с 3 по 5 сентября 2026 и
     удалена вместе с употреблением; достать её обратно можно из истории
     этого файла.

     Два кружка заливкой. Половинка — переключатель темы, целый — метка
     раздела. Знак один и тот же, разница только в том, сколько закрашено:
     полоса раздела и кнопка темы стоят на одном экране, и набор из одного
     семейства читается набором, а не случайным соседством.

     Кружок в контуре занимает не всю коробку, а 208 из 256 — тринадцать
     шестнадцатых. Размер коробки поэтому считается от нужного размера
     кружка; счёт стоит в правилах .head--dot .mark и .theme-toggle__icon. */
  circle:
    'M232,128A104,104,0,1,1,128,24,104.13,104.13,0,0,1,232,128Z',
  'circle-half':
    'M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24ZM40,128a88.1,88.1,0,0,1,88-88V216A88.1,88.1,0,0,1,40,128Z'
};

/* Правило «показываем не текущее состояние, а то, куда переключит» с парой
   moon и sun-dim работало, а с половинкой кружка работать перестало: у неё
   нет светлой и тёмной стороны, она называет само действие — сменить тему.
   Знак поэтому один и не меняется. */

const { name, class: extra } = Astro.props;
const знак = PATHS[name];

if (!знак) throw new Error(`Icon: нет контура для «${name}». Добавьте его в PATHS.`);

const d   = typeof знак === 'string' ? знак : знак.d;
const box = typeof знак === 'string' ? '0 0 256 256' : знак.box;
---
<svg
  class:list={['icon', extra]}
  viewBox={box}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
><path d={d}/></svg>

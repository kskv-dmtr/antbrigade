---
/* Где послушать: строка справки в отдельном ряду решётки под первым блоком.

   Набрана как блок жанров на странице исполнителя — подпись через двоеточие,
   значения ссылками через точку. Кнопками в рамках площадки стояли до
   7 сентября 2026, полосой в 64 с дисплейной подписью — полдня того же дня:
   и то и другое было органом другого веса, чем всё вокруг, хотя ведёт ровно
   туда же, куда лейбл и жанр строкой выше.

   Занимает два первых столбца — те же, что обложка над ним. Правую половину
   ряда держит затычка в стилях: без неё линия ряда обрывалась бы посередине.

   Логотипы площадок и Yandex Music убраны 6 сентября 2026 — см. Icon.astro и
   SHOWN_PLATFORMS в db.js. */

import { listenLinks } from '../lib/db.js';

const { album } = Astro.props;
const links = listenLinks(album);

/* album.link — не площадка, а сборник ссылок на них, и место ему последнее.
   В общий перечень он попадает наравне с прочими: разделять их нечем, все
   уводят слушать. */
const all = [...links, ...(album.url ? [{ label: 'album.link', url: album.url }] : [])];
---
{all.length > 0 && (
  <div class="listen">
    <dl class="item__facts">
      <div class="item__fact">
        <dt>Where to listen:</dt>
        <dd>
          {all.map((link, i) => (
            <>
              {i > 0 && <span class="sep"> · </span>}
              <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
            </>
          ))}
        </dd>
      </div>
    </dl>
  </div>
)}

---
/* Где послушать — последняя строка справки о релизе, сразу под жанрами.

   Набрана как все строки рядом: подпись через двоеточие, значения ссылками
   через точку. Кнопками в рамках площадки стояли до 7 сентября 2026, отдельным
   рядом решётки в 64 — полдня того же дня: и то и другое было органом другого
   веса, чем всё вокруг, хотя ведёт ровно туда же, куда лейбл и жанр строкой
   выше. Отдельный ряд вдобавок отрывался от справки на всю высоту ячейки.

   Логотипы площадок и Yandex Music убраны 6 сентября 2026 — см. Icon.astro и
   SHOWN_PLATFORMS в db.js. */

import { listenLinks } from '../lib/db.js';

const { album } = Astro.props;
const links = listenLinks(album);

/* album.link — не площадка, а сборник ссылок на них, и место ему последнее.
   В общий перечень он идёт наравне с прочими: все они уводят слушать. */
const all = [...links, ...(album.url ? [{ label: 'album.link', url: album.url }] : [])];
---
{all.length > 0 && (
  <div class="item__fact">
    <dt>Where to listen:</dt>
    <dd>
      {all.map((link, i) => (
        <>
          {i > 0 && <span class="sep"> · </span>}
          <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
        </>
      ))}
    </dd>
  </div>
)}

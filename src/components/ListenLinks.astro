---
/* Где послушать: отдельный ряд решётки под первым блоком. Слева, в двух
   первых столбцах — подпись с кружком, как у разделов; справа, в третьем и
   четвёртом — прямые ссылки на площадки и переход на album.link.

   Ряд стоит на тех же вертикалях, что обложка и текст над ним: подпись
   приходится под обложку, кнопки — под справку.

   Площадки названы словами, а не значками: логотипы Spotify, Bandcamp,
   YouTube и звено цепи у album.link стояли здесь до 6 сентября 2026 — чужие
   знаки шли каждый своей плотностью и весом, и рядом с подписью капителью
   логотип оказывался единственным пятном на весь блок.

   Yandex Music из списка ушёл там же — см. SHOWN_PLATFORMS в db.js. */

import Icon from './Icon.astro';
import { listenLinks } from '../lib/db.js';

const { album } = Astro.props;
const links = listenLinks(album);
---
{(links.length > 0 || album.url) && (
  <div class="listen">
    <p class="listen__name display display--md"><Icon name="circle" class="mark" />Where to listen</p>

    <div class="listen__row">
      {links.map((link) => (
        <a class="listen__platform" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
      ))}

      {album.url && (
        <a class="listen__platform" href={album.url} target="_blank" rel="noopener noreferrer">album.link</a>
      )}
    </div>
  </div>
)}

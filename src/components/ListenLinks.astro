---
/* Где послушать — ряд кнопок по низу правой ячейки на странице релиза.

   Строкой справки «Where to listen:» — подпись через двоеточие, значения
   ссылками через точку — они стояли с 7 сентября 2026 до вечера того же
   дня. Кнопками они весомее: площадка — это выход со страницы, а не
   выходные данные, и стоять ей у нижнего края блока, а не между жанром и
   годом.

   Логотипы площадок и Yandex Music убраны 6 сентября 2026 — см. Icon.astro и
   SHOWN_PLATFORMS в db.js. */

import { listenLinks } from '../lib/db.js';

const { album } = Astro.props;
/* album.link — последней кнопкой, сразу за Bandcamp, тем же видом (22
   сентября 2026, просьба владельца). До того он стоял строкой справки
   «Links:»: не площадка, а сборник ссылок на них. Кнопкой он встал рядом с
   тем, куда и ведёт, — к площадкам. */
const links = [
  ...listenLinks(album),
  ...(album.url ? [{ key: 'albumlink', label: 'album.link', url: album.url }] : [])
];
---
{links.length > 0 && (
  <div class="listen">
    {links.map((link) => (
      <a class="listen__btn" href={link.url} target="_blank" rel="noopener noreferrer">
        {link.label}
      </a>
    ))}
  </div>
)}

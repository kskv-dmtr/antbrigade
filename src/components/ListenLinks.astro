---
/* Где послушать: прямые ссылки на площадки и переход на album.link — одним
   рядом.

   Значков у кнопок нет. Логотипы Spotify, Bandcamp, YouTube и звено цепи у
   album.link стояли здесь до 6 сентября 2026: чужие знаки шли каждый своей
   плотностью и весом, набор из них не читался набором, а рядом с подписью
   капителью логотип оказывался единственным пятном на весь блок. Название
   площадки словом говорит ровно то же.

   Yandex Music из списка тоже ушёл — см. SHOWN_PLATFORMS в db.js. */

import { listenLinks } from '../lib/db.js';

const { album } = Astro.props;
const links = listenLinks(album);
---
{(links.length > 0 || album.url) && (
  <div class="listen">
    {links.map((link) => (
      <a class="listen__platform" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
    ))}

    {album.url && (
      <a class="listen__platform" href={album.url} target="_blank" rel="noopener noreferrer">album.link</a>
    )}
  </div>
)}

---
/* Где послушать: сверху прямые ссылки на площадки, отдельным блоком —
   переход на album.link, где собраны все остальные.

   Логотипы площадок намеренно не рисую: выдуманный логотип хуже его
   отсутствия. Пока текстовые кнопки, иконки придут с макетом. */

import { listenLinks } from '../lib/db.js';

const { album } = Astro.props;
const links = listenLinks(album);
---
{links.length > 0 && (
  <div class="listen">
    {links.map((link) => (
      <a class="listen__platform" href={link.url} target="_blank" rel="noopener noreferrer">
        {link.label}
      </a>
    ))}
  </div>
)}

{album.url && (
  <div class="listen-all">
    <a class="button" href={album.url} target="_blank" rel="noopener noreferrer">
      Open album.link
    </a>
    <span class="hint">Every platform the release is available on</span>
  </div>
)}

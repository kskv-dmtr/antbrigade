---
/* Отбор с множественным выбором: кнопка как у выпадающего списка, под ней
   панель с флажками, своей полосой прокрутки и кнопкой сброса.

   Родной <select> тут не годится. Множественный выбор он показывает только
   развёрнутым списком на несколько строк — полоса управления от такого
   разъезжается, — а раскрытый список рисует система, и ни ширины, ни полосы
   прокрутки в нём не задать.

   Собрано на <details>, а не на своём поповере с ролями ARIA: раскрытие,
   закрытие и клавиатура тогда достаются от браузера, а без скрипта блок
   остаётся закрытым, а не разложенным во весь экран. Отбор и так работает
   только со скриптом — как и прежние списки. */


import Icon from './Icon.astro';

const {
  id,
  label,        // для screen reader: «Genre»
  allLabel,     // подпись, когда не выбрано ничего: «All genres»
  manyLabel,    // подпись, когда выбрано несколько: «Genres»
  items = [],   // [{ value, label, count }]
  axis,         // имя оси отбора: страница читает его с флажка
  /* Поле поиска над списком — у длинных отборов: жанров три сотни, лейблов
     под восемь (3 октября 2026, просьба владельца). У коротких — тип, год —
     искать нечего, и поле только отняло бы строку. */
  search = false
} = Astro.props;

/* Обёртка .multi__group осталась от панели, в которой 5 сентября 2026
   несколько часов стояли двумя списками тип и жанр. Списков в панели снова
   один, но обёртка нужна: по ней скрипт страницы прячет список, в котором
   под текущим отбором не осталось ни одного пункта. */
const блоки = [{ axis, items }];
---
<details class="multi" id={id} data-all={allLabel} data-many={manyLabel}>
  <summary class="multi__button" aria-label={label}>
    <span class="multi__label">{allLabel}</span>

    {/* Треугольник стоит всегда — и когда выбрано, и когда нет (4 октября
        2026, просьба владельца): строка отбора показывает счётчик и
        указатель, не меняясь в составе. Прежде на месте треугольника при
        выборе вставало слово Reset (19 сентября 2026), а до него крестик;
        сброс теперь живёт в двух местах сразу — крестиком у чипсы в строке
        Chosen и кнопкой Reset внизу шторки. */}
    <span class="select__chevron" aria-hidden="true"></span>
  </summary>

  <div class="multi__panel">
    {/* Поле набрано ровно как поисковая строка в панели поиска: та же
        рамка, лупа слева, крестик сброса справа — чтобы два поля на сайте
        не выглядели разными вещами (3 октября 2026, просьба владельца).
        Поэтому и классы общие, search__*: правила у них одни. */}
    {search && (
      <div class="multi__find">
        <div class="search__row">
          <Icon name="magnifying-glass" class="search__icon" />
          <input type="search" class="multi__find-field" placeholder="Search"
                 aria-label={`Search ${label}`} autocomplete="off" spellcheck="false" />
          <button type="button" class="search__clear multi__find-clear"
                  aria-label={`Clear ${label} search`}>
            <Icon name="x" class="search__x" />
          </button>
        </div>
      </div>
    )}

    <div class="multi__list">
      {блоки.map((блок) => (
        <div class="multi__group">
          {блок.items.map((item) => (
            <label class="multi__item">
              {/* Ось пишем на самом флажке: панель одна, а отбирают по ней
                  два разных признака, и странице надо знать, какой из них
                  человек тронул. */}
              <input type="checkbox" value={item.value} data-axis={блок.axis} />
              <span class="multi__name">{item.label}</span>
              {/* Счёт отдельным узлом: страница пересчитывает его при каждой
                  смене отбора, а имя не трогает. В квадратных скобках, как
                  счётчики по всему сайту (21 сентября 2026; до того в круглых). */}
              <span class="multi__count">[{item.count}]</span>
            </label>
          ))}
        </div>
      ))}

      {/* Видно, когда под текущий отбор не подходит ни один пункт: пустая
          панель без объяснения читалась бы поломкой. */}
      <p class="multi__none" hidden>Nothing here</p>
    </div>
  </div>
</details>

<script>
  /* Скрипт общий на страницу: Astro собирает его один раз, сколько бы таких
     блоков на ней ни стояло. Наружу блок отдаёт обычное событие change —
     страница слушает его так же, как слушала <select>. */
  const blocks = document.querySelectorAll('.multi');

  if (blocks.length) {
    const chosen = (root) =>
      [...root.querySelectorAll('input:checked')];

    /* Подпись на кнопке: ничего не выбрано — «All», выбрано — счётчик,
       «[1]», «[3]» (4 октября 2026, просьба владельца). Имя выбранного
       пункта в подписи стояло до этого дня; теперь имена видны целиком в
       строке Chosen, чипсами, и повторять их в строке отбора незачем —
       строка говорит, сколько в ней отмечено, а указатель зовёт раскрыть.
       data-many в разметке остался от подписи «Chosen [3]», снятой 18
       сентября 2026, и не выводится. */
    function label(root) {
      const marked = chosen(root);
      const text = root.querySelector('.multi__label');
      text.textContent = marked.length === 0 ? root.dataset.all : `[${marked.length}]`;

      /* Атрибут именно удаляем, а не ставим пустым: data-chosen="" в
         разметке остаётся, и селектор [data-chosen] срабатывает на нём —
         строка держалась бы выделенной и когда не выбрано ничего. */
      if (marked.length) root.dataset.chosen = 'yes';
      else delete root.dataset.chosen;
    }

    /* Панель на узком экране раскрывается во всю ширину под рядом фильтров,
       а не под своей кнопкой. Причина не в удобстве попадания пальцем: ряд
       там прокручивается вбок (overflow-x у .filters__group), и панель
       внутри него обрезало бы краем прокрутки. position: fixed выносит её
       из-под обрезки, но тогда верх нужно посчитать самим. */
    const wide = () => window.matchMedia('(min-width: 641px)').matches;

    function place(root) {
      const panel = root.querySelector('.multi__panel');

      if (!wide()) {
        delete root.dataset.flip;
        const bar = root.closest('.filters') ?? root;
        panel.style.top = `${Math.round(bar.getBoundingClientRect().bottom + 6)}px`;
        return;
      }

      panel.style.top = '';

      /* Панель раскрывается вправо от кнопки, и у правого края кадра она
         уезжала за экран: замер на 1920 — отбор букв на /genres выходил за
         край на 30 пикселей. Метка переворачивает её правым краем по кнопке;
         сам переворот — правилом в global.css.

         Сперва метку снимаем, иначе меряли бы уже перевёрнутую и она
         осталась бы такой навсегда: с той стороны места всегда хватает. */
      delete root.dataset.flip;
      if (panel.getBoundingClientRect().right > document.documentElement.clientWidth) {
        root.dataset.flip = '';
      }
    }

    for (const root of blocks) {
      label(root);

      root.addEventListener('toggle', () => {
        if (!root.open) return;
        // Раскрытым остаётся один: две панели рядом перекрывали бы друг друга.
        for (const other of blocks) if (other !== root) other.open = false;
        place(root);
      });

      root.addEventListener('change', () => label(root));

      /* Страница пересчитала счётчики — подпись кнопки показывает счёт
         выбранного пункта и должна за ними успевать. */
      root.addEventListener('relabel', () => label(root));

      /* Поиск по списку: прячем пункты, в имени которых нет набранного.
         Прячем своим признаком, а не hidden: hidden заведует страница — им
         она убирает пункты с нулевым счётом, — и два хозяина у одного
         свойства разошлись бы на первом же пересчёте.

         Пересчёт счётчиков кончается событием relabel, и отбор по набранному
         накладываем заново: страница к этому времени успела вернуть пункты,
         которые поиск уже спрятал. */
      const поиск = root.querySelector('.multi__find-field');
      if (поиск) {
        const отсеять = () => {
          const запрос = поиск.value.trim().toLowerCase();
          let видно = 0;
          for (const item of root.querySelectorAll('.multi__item')) {
            const имя = item.querySelector('.multi__name').textContent.toLowerCase();
            const подходит = !запрос || имя.includes(запрос);
            item.toggleAttribute('data-nomatch', !подходит);
            if (подходит && !item.hidden) видно++;
          }
          root.querySelector('.multi__none').hidden = видно > 0;
        };

        поиск.addEventListener('input', отсеять);

        /* Крестик сбрасывает набранное — как в панели поиска. Живёт он
           внутри списка, и всплывший щелчок закрыл бы <details>: гасим. */
        root.querySelector('.multi__find-clear')?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          поиск.value = '';
          отсеять();
          поиск.focus();
        });
        root.addEventListener('relabel', отсеять);

        /* Закрыли список — набранное стирается: раскрыв его снова, человек
           ждёт весь список, а не остаток прошлого поиска. */
        root.addEventListener('toggle', () => {
          if (root.open || !поиск.value) return;
          поиск.value = '';
          отсеять();
        });
      }

    }

    // Щелчок мимо закрывает: у <details> своего такого поведения нет.
    document.addEventListener('click', (e) => {
      for (const root of blocks) {
        if (!root.open || root.contains(e.target)) continue;

        /* В раскрытой шторке не закрываем (3 октября 2026, просьба
           владельца). Там отборы стоят столбцом, а не выпадают поверх
           страницы: щелчок по пустому месту шторки ничего не выбирает и
           сворачивать раскрытый список не должен. Закрыть его есть чем — тем
           же заголовком отбора, Escape или соседним отбором, который
           раскрывают следующим. */
        if (root.closest('.filters-row__set') && document.querySelector('.filters-row[data-sheet]')) continue;

        root.open = false;
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      for (const root of blocks) {
        if (root.open) { root.open = false; root.querySelector('summary').focus(); }
      }
    });

    window.addEventListener('resize', () => {
      for (const root of blocks) if (root.open) place(root);
    });

    /* На узком экране панель приколота к окну, а полоса фильтров при
       прокрутке вниз уезжает вверх — панель осталась бы висеть сама по
       себе. Закрываем. Прокрутка внутри самого списка сюда не долетает:
       у него overscroll-behavior: contain. */
    window.addEventListener('scroll', () => {
      if (wide()) return;
      for (const root of blocks) if (root.open) root.open = false;
    }, { passive: true });
  }
</script>

---
/* Плитка артиста или лейбла.

   Своей картинки у них нет, поэтому обложкой служит их самый свежий релиз:
   albumIds приходят из Notion уже от новых к старым, так что берём первый
   релиз с обложкой. У двенадцати артистов релизов нет вовсе — там остаётся
   штриховка, то самое пустое состояние из макета. */

import ArrowElbow from './ArrowElbow.astro';
import { coverSrc, coverSrcSet, countryName, plural } from '../lib/db.js';

const { href, name, releases = [], country, as: Wrapper = 'div', class: extra } = Astro.props;
const cover = releases.find((a) => a?.cover) ?? null;
const count = releases.length;

/* Под обложкой — короткий код, он всегда на виду и не ломает плотную строку;
   полное название уходит в подпись, которая появляется при наведении. */
const meta = [country, count ? plural(count, 'release', 'releases') : 'no releases']
  .filter(Boolean)
  .join(' · ');
---
<Wrapper class:list={['tile', extra]}>
  <a class="tile__link" href={href}>
    <div class="tile__art">
      {cover && (
        <img
          src={coverSrc(cover, 400)}
          srcset={coverSrcSet(cover)}
          sizes="(max-width: 640px) 45vw, 240px"
          width="400"
          height="400"
          loading="lazy"
          decoding="async"
          alt=""
        />
      )}
      <div class="tile__over" aria-hidden="true">
        <span class="tile__meta">{countryName(country)}</span>
        <span class="tile__cta">Open <ArrowElbow /></span>
      </div>
    </div>
    {/* Не .tile__artist: там имя исполнителя обычным шрифтом, а здесь
        служебная строка — страна и счёт релизов, ей нужен моноширинный. */}
    <span class="tile__stat">{meta}</span>
    <span class="tile__title">{name}</span>
  </a>
</Wrapper>

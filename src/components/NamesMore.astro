---
/* Список имён в два столбца с кнопкой «показать ещё» — тот же приём, что у
   решётки плиток в TilesMore, только для строк.

   Заведён 11 сентября 2026 для страницы Explore, где три таких списка идут
   друг за другом свёрнутыми блоками. У самих указателей — /artists, /labels,
   /genres — своя разметка со своим отбором: там строку ещё и фильтруют по
   букве, сортируют и показывают карточками, и общий компонент под всё это
   развалился бы на флаги.

   48, как везде: столько же в первом развороте на Music и в разделах
   исполнителя, лейбла и жанра.

   Первый разворот отдаёт сервер: разметка приходит целиком — так страница
   работает без скрипта и достаётся поисковикам, — а лишнее прячет правило по
   nth-child, которое действует только при data-js. Скрипт при первом расчёте
   снимает метку и дальше ведёт видимость сам: по номеру открывать следующие
   строки нельзя.

   `names--plain` говорит, что карточки у записей нет: список живёт только
   строками и переключателя вида не слушает. См. global.css. */

const { count } = Astro.props;

/* Число живёт здесь и продублировано в global.css номером в nth-child:
   правило должно работать до того, как поднимется скрипт. Меняете тут —
   меняйте и там. */
const PAGE = 48;
---
<ul class="names names--two names--plain" data-cut>
  <slot />
</ul>

{count > PAGE && (
  <button type="button" class="more" data-page={PAGE}>
    Show more [{Math.min(PAGE, count - PAGE)}]
  </button>
)}

<script>
  /* Один проход на все списки страницы: на Explore их три — исполнители,
     лейблы и жанры, — и каждый считает свой разворот сам. */
  for (const список of document.querySelectorAll('.names[data-cut]')) {
    const кнопка = список.nextElementSibling?.classList.contains('more')
      ? список.nextElementSibling
      : null;

    const строки = [...список.children];
    const ШАГ = Number(кнопка?.dataset.page) || 48;
    let предел = ШАГ;

    const показать = () => {
      строки.forEach((строка, i) => { строка.hidden = i >= предел; });

      /* Метку снимаем сразу: дальше видимостью заведует hidden, а правило по
         номеру мешало бы открывать следующие строки. */
      список.removeAttribute('data-cut');

      if (!кнопка) return;

      /* Не меньше нуля: на последнем нажатии предел перескакивает остаток, и
         в подписи получалось «Show more [-20]». */
      const осталось = Math.max(0, строки.length - предел);
      кнопка.hidden = осталось === 0;
      кнопка.textContent = `Show more [${Math.min(ШАГ, осталось)}]`;
    };

    показать();
    кнопка?.addEventListener('click', () => { предел += ШАГ; показать(); });
  }
</script>

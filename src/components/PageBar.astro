---
/* Полоса заголовка на страницах со списком.

   Устроена как полоса раздела на витрине: две равные половины, высота 64,
   во всю ширину экрана, вертикальная черта ровно посередине. Отличий два.

   Метка слева не точка, а треугольник, смотрящий влево, — и вся левая
   половина работает кнопкой «назад». Отдельной кнопки Back на списках
   больше нет: место метки и место стрелки на полосе одно и то же, и
   заводить под них два разных органа незачем.

   Правая половина пока пуста. Держит она ту самую черту посередине: без
   неё полоса перестала бы делиться пополам, а деление это на витрине
   совпадает с перемычкой между второй и третьей обложкой в ряду. */
const { title, count } = Astro.props;
---
<div class="head head--dot head--back">
  <div class="head__lead">
    <h1 class="display display--md"><a class="back" href="/">{title}</a></h1>
    {count != null && (
      <p class="counter" id="counter" aria-live="polite">[{count}]</p>
    )}
  </div>
  <div class="head__blank" aria-hidden="true"></div>
</div>

{/* Пришли изнутри сайта — возвращаем по истории: список откроется там же,
    где его оставили, с тем же отбором и на той же прокрутке. Пришли со
    стороны — работает href, то есть переход на главную. Без скрипта тоже
    работает href. */}
<script is:inline>
  (function () {
    var bar = document.currentScript.previousElementSibling;
    var back = bar && bar.querySelector('.back');
    if (!back) return;
    var ref = document.referrer;
    if (ref && ref.indexOf(location.origin + '/') === 0) {
      back.addEventListener('click', function (e) {
        e.preventDefault();
        history.back();
      });
    }
  })();
</script>

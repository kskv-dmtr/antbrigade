---
/* Ряд ссылок на страницы исполнителя или лейбла вне сайта.
   Поля в Notion заполняются вручную и у большинства записей пустые, поэтому
   проверки живут здесь: страницы подключают компонент безусловно, а он сам
   ничего не выводит, когда выводить нечего.

   Пришёл на смену BandcampLink, когда у исполнителей появилось второе такое
   поле: две отдельные кнопки подряд разъезжались бы пробелом между строчными
   элементами, а ряду нужен общий просвет.

   Кнопка Website стояла первой — дом впереди витрин — и удалена 5 сентября
   2026 вслед за колонкой в Notion: ссылки на собственные сайты оттуда
   убраны. Стояли они у трёх артистов и девяти лейблов. */

import Icon from './Icon.astro';

const { bandcamp, youtube } = Astro.props;
const есть = Boolean(bandcamp || youtube);
---
{есть && (
  <div class="profiles">

    {bandcamp && (
      <a class="profile" href={bandcamp} target="_blank" rel="noopener noreferrer">
        <Icon name="bandcamp" class="profile__icon" />
        <span>Bandcamp</span>
      </a>
    )}

    {youtube && (
      <a class="profile" href={youtube} target="_blank" rel="noopener noreferrer">
        <Icon name="youtube-logo" class="profile__icon" />
        <span>YouTube</span>
      </a>
    )}
  </div>
)}

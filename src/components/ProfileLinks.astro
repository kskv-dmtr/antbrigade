---
/* Ряд ссылок на страницы исполнителя или лейбла вне сайта.
   Поля в Notion заполняются вручную и у большинства записей пустые, поэтому
   проверки живут здесь: страницы подключают компонент безусловно, а он сам
   ничего не выводит, когда выводить нечего.

   Пришёл на смену BandcampLink, когда у исполнителей появилось второе такое
   поле: две отдельные кнопки подряд разъезжались бы пробелом между строчными
   элементами, а ряду нужен общий просвет.

   Собственный сайт идёт первым: это дом, а площадки — витрины. Колонка
   Website заведена в Notion только у лейблов, поэтому страница исполнителя
   этот параметр не передаёт и кнопка там не выходит. */

import Icon from './Icon.astro';

const { website, bandcamp, youtube } = Astro.props;
const есть = Boolean(website || bandcamp || youtube);
---
{есть && (
  <div class="profiles">
    {website && (
      <a class="profile" href={website} target="_blank" rel="noopener noreferrer">
        <Icon name="globe" class="profile__icon" />
        <span>Website</span>
      </a>
    )}

    {bandcamp && (
      <a class="profile" href={bandcamp} target="_blank" rel="noopener noreferrer">
        <svg class="profile__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M0 18.75l7.437-13.5H24l-7.438 13.5H0z" />
        </svg>
        <span>Bandcamp</span>
      </a>
    )}

    {youtube && (
      <a class="profile" href={youtube} target="_blank" rel="noopener noreferrer">
        <svg class="profile__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.5 15.6V8.4l6.3 3.6-6.3 3.6z" />
        </svg>
        <span>YouTube</span>
      </a>
    )}
  </div>
)}

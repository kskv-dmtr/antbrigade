---
/* Раздел «Random Picks»: полоса с кнопкой «Dig again» и решётка случайных
   обложек. Стоит на витрине и на странице промаха — 12 сентября 2026 обе
   собраны из одного компонента, до того у каждой был свой список правил и
   свой скрипт, разошедшиеся в мелочах: на витрине показывалось восемь и ряд
   всегда достраивался до полного, на промахе двенадцать и ряд из пяти с
   одинокой плиткой под ним.

   Пул приходит готовым — уже перетасованным на сборке: сколько его брать,
   решает страница. На витрине это весь каталог, с 12 сентября 2026: подборка
   перестала зависеть от того, как часто собирается сайт. На промахе — полсотни
   записей: её вес платят те, кто уже ошибся адресом.

   SHOW — сколько видно за раз: восемь, два полных ряда по четыре на
   расчётных 1920. Ряд всегда полный: на трёх столбцах показывается девять,
   см. пересчёт в скрипте ниже.

   SHOW_NARROW — сколько видно на телефоне (до 640): шесть, три ряда по два.
   С 17 сентября 2026: восемь обложек в два столбца — четыре экрана высоты
   с лишним, и пока долистаешь до кнопки, верхних уже не видно. */

import AlbumCard from './AlbumCard.astro';
import Icon from './Icon.astro';

const { pool, show: SHOW = 8, showNarrow: SHOW_NARROW = 6, title = 'Random Picks' } = Astro.props;
const POOL = pool.length;
---
{/* Разворот выбирается здесь, до того как решётка ниже вообще разобрана
    браузером, — и потому первая отрисовка сразу идёт с выбранным.

    Тасовать пул после отрисовки нельзя: обложки, которые сервер уже начал
    грузить, пришлось бы спрятать, а на их место встали бы ленивые и ещё не
    скачанные. Ровно это и мигало при каждом заходе до 7 сентября 2026,
    из-за чего жеребьёвку при загрузке тогда и убрали совсем. Здесь её
    вернули иначе: выбор делается раньше первой отрисовки, менять на экране
    нечего.

    Правило со сдвигом кладём стилем, а не атрибутом на плитках: их больше
    тысячи, и трогать каждую до отрисовки — та же задержка, от которой уходим.
    Модуль ниже подхватит сдвиг из data-dig-start и снимет это правило, когда
    расставит hidden сам.

    Стоит скрипт до раздела, а не вплотную над решёткой. Полоса узнаёт о
    решётке под собой соседством — `.head--dot:has(+ .tiles)`, — и по нему же
    берёт себе линию снизу и встаёт к обложкам вплотную. Скрипт между ними —
    такой же соседний узел, как любой другой, пусть и невидимый: полоса
    переставала видеть решётку, теряла линию и отходила от обложек на 16.
    Работает он одинаково откуда угодно выше решётки. */}
<script is:inline define:vars={{ SHOW, SHOW_NARROW, POOL }}>
  (() => {
    /* Сдвиг считаем шагом в базовые SHOW, а показываем — округлив вверх до
       числа столбцов: на трёх их девять. Стили к этому времени разобраны —
       скрипт стоит в теле, ниже <link> в <head>, — поэтому --cols уже
       читается, и первая отрисовка сразу даёт полный ряд. */
    const столбцов =
      Number(getComputedStyle(document.documentElement).getPropertyValue('--cols')) || 4;
    const база = matchMedia('(max-width: 640px)').matches ? SHOW_NARROW : SHOW;
    const видно = Math.ceil(база / столбцов) * столбцов;

    /* Шагов столько, чтобы самый дальний разворот уместился в пуле целиком.
       Вычитаем не SHOW, а добавку широкого ряда: на трёх столбцах
       показывается девять, и от конца пула нужен запас ровно на эту девятую.
       На телефоне видно шесть — меньше шага, и вычитать там нечего.
       Без вычитания пул в двести давал последним шагом 192, девятой плитки
       ему не хватало, и ряд обрывался на середине. */
    const шагов = Math.max(1, Math.floor((POOL - Math.max(0, видно - SHOW)) / SHOW));
    const начало = Math.floor(Math.random() * шагов) * SHOW;

    document.documentElement.dataset.digStart = начало;
    if (!начало && видно === SHOW) return;

    const стиль = document.createElement('style');
    стиль.id = 'dig-first';
    стиль.textContent =
      '#dig > li { display: none }' +
      `#dig > li:nth-child(n + ${начало + 1}):nth-child(-n + ${начало + видно}) { display: list-item }`;
    document.head.append(стиль);
  })();
</script>

<section class="section">
  {/* Полоса липкая, как у разделов на внутренних страницах: пока листаешь
      две дюжины обложек, должно быть видно, что именно листаешь. */}
  <div class="head head--sticky head--bare head--dot">
    <div class="head__lead">
      <h2 class="display display--md"><Icon name="circle" class="mark" />{title}</h2>
    </div>

    {/* Без скрипта кнопки не видно: подборку меняет он, а сервер отдаёт
        всем один и тот же HTML. */}
    <button type="button" class="dig-again"><span class="btn-label">Dig again</span></button>
  </div>

  {/* Пул отдаётся целиком, но видны только первые SHOW: без скрипта
      страница показывает осмысленную выборку, а не пустое место. */}
  <ul class="tiles tiles--auto" id="dig" data-show={SHOW} data-show-narrow={SHOW_NARROW}>
    {pool.map((a, i) => <AlbumCard album={a} hidden={i >= SHOW} />)}
  </ul>

  {/* На телефоне кнопка стоит под подборкой и липнет к низу экрана, пока
      этот раздел на виду: листать две дюжины обложек, чтобы дотянуться до
      «ещё», — не дело. Двойник в разметке, а не переезд стилями — перенести
      узел из одного контейнера в другой средствами CSS нельзя. Виден ровно
      один: второй скрыт медиазапросом и в дерево доступности не попадает. */}
  <button type="button" class="dig-again dig-again--below"><span class="btn-label">Dig again</span></button>
</section>

<script>
  /* Новая подборка по нажатию. Сам разворот при загрузке выбран раньше —
     строчкой выше решётки, до первой отрисовки.

     Сайт статический: сервер отдаёт всем один и тот же HTML, поэтому
     выбирает браузер. В разметке лежит пул, здесь остаётся видимость и
     листание.

     Нажатие не тасует пул заново, а листает его дальше. При повторной
     жеребьёвке восьми из тысячи с лишним ожидаемое пересечение с предыдущей
     подборкой — почти половина плитки, и время от времени одна и та же
     обложка оставалась бы на месте: нажатие читалось бы как сбой, а не как
     обновление. Листание же даёт подборки подряд, у которых нет ни одного
     общего релиза. */
  const dig   = document.getElementById('dig');
  const items = Array.from(dig.children);
  const базово = Number(dig.dataset.show) || 8;
  const наТелефоне = Number(dig.dataset.showNarrow) || базово;
  const узкий = matchMedia('(max-width: 640px)');
  const agains = document.querySelectorAll('.dig-again');

  /* Ряд всегда полный. Столбцов в решётке бывает четыре, три или два — их
     число задано в --cols и меняется медиазапросами, — а показываем мы
     восемь обложек. На трёх столбцах восьмёрка оставила бы в последнем ряду
     две обложки из трёх, поэтому округляем вверх до кратного: 8 при четырёх
     и двух столбцах, 9 при трёх.

     Читаем --cols, а не считаем столбцы по ширине окна: правило про
     количество столбцов живёт в CSS, и второй такой же расчёт в скрипте
     разошёлся бы с ним при первой же правке медиазапросов. */
  const столбцов = () =>
    Number(getComputedStyle(document.documentElement).getPropertyValue('--cols')) || 4;

  let show = базово;

  /* На телефоне база своя — шесть, см. SHOW_NARROW в начале файла. */
  function пересчитать() {
    const база = узкий.matches ? наТелефоне : базово;
    show = Math.ceil(база / столбцов()) * столбцов();
  }

  пересчитать();

  let order = items;

  /* Считаем не страницами, а сдвигом от начала пула: разворот выбран до
     отрисовки шагом в базовые восемь, а показываем мы восемь или девять —
     смотря сколько столбцов. От страницы край подборки на трёх столбцах уехал
     бы (девятая страница по девять — это не то же место, что девятая по
     восемь), и первая же отрисовка подменила бы все обложки разом. От сдвига
     не уезжает: на трёх столбцах к тем же восьми просто добавляется девятая. */
  let start = Number(document.documentElement.dataset.digStart) || 0;

  // Фишер — Йетс. Не `sort(() => Math.random() - 0.5)`: та перестановка
  // заметно смещённая, часть записей оседает у краёв.
  function shuffle() {
    order = items.slice();
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }

    // Переставляем и в разметке, иначе выбранные шли бы вразнобой по сетке.
    const frag = document.createDocumentFragment();
    for (const el of order) frag.appendChild(el);
    dig.appendChild(frag);
  }

  function render() {
    for (const [i, el] of order.entries()) el.hidden = i < start || i >= start + show;

    /* Следующая подборка подгружается заранее: у скрытых плиток картинки
       ленивые и к нажатию не скачаны — без этого на их месте секунду
       держалась бы пустая штриховка. */
    for (const el of order.slice(start + show, start + show * 2)) {
      for (const img of el.querySelectorAll('img[loading="lazy"]')) img.loading = 'eager';
    }
  }

  /* Первый расчёт повторяет то, что уже выбрано до отрисовки: разворот тот же,
     на экране ничего не меняется. Сразу после него снимаем временное правило —
     дальше видимостью заведует hidden, и правило по номеру мешало бы листать.

     Обе строчки стоят подряд, между ними браузер не рисует, поэтому вспышки
     «показаны все» не будет. */
  render();
  document.getElementById('dig-first')?.remove();

  /* Кнопок две — в полосе раздела и под подборкой; видна всегда одна, но
     обработчик нужен обеим. */
  for (const again of agains) again.addEventListener('click', () => {
    start += show;
    // Пул кончился — тасуем заново, и следующий круг идёт в другом порядке.
    if (start + show > order.length) {
      shuffle();
      start = 0;
    }
    render();
  });

  /* Столбцов при повороте телефона или растягивании окна становится больше
     или меньше, и подборку надо пересчитать: на трёх столбцах показываем
     девять, на четырёх и двух — восемь. Страница при этом остаётся та же,
     только её край подвинется; если от новой длины она уехала за конец пула,
     возвращаемся к первой.

     Следим за самой решёткой, а не за окном: ResizeObserver срабатывает на
     любое изменение её коробки, включая те, что окном не объясняются, —
     появилась полоса прокрутки, изменился масштаб страницы. Пересчёт меняет
     только видимость плиток, ширины решётки не трогает, так что бесконечного
     круга не выйдет; лишний вызов и вовсе отсекается сравнением. */
  const переложить = () => {
    const было = show;
    пересчитать();
    if (show === было) return;

    /* Неполной подборки в конце пула быть не должно: ряд, оборванный на
       середине, читается как недогрузившийся. Если от нового числа разворот
       не помещается в остаток, начинаем пул сначала. */
    if (start + show > items.length) start = 0;
    render();
  };

  new ResizeObserver(переложить).observe(dig);

  /* Телефон: линия над нижней «Dig again» в конце подборки встаёт точно на
     нижнюю линию последнего ряда плиток (18 сентября 2026, просьба
     владельца). Сама по себе она стоит на 17 выше кнопки — на своём месте
     под сеткой это ровно линия ряда. Но у самого конца страницы кнопка до
     своего места не доезжает на долю пикселя: высота страницы дробная, и
     последнюю долю браузер докрутить не даёт. Линии расходились на
     пиксель и читались одной двойной (замер на 375: 726,8 и 727,8).

     Поэтому, когда линия ряда оказывается в пикселе от линии кнопки, линию
     кнопки ставим прямо на неё; в остальное время — на обычные 17. */
  const нижняя = document.querySelector('.dig-again--below');

  if (нижняя) {
    const свести = () => {
      const кнопка = нижняя.getBoundingClientRect();
      if (!кнопка.height) return;
      const линияРяда = dig.getBoundingClientRect().bottom - 1 - кнопка.top;
      // Окно с запасом: на 404 расхождение выходило −15,58.
      const рядом = линияРяда > -19 && линияРяда < -14;
      нижняя.style.setProperty('--dig-line', рядом ? линияРяда + 'px' : '-17px');
    };

    addEventListener('scroll', свести, { passive: true });
    addEventListener('resize', свести, { passive: true });
    свести();
  }

  /* И по событию окна заодно: наблюдатель и resize приходят из разных мест —
     первый от вёрстки, второй от окна, — и стоят дёшево оба. Пересчёт
     сравнивает число с прежним и на совпадении выходит сразу, так что двойной
     вызов ничего не стоит. */
  addEventListener('resize', переложить);
</script>

<script>
  /* Клавиша R — «Dig again», новая горсть случайных релизов: на главной с
     22 сентября 2026, на странице промаха — с того же дня (просьба
     владельца). Живёт в самом разделе, а не на страницах: раздел один на
     обеих, и клавиша приходит вместе с ним. Как F, S и I: по коду клавиши
     (в русской раскладке — «К»), без сочетаний — Ctrl+R и Cmd+R остаются
     перезагрузкой, — и не пока набирают текст. Нажимаем саму кнопку: её
     обработчик листает пул и тасует заново, когда пул кончился. Кнопок две —
     в полосе и под подборкой; обработчик у них общий, так что годится
     любая. */
  const копать = document.querySelector('.dig-again');
  if (копать) {
    addEventListener('keydown', (e) => {
      // Shift+R — случайный релиз из всей базы, это дело оболочки.
      if (e.code !== 'KeyR' || e.shiftKey || e.metaKey || e.ctrlKey || e.altKey || e.repeat) return;
      const el = document.activeElement;
      if (el && (el.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName))) return;
      e.preventDefault();
      копать.click();
    });
  }
</script>

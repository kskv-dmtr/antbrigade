---
/* Строка списка релизов: артист, название, формат, год.

   Номера в макете были сквозной нумерацией каталога, но при любой сортировке
   кроме исходной они шли вразнобой — 01, 47, 3 — и читались как ошибка, а не
   как позиция. Убраны.

   Четыре колонки на широком экране, две строки на узком — раскладку целиком
   держит CSS, разметка одна. */

const { album } = Astro.props;
---
<a class="row" href={`/albums/${album.slug}`}>
  <span class="row__artist">{album.artist}</span>
  <span class="row__title">{album.album}</span>
  {/* Точка, а не косая: «Album / Collaboration» читалось как одно
      составное слово. Колонка расширена под это сочетание — самое
      длинное в базе, 21 знак. */}
  <span class="row__meta">{album.types.join(' · ')}</span>
  {/* Год без скобок: в скобки взяты счётчики — числа релизов у артиста,
      лейбла и жанра, — а год не счётчик. */}
  <span class="row__num">{album.year ?? '—'}</span>
</a>

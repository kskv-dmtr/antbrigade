---
/* Поиск по всему каталогу. Одно поле на весь сайт, стоит в шапке.

   Раскладка как на shikimori: лупа слева, клавиша в квадрате справа.

   Клавиша набрана текстом, а не значком: у Phosphor косой черты нет — все
   его `*-slash` это перечёркнутые предметы вроде отключённого звонка. Так
   что это <kbd>, и по смыслу правильнее: показываем именно ту клавишу,
   которую надо нажать.

   Находки выпадают панелью под полем — приём взят у Spotify: там поиск тоже
   один на всё и отвечает вперемешку исполнителями, альбомами и треками, у
   каждой находки подписан её род. Наши роды: artist, release, video, label,
   genre.

   Строка находки — по образцу поиска Spotify (19 сентября 2026): миниатюра,
   имя с подписью под ним, род находки в рамке справа. */

import Icon from './Icon.astro';

/* Экземпляров на странице два: поле в шапке (id по умолчанию — search) и
   поле в панели поиска справа (drawer-search), с 19 сентября 2026. У
   каждого свои id — поля, списка находок и коробки; указатель поиска
   загружается один раз на оба. */
const { id = 'search', hints = false } = Astro.props;
---
<div class="search" id={`${id}-box`}>
  {/* Верхний ряд: само поле и крестик «закрыть» справа от него. Крестик
      виден только на телефоне, где поиск открывается слоем на весь экран
      (с 18 сентября 2026, по образцу dsgners.ru), и закрывает этот слой.
      На широком экране ряд — это просто поле. */}
  <div class="search__top">
  <div class="search__row">
  <Icon name="magnifying-glass" class="search__icon" />
  <input
    type="search"
    id={id}
    placeholder="Search"
    autocomplete="off"
    spellcheck="false"
    role="combobox"
    aria-expanded="false"
    aria-controls={`${id}-found`}
    aria-autocomplete="list"
    aria-label="Search artists, releases, videos, labels and genres"
  />
  <kbd class="search__key mono mono--sm" aria-hidden="true">/</kbd>
  <button type="button" class="search__clear" aria-label="Clear search">
    <Icon name="x" class="search__x" />
  </button>
  </div>

  <button type="button" class="search__close" aria-label="Close search">
    <Icon name="x" class="search__close-x" />
  </button>
  </div>

  {/* Подсказки по управлению — только в панели поиска (19 сентября
      2026, просьба владельца): стрелки ходят по находкам, Enter открывает
      выбранную. Клавиши — в рамке, как «/» у поля; Enter — словом. */}
  {hints && (
    <div class="search__hints mono mono--sm" aria-hidden="true">
      <span class="search__hint">Navigate <kbd class="search__kbd">↑</kbd><kbd class="search__kbd">↓</kbd></span>
      <span class="search__hint">Open <kbd class="search__kbd search__kbd--word">Enter</kbd></span>
    </div>
  )}

  {/* Панель пустой не показывается: состояний «ничего не найдено» на сайте
      нет нигде, и заводить одно ради поиска не за чем. */}
  <div class="search__found" id={`${id}-found`} role="listbox" aria-label="Search results" hidden></div>
</div>

<script>
  /* Поиск по сводному указателю /search.json.

     Указатель грузится по первому касанию поля, а не вместе со страницей: он
     весит вдвое больше самой тяжёлой страницы сайта, а искать заходят не все.
     Запрашивается один раз за загрузку страницы. */

  import { fold } from '../lib/fold.js';

  /* Указатель один на все поля страницы: грузится по первому касанию
     любого из них. */
  let указатель = null;
  let грузим = null;

  for (const короб of document.querySelectorAll('.search')) {
    const поле   = короб.querySelector('input[type="search"]');
    const панель = короб.querySelector('.search__found');
    if (!поле || !панель) continue;

    /* Свод тот же, что у отбора на списках: общая функция на весь сайт,
       иначе «bjork» находил бы «Björk» в одном месте и не находил в другом. */

    const РОД = { a: 'artist', r: 'release', v: 'video', l: 'label', g: 'genre' };

    /* Порядок при равном совпадении: исполнитель важнее одноимённого релиза,
       релиз важнее клипа. */
    const ВЕС = { a: 0, r: 1, v: 2, l: 3, g: 4 };

    const СКОЛЬКО = 12;

    let выбран = -1;

    const загрузить = () => {
      if (указатель) return Promise.resolve(указатель);

      if (!грузим) {
        грузим = fetch('/search.json')
          .then((r) => r.json())
          .then((строки) => {
            /* Свёрнутые формы считаем здесь, один раз на загрузку страницы: в
               самом файле они удвоили бы вес. Три с лишним тысячи строк —
               работа на несколько миллисекунд. */
            указатель = строки.map((з) => [...з, fold(з[1]), fold(з[3] || '')]);
            return указатель;
          })
          .catch(() => (указатель = []));
      }

      return грузим;
    };

    /* Чем раньше совпало, тем выше находка: точное имя, начало имени, начало
       слова внутри имени, любое вхождение. Совпадение по подписи — ступенью
       ниже любого совпадения по имени: набравший имя исполнителя ждёт сперва
       его самого, а потом уже его релизы. */
    const оценить = (имя, подпись, q) => {
      if (имя === q) return 0;
      if (имя.startsWith(q)) return 1;
      if (имя.includes(' ' + q)) return 2;
      if (имя.includes(q)) return 3;
      if (подпись.startsWith(q)) return 4;
      if (подпись.includes(q)) return 5;
      return -1;
    };

    const найти = (q) => {
      const счёт = [];

      for (const з of указатель) {
        const о = оценить(з[5], з[6], q);
        if (о >= 0) счёт.push([о, ВЕС[з[0]], з[1].length, з]);
      }

      счёт.sort((x, y) => x[0] - y[0] || x[1] - y[1] || x[2] - y[2]);
      return счёт.slice(0, СКОЛЬКО).map((x) => x[3]);
    };

    const закрыть = () => {
      панель.hidden = true;
      панель.replaceChildren();
      поле.setAttribute('aria-expanded', 'false');
      поле.removeAttribute('aria-activedescendant');
      выбран = -1;
    };

    const отметить = (i) => {
      const строки = [...панель.children];
      if (!строки.length) return;

      выбран = (i + строки.length) % строки.length;
      строки.forEach((с, n) => с.toggleAttribute('data-active', n === выбран));
      строки[выбран].scrollIntoView({ block: 'nearest' });
      поле.setAttribute('aria-activedescendant', строки[выбран].id);
    };

    // Полный адрес миниатюры из короткой пометки указателя (search.json).
    const миниатюра = (м) =>
      !м ? '' : м[0] === 'c' ? `/covers/${м.slice(1)}-400.webp` : `/videos/${м.slice(1)}-480.webp`;

    const нарисовать = (находки) => {
      if (!находки.length) return закрыть();

      панель.replaceChildren(...находки.map((з, i) => {
        const [тип, имя, адрес, подпись, число, мини] = з;

        /* Строка по образцу Spotify (19 сентября 2026, просьба владельца):
           слева миниатюра, рядом имя и под ним подпись, справа род находки
           в рамке. Подпись — исполнители и год у релиза и клипа, счёт
           релизов у исполнителя, лейбла и жанра (страны нет). */
        const строка = document.createElement('a');
        строка.className = 'found';
        строка.href = адрес;
        строка.id = поле.id + '-found-' + i;
        строка.setAttribute('role', 'option');

        const рамка = document.createElement('span');
        рамка.className = 'found__thumb';
        const src = миниатюра(мини);
        if (src) {
          const img = document.createElement('img');
          img.src = src;
          img.alt = '';
          img.loading = 'lazy';
          img.decoding = 'async';
          рамка.append(img);
        }

        const текст = document.createElement('span');
        текст.className = 'found__text';
        const н = document.createElement('span');
        н.className = 'found__name';
        н.textContent = имя;
        текст.append(н);

        // Пометка — год у релиза и клипа, готовый счёт у остальных (его
        // собирает search.json).
        const второй = [подпись, число].filter(Boolean).join(' · ');
        if (второй) {
          const п = document.createElement('span');
          п.className = 'found__sub';
          п.textContent = второй;
          текст.append(п);
        }

        const род = document.createElement('span');
        род.className = 'found__type';
        род.textContent = РОД[тип];

        строка.append(рамка, текст, род);
        return строка;
      }));

      панель.hidden = false;
      поле.setAttribute('aria-expanded', 'true');
      выбран = -1;
    };

    const набрано = () => fold(поле.value.trim());

    const показать = async () => {
      const q = набрано();

      /* По одной букве отвечать нечем: совпадёт треть каталога, и панель
         показала бы случайные двенадцать из тысячи. */
      if (q.length < 2) return закрыть();

      await загрузить();
      if (набрано() !== q) return;          // пока грузили, набрали другое
      нарисовать(найти(q));
    };

    /* Крестик сбрасывает поле и закрывает панель. Событие input шлём тем же,
       что и набор с клавиатуры: обработчик выше один на оба случая. */
    const сброс = короб.querySelector('.search__clear');

    /* Крестик сброса только стирает. На телефоне его в слое поиска нет — там
       с 18 сентября 2026 стоит свой крестик справа от поля, он и закрывает
       слой, и стирает (Base.astro). Фокус возвращаем в поле — человек стёр
       набранное, чтобы набрать другое. */
    if (сброс) {
      сброс.addEventListener('click', () => {
        поле.value = '';
        закрыть();
        поле.focus();
      });
    }

    let таймер;

    поле.addEventListener('input', () => {
      clearTimeout(таймер);
      таймер = setTimeout(показать, 120);
    });

    // По возвращении в поле с набранным текстом панель открывается снова.
    поле.addEventListener('focus', () => { загрузить(); показать(); });

    поле.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); отметить(выбран + 1); return; }
      if (e.key === 'ArrowUp')   { e.preventDefault(); отметить(выбран - 1); return; }

      if (e.key === 'Enter') {
        const строка = панель.children[выбран];
        if (строка) { e.preventDefault(); location.href = строка.href; }
        return;
      }

      /* Escape закрывает панель, но фокус оставляет: набранное человек ещё
         может править. Второе нажатие отпускает поле — этим занят общий
         обработчик в Base. */
      if (e.key === 'Escape' && !панель.hidden) { e.stopPropagation(); закрыть(); }
    });

    /* Закрываем по нажатию мимо, а не по потере фокуса: щелчок по находке сам
       начинается с потери фокуса, и по blur панель исчезала бы раньше, чем
       переход успевал случиться. */
    addEventListener('pointerdown', (e) => {
      if (!короб.contains(e.target)) закрыть();
    });
  }
</script>

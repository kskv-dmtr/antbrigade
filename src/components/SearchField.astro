---
/* Поле поиска. Одно на все четыре списка — релизы, артисты, лейблы, жанры.

   Подсказка в поле одна и та же везде, поэтому лежит здесь, а не в
   параметрах. А вот aria-label у каждой страницы свой: экранный диктор
   должен сказать, по чему именно ищут, — «type / to search» ему ничего не
   объясняет.

   Клавиша `/` продублирована значком справа; сам обработчик лежит в макете,
   потому что слушает нажатия по всей странице. Значок пропадает, как только
   в поле фокус или текст: иначе он наезжал бы на набранное. */

const { label } = Astro.props;
---
<div class="search">
  <input
    type="search"
    id="search"
    placeholder="Type / to search"
    autocomplete="off"
    spellcheck="false"
    aria-label={label}
  />
  <kbd class="search__key mono mono--sm" aria-hidden="true">/</kbd>
</div>

---
/* Поле поиска. Одно на все четыре списка — релизы, артисты, лейблы, жанры.

   Раскладка как на shikimori: лупа слева, клавиша в квадрате справа.

   Клавиша набрана текстом, а не значком: у Phosphor косой черты нет — все
   его `*-slash` это перечёркнутые предметы вроде отключённого звонка. Так
   что это <kbd>, и по смыслу правильнее: показываем именно ту клавишу,
   которую надо нажать.

   Подсказка в поле одна и та же везде, поэтому лежит здесь, а не в
   параметрах. А вот aria-label у каждой страницы свой: экранный диктор
   должен сказать, по чему именно ищут, — «type / to search» ему ничего не
   объясняет. */

import Icon from './Icon.astro';

const { label } = Astro.props;
---
<div class="search">
  <Icon name="magnifying-glass" class="search__icon" />
  <input
    type="search"
    id="search"
    placeholder="Type / to search"
    autocomplete="off"
    spellcheck="false"
    aria-label={label}
  />
  <kbd class="search__key mono mono--sm" aria-hidden="true">/</kbd>
</div>

---
/* Поле поиска. Одно на все четыре списка — релизы, артисты, лейблы, жанры.

   Подсказка в поле одна и та же везде, поэтому лежит здесь, а не в
   параметрах. А вот aria-label у каждой страницы свой: экранный диктор
   должен сказать, по чему именно ищут, — «type / to search» ему ничего не
   объясняет.

   Значок с клавишей `/` убран: про неё теперь сказано словами в самой
   подсказке, и два напоминания об одном в поле шириной 220 px на телефоне
   только мешали. Обработчик клавиши лежит в макете, он слушает нажатия по
   всей странице. */

import Icon from './Icon.astro';

const { label } = Astro.props;
---
<div class="search">
  <input
    type="search"
    id="search"
    placeholder="Type / to search"
    autocomplete="off"
    spellcheck="false"
    aria-label={label}
  />
  <Icon name="magnifying-glass" class="search__icon" />
</div>

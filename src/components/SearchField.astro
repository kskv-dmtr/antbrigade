---
/* Поле поиска. Одно на все четыре списка — релизы, артисты, лейблы, жанры.

   Подсказка с клавишей `/` подсказывает горячую клавишу; сам обработчик
   лежит в макете, потому что слушает нажатия по всей странице. Подсказка
   пропадает, как только в поле фокус или текст: иначе она наезжала бы на
   набранное. */

const { placeholder, label } = Astro.props;
---
<div class="search">
  <input
    type="search"
    id="search"
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
    aria-label={label}
  />
  <kbd class="search__key mono mono--sm" aria-hidden="true">/</kbd>
</div>

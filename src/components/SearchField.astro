---
/* Поле поиска. Одно на список — стоит в правой половине полосы заголовка.

   Раскладка как на shikimori: лупа слева, клавиша в квадрате справа.

   Клавиша набрана текстом, а не значком: у Phosphor косой черты нет — все
   его `*-slash` это перечёркнутые предметы вроде отключённого звонка. Так
   что это <kbd>, и по смыслу правильнее: показываем именно ту клавишу,
   которую надо нажать.

   Как только в поле что-то набрано, на месте клавиши встаёт крестик — он же
   и сбрасывает. Тот же приём, что у списков отбора: подсказка и сброс
   занимают один угол и одновременно не показываются. Пока поле пусто,
   сбрасывать нечего, а подсказка нужна; набрали — наоборот.

   Подсказка в поле одна и та же везде, поэтому лежит здесь, а не в
   параметрах. А вот aria-label у каждой страницы свой: экранный диктор
   должен сказать, по чему именно ищут, — «search» ему ничего не объясняет.
   Про горячую клавишу теперь говорит только значок справа. */

import Icon from './Icon.astro';

const { label } = Astro.props;
---
<div class="search">
  <Icon name="magnifying-glass" class="search__icon" />
  <input
    type="search"
    id="search"
    placeholder="Search"
    autocomplete="off"
    spellcheck="false"
    aria-label={label}
  />
  <kbd class="search__key mono mono--sm" aria-hidden="true">/</kbd>
  <button type="button" class="search__clear" aria-label="Clear search">
    <Icon name="x" class="search__x" />
  </button>
</div>

<script>
  /* Крестик сбрасывает поле и сообщает об этом странице тем же событием,
     что и набор с клавиатуры: отбор слушает input и пересчитывается сам. */
  const поле = document.getElementById('search');
  const сброс = document.querySelector('.search__clear');

  if (поле && сброс) {
    сброс.addEventListener('click', () => {
      поле.value = '';
      поле.dispatchEvent(new Event('input', { bubbles: true }));
      поле.focus();
    });
  }
</script>

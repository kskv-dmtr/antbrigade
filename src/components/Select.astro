---
/* Выпадающий список со своим шевроном.

   Системную стрелку убираем: у неё не выровнять отступ справа под левый
   и не развернуть её при раскрытии. Шеврон — настоящий элемент, а не
   псевдоэлемент: так его состояние видно и в разметке, и в тестах.

   Раньше он был нарисован через clip-path; теперь это caret-down из
   Phosphor, как и остальные значки в проекте. */

/* narrow — для списков, у которых пункты длиннее собственной подписи.
   Ширину закрытой кнопки браузер берёт по самому длинному пункту, и такой
   список раздувается рядом с соседями. */
const { id, label, narrow = false, class: extra } = Astro.props;
---
<span class:list={['select', narrow && 'select--narrow', extra]}>
  <select id={id} aria-label={label}>
    <slot />
  </select>
  {/* Треугольник, а не значок: сплошная фигура из трёх точек не требует
      контура, и рисует её сам CSS обрезкой прямоугольника. */}
  <span class="select__chevron" aria-hidden="true"></span>
</span>

{/* Скрипт подгонки ширины удалён 7 сентября 2026. Он мерял выбранный пункт
    и ставил ширину числом — уже после первой отрисовки, и список на глазах
    ужимался: замер на 1440 — 130 против 122 на Music и Videos, 67,5 против
    59 на указателях имён. Дважды за загрузку, второй раз по fonts.ready.

    Заводился он ради жанров: их было 294 пункта, и браузер, меряющий
    закрытую кнопку по самому длинному, раздувал список вдвое против
    соседей. Жанры давно стали отбором с множественным выбором
    (MultiSelect), и в <select> остались только сортировки — по три-шесть
    коротких пунктов. Ширина по длиннейшему из них не мешает никому и, в
    отличие от подогнанной, не меняется ни при загрузке, ни при выборе.

    Указателям имён ширину и так задаёт .select--az (5.625rem). */}

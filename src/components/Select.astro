---
/* Выпадающий список со своим шевроном.

   Системную стрелку убираем: у неё не выровнять отступ справа под левый
   и не развернуть её при раскрытии. Шеврон — настоящий элемент, а не
   псевдоэлемент: так его состояние видно и в разметке, и в тестах.

   Раньше он был нарисован через clip-path; теперь это caret-down из
   Phosphor, как и остальные значки в проекте. */

/* initial — подпись, с которой страница открывается: её же несёт выбранный
   по умолчанию <option>. По ней и меряется ширина; см. двойник ниже. */
const { id, label, initial, class: extra } = Astro.props;
---
<span class:list={['select', extra]}>
  <select id={id} aria-label={label}>
    <slot />
  </select>

  {/* Двойник подписи: он один стоит в потоке и задаёт ширину, а сам <select>
      лежит на нём внахлёст. Без двойника ширину закрытой кнопки браузер
      берёт по самому длинному пункту, и рядом с выбранным коротким
      получается провал: замер на 1440 — сортировка на Music 130 при 122
      нужных, восемь пикселей пустоты между подписью и треугольником.

      До 7 сентября 2026 ширину ставил числом скрипт — по замеру выбранного
      пункта, уже после первой отрисовки, и список на глазах ужимался.
      Двойник считает то же самое, но это делает браузер при первой же
      раскладке: ни замеров, ни второго прохода. Скрипт остаётся только
      затем, чтобы переписать подпись двойника при выборе — а это ответ на
      нажатие, там движение и должно быть. */}
  <span class="select__ghost" aria-hidden="true">{initial}</span>

  {/* Треугольник, а не значок: сплошная фигура из трёх точек не требует
      контура, и рисует её сам CSS обрезкой прямоугольника. */}
  <span class="select__chevron" aria-hidden="true"></span>
</span>

<script>
  /* Подпись двойника — та же, что у выбранного пункта. При загрузке она уже
     стоит от сервера, и присваивания не происходит: браузер мог восстановить
     другой выбор (возврат назад, обновление с сохранённым значением), и вот
     тогда двойник подтягивается. Сравнение перед записью нужно ровно для
     этого — присваивание textContent само по себе перерисовывает узел. */
  for (const box of document.querySelectorAll('.select')) {
    const field = box.querySelector('select');
    const ghost = box.querySelector('.select__ghost');
    if (!field || !ghost) continue;

    const sync = () => {
      const подпись = field.options[field.selectedIndex]?.textContent ?? '';
      if (ghost.textContent !== подпись) ghost.textContent = подпись;
    };

    sync();
    field.addEventListener('change', sync);
  }
</script>

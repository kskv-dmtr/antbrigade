---
/* Решётка плиток с кнопкой «показать ещё» — та же, что на Music.

   Разделы у исполнителя, лейбла и жанра выкладывали всё разом. Длинных
   немного, но они есть: на 11 сентября 2026 жанров длиннее сорока восьми
   десять (Electronic 124, Jazz 95, Neo-Psychedelia 81), лейблов один — Not
   on Label со 112, у исполнителей максимум девять. Теперь первые 48 видны,
   остальные ждут нажатия; там, где записей меньше, кнопки просто нет.

   48, как на Music: там столько же в первом развороте — двенадцать полных
   рядов по четыре на расчётной ширине.

   Первый разворот отдаёт сервер: разметка приходит целиком (так страница
   работает без скрипта и достаётся поисковикам), а лишнее прячет правило
   по nth-child, которое действует только при data-js. Скрипт при первом же
   расчёте снимает метку и дальше ведёт видимость сам — иначе правило по
   номеру спорило бы с открытыми рядами. */

const { count } = Astro.props;

/* Число живёт здесь и продублировано в global.css номером в nth-child:
   правило должно работать до того, как поднимется скрипт. Меняете тут —
   меняйте и там. */
const PAGE = 48;
---
<ul class="tiles tiles--auto" data-cut>
  <slot />
</ul>

{count > PAGE && (
  <button type="button" class="more" data-page={PAGE}>
    Show more [{Math.min(PAGE, count - PAGE)}]
  </button>
)}

<script>
  /* Один проход на все решётки страницы: у исполнителя их две — релизы и
     клипы, — и каждая считает свой разворот сама. */
  for (const решётка of document.querySelectorAll('.tiles[data-cut]')) {
    const кнопка = решётка.nextElementSibling?.classList.contains('more')
      ? решётка.nextElementSibling
      : null;

    const плитки = [...решётка.children];
    const ШАГ = Number(кнопка?.dataset.page) || 48;
    let предел = ШАГ;

    const показать = () => {
      плитки.forEach((плитка, i) => { плитка.hidden = i >= предел; });

      /* Метку снимаем сразу: дальше видимостью заведует hidden, а правило по
         номеру мешало бы открывать следующие ряды. */
      решётка.removeAttribute('data-cut');

      if (!кнопка) return;

      /* Не меньше нуля: на последнем нажатии предел перескакивает остаток, и
         в подписи получалось «Show more [-20]». Кнопку в этот миг уже прячут,
         но отрицательное число не должно существовать даже мгновение. */
      const осталось = Math.max(0, плитки.length - предел);
      кнопка.hidden = осталось === 0;
      кнопка.textContent = `Show more [${Math.min(ШАГ, осталось)}]`;
    };

    показать();
    кнопка?.addEventListener('click', () => { предел += ШАГ; показать(); });
  }
</script>

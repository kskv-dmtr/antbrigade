---
/* Плитка клипа. Оформление то же, что у релиза: кадр, выворот по наведению,
   подпись под ним. Отличается пропорцией — 16:9 вместо 1:1: обрезать кадр до
   квадрата значит выбросить почти половину ширины, обычно вместе с лицами.

   Кадр скачан заранее и лежит локально. Если файла нет, остаётся штриховка:
   тянуть картинку с i.ytimg.com нельзя, YouTube в России режут.

   Обёртка по умолчанию <li>: на странице артиста плитки лежат в списке. На
   общей странице клипов плитка соседствует со строкой внутри общего <li>, и
   там нужен <div> — второй <li> внутри первого разметку сломал бы. */

import Icon from './Icon.astro';
import { thumbSrc, thumbSrcSet, videoTitle, videoArtists } from '../lib/db.js';

const { video, showArtist = false, as: Wrapper = 'li', class: extra } = Astro.props;

const src = thumbSrc(video, 480);

/* Вид ролика подписан ровно так, как он назван в Notion: «Official Video»,
   «Live Video». Сокращать до «Video» и «Live» значит заводить свой словарь,
   который придётся править каждый раз, когда в базе появится новый вид.

   Под кадром его нет — там, как и у релиза, только исполнитель и название.
   Вид показывается при наведении, в вывернутой плашке. */
const meta = video.kind ?? '';
---
<Wrapper class:list={['tile', 'tile--video', extra]}>
  <a class="tile__link" href={video.url} target="_blank" rel="noopener noreferrer">
    <div class="tile__art">
      {src && (
        <img
          src={src}
          srcset={thumbSrcSet(video)}
          sizes="(max-width: 640px) 90vw, 300px"
          width="480"
          height="270"
          loading="lazy"
          decoding="async"
          alt=""
        />
      )}
      <div class="tile__over" aria-hidden="true">
        <span class="tile__meta">{meta}</span>
        <span class="tile__cta">Watch <Icon name="arrow-elbow-down-right" class="icon-arrow" /></span>
      </div>
    </div>
    {showArtist && <span class="tile__artist">{videoArtists(video)}</span>}
    <span class="tile__title">{videoTitle(video)}</span>
  </a>
</Wrapper>

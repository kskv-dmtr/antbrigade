---
/* Строка клипа: исполнитель, название, вид.

   Тот же класс .row, что у релизов, но колонок три: даты у клипов нет, и
   четвёртая, годовая, осталась бы пустой дырой в сетке. */

import { videoTitle, videoArtists } from '../lib/db.js';

const { video } = Astro.props;
---
<a class="row row--video" href={video.url} target="_blank" rel="noopener noreferrer">
  <span class="row__artist">{videoArtists(video)}</span>
  <span class="row__title">{videoTitle(video)}</span>
  <span class="row__meta">{video.kind}</span>
</a>

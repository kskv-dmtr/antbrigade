---
/* Строка клипа: исполнитель, название, вид с годом.

   Тот же класс .row и та же раскладка, что у релизов: список в два столбца,
   строка в два ряда — исполнитель и вид ролика в первом, название и год во
   втором. Иначе названия на /videos начинались бы не там, где на /music, и
   вертикаль, по которой их читают, съезжала бы при переходе со списка на
   список.

   Год у клипов есть с 29 августа 2026 — это дата ролика из Notion. Пока её
   не было, четвёртая колонка стояла пустой.

   Вид стоит против имени, год против названия — как тип и год у релиза. */

import { videoTitle, videoArtists } from '../lib/db.js';

const { video } = Astro.props;

/* Только год: полная дата стоит на самой странице клипа, а в строке индекса
   от неё нужен порядок, а не число. Так же устроен и список релизов. */
const год = video.released ? video.released.slice(0, 4) : '—';
---
<a class="row row--release row--video" href={`/videos/${video.slug}`}>
  <span class="row__line">
    <span class="row__artist">{videoArtists(video)}</span>
    <span class="row__meta">{video.kind}</span>
  </span>
  <span class="row__line">
    <span class="row__title">{videoTitle(video)}</span>
    <span class="row__meta">{год}</span>
  </span>
</a>

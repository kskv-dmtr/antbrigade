---
/* Кнопка «показать плитками / показать списком» в полосе отбора.

   Стояла здесь, 4 сентября 2026 уехала в шапку значком и в тот же день
   вернулась обратно: рядом с фильтрами она читается настройкой показа, а
   рядом с разделами — ещё одним разделом.

   Вид при этом остался общим для всего сайта: он висит в data-view на
   <html> и запоминается в localStorage, как тема. Кнопка только
   переключает — то, чем она управляет, шире одной страницы, поэтому и
   target ей больше не нужен: списки читают атрибут сами.

   Обе подписи лежат в разметке всегда, видимую выбирает CSS по data-view.
   Значит она верна уже на первой отрисовке: страница, открытая с плитками,
   не мигнёт кнопкой, предлагающей плитки. */
---
<button type="button" class="view-toggle" id="view">
  <span class="view-toggle__grid">Show grid</span>
  <span class="view-toggle__list">Show list</span>
</button>

<script>
  /* Скрипт собирается один раз на страницу, сколько бы кнопок на ней ни
     стояло. Кнопка на странице одна, но это свойство Astro, а не наше
     везение. */
  const кнопка = document.getElementById('view');

  if (кнопка) {
    кнопка.addEventListener('click', () => {
      const дальше = document.documentElement.dataset.view === 'grid' ? 'list' : 'grid';

      document.documentElement.dataset.view = дальше;
      try { localStorage.setItem('view', дальше); } catch (e) {}
    });
  }
</script>

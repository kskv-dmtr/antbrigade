---
/* Кнопка «показать плитками / показать списком» в полосе раздела.

   Значком, а не словами. Стоит она в правой половине полосы, рядом с
   четырьмя списками отбора, и подпись словами — «Show grid» в 101 пиксель —
   перевешивала бы их: у списков подписи короче, а веса больше. Значок в
   квадрате 34 читается органом того же ряда, но не спорит за внимание.

   Вид общий для всего сайта: висит в data-view на <html> и запоминается в
   localStorage, как тема. Кнопка только переключает — то, чем она
   управляет, шире одной страницы.

   Оба значка лежат в разметке всегда, видимый выбирает CSS по data-view.
   Значит он верен уже на первой отрисовке: страница, открытая с плитками,
   не мигнёт значком, предлагающим плитки. Показан не текущий вид, а тот,
   куда переключит нажатие, — то же правило, что было у подписей. */

import Icon from './Icon.astro';
---
<button type="button" class="view-toggle" id="view" aria-label="Switch view">
  <Icon name="squares-four" class="view-toggle__icon view-toggle__grid" />
  <Icon name="rows" class="view-toggle__icon view-toggle__list" />
</button>

<script>
  /* Скрипт собирается один раз на страницу, сколько бы кнопок на ней ни
     стояло. Кнопка на странице одна, но это свойство Astro, а не наше
     везение. */
  const кнопка = document.getElementById('view');

  if (кнопка) {
    кнопка.addEventListener('click', () => {
      const дальше = document.documentElement.dataset.view === 'grid' ? 'list' : 'grid';

      document.documentElement.dataset.view = дальше;
      try { localStorage.setItem('view', дальше); } catch (e) {}
    });
  }
</script>

---
/* Кнопка «показать плитками / показать списком».

   До 3 сентября 2026 здесь стоял сегментированный переключатель `List |
   Grid` — оба вида разом, нажатый вывернут. Теперь одна кнопка, и на ней
   написано не то, что показано сейчас, а то, что будет по нажатию:
   «Show grid», пока идёт список, и «Show list», когда идут плитки.

   Так короче на целый сегмент — в строке управления, где семь контролов,
   это заметно, — и не требует читать, какая половина вывернута: подпись
   говорит сама.

   Обработчик здесь же, а не на странице: кнопка знает, каким списком
   управляет, по `target`. Прежний сегментированный переключатель этого не
   знал, и каждая страница держала свои четыре строки. */

const { id = 'views', target = 'grid', label = 'View' } = Astro.props;
---
{/* Без скрипта кнопки нет: вид переключает он, а сервер отдаёт всем один и
    тот же список строками. */}
<button
  type="button"
  class="view-toggle"
  id={id}
  data-target={target}
  data-view="grid"
  aria-label={label}
  hidden
>Show grid</button>

<script>
  /* Скрипт общий на страницу: Astro собирает его один раз, сколько бы кнопок
     на ней ни стояло. */
  for (const btn of document.querySelectorAll('.view-toggle')) {
    const list = document.getElementById(btn.dataset.target);
    if (!list) continue;

    btn.hidden = false;

    btn.addEventListener('click', () => {
      const станет = btn.dataset.view;
      list.dataset.view = станет;

      /* Кнопка всегда предлагает противоположное тому, что показано. */
      const дальше = станет === 'grid' ? 'list' : 'grid';
      btn.dataset.view = дальше;
      btn.textContent = дальше === 'grid' ? 'Show grid' : 'Show list';
    });
  }
</script>

---
/* Вид списка — четвёртым органом в ряду отбора, обычным выпадающим списком.

   Раньше это была кнопка: сперва с подписью «Show grid», потом значком.
   Обе выпадали из ряда — рядом с тремя списками отбора орган другого вида
   читался особым случаем, хотя выбирает ровно так же: одно значение из
   двух. Приём взят у Ghostly: «View As» стоит там в той же полосе, что и
   сам отбор.

   Вид общий для всего сайта: висит в data-view на <html> и запоминается в
   localStorage, как тема. Список только переключает — то, чем он
   управляет, шире одной страницы.

   Значение проставляет встроенный скрипт, а не сервер: сервер один на всех,
   а вид у каждого свой. Скрипт inline и стоит сразу за списком, поэтому
   успевает до первой отрисовки — страница, открытая с плитками, не мигнёт
   подписью «List». */

import Select from './Select.astro';
---
<Select id="view" label="View">
  <option value="list">List</option>
  <option value="grid">Grid</option>
</Select>

<script is:inline>
  (function () {
    var список = document.getElementById('view');
    if (!список) return;

    список.value = document.documentElement.dataset.view === 'grid' ? 'grid' : 'list';

    список.addEventListener('change', function () {
      document.documentElement.dataset.view = список.value;
      try { localStorage.setItem('view', список.value); } catch (e) {}
    });
  })();
</script>

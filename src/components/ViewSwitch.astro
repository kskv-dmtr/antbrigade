---
/* Вид списка — парой через косую черту, как «View As: Grid/List» у Ghostly.

   Не выпадающим списком: значений всего два, и прятать одно из них под
   раскрытие — лишнее движение ради выбора, который делается взглядом. Оба
   стоят на виду, текущее выделено цветом, второе приглушено и нажимается.

   Список был здесь 5 сентября 2026 несколько часов, до него — кнопка со
   значком, а до неё кнопка с подписью «Show grid». Все три прятали половину
   выбора.

   Вид общий для всего сайта: висит в data-view на <html> и запоминается в
   localStorage, как тема. Какой сейчас — решает CSS по тому же атрибуту,
   поэтому подсветка верна уже на первой отрисовке, до всякого скрипта. */
---
<span class="view-pick">
  <button type="button" class="view-pick__opt" data-view-opt="grid">Grid</button>
  <span class="view-pick__slash" aria-hidden="true">/</span>
  <button type="button" class="view-pick__opt" data-view-opt="list">List</button>
</span>

<script>
  /* Скрипт собирается один раз на страницу, сколько бы таких пар на ней ни
     стояло. */
  for (const кнопка of document.querySelectorAll('.view-pick__opt')) {
    кнопка.addEventListener('click', () => {
      const вид = кнопка.dataset.viewOpt;

      document.documentElement.dataset.view = вид;
      try { localStorage.setItem('view', вид); } catch (e) {}
    });
  }
</script>

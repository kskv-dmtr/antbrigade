---
/* Имя, которое переносится только по пробелам.

   Каждое слово завёрнуто в неразрывный кусок: без этого строка ломается и
   внутри слова — по дефису («Disco-» на одной строке, «Punk» на следующей),
   по косой, по точке. В названиях жанров и лейблов дефис встречается часто
   (Electro-Industrial, Singer-Songwriter, Post-Punk), и разорванное имя
   читается двумя.

   Пробелы между кусками остаются обычными — они и дают строке место для
   переноса. Само слово при этом может оказаться шире колонки; там, где такое
   возможно, кегль считается от ширины экрана (см. .lead .item__title). */

const { text = '' } = Astro.props;
const слова = String(text).split(/(\s+)/);
---
{слова.map((кусок) => (/^\s+$/.test(кусок) ? кусок : <span class="nb">{кусок}</span>))}

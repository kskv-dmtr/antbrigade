---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import SearchField from '../components/SearchField.astro';

import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import grotesk from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

/* cardTitle — заголовок для карточки, которая разворачивается при отправке
   ссылки. Обычно задавать не нужно: по умолчанию берётся заголовок вкладки
   без приписки с именем сайта. Главная — исключение: во вкладке у неё
   короткое «ant brigade», а в карточке человек видит ссылку без сайта
   вокруг, и там уместно объяснить, куда он попадёт.

   image — своя картинка карточки: у релиза это его обложка. Без неё берётся
   иконка сайта.

   noindex — страница не для выдачи. Сейчас такая одна, 404: хостинг отдаёт
   её с кодом 404, и поисковик её и так не возьмёт, но сам файл лежит ещё и
   по адресу /404 и оттуда отвечает обычным «двухсотым». */
const { title, description, activeSection, cardTitle, image, noindex } = Astro.props;

/* Разделы сайта: макет рисовал Video и Info, но страниц под них нет, а
   ссылка в никуда хуже отсутствующего пункта.

   «Lucky Finds» стоит первым и ведёт на витрину. До 5 сентября 2026 его тут
   не было: на главную вело слово слева, и пункт считался лишним. Слово,
   однако, читается подписью сайта, а не органом — по нему не видно, что
   оно куда-то ведёт, — и возврат на витрину приходилось угадывать. Меню
   теперь перечисляет все разделы подряд, включая тот, с которого
   начинают. Слово слева осталось ссылкой: убирать её незачем.

   Зовётся пункт именем самой страницы, а не «Home»: у витрины с 11 сентября
   2026 есть собственный заголовок, и меню называет её так же, как она
   называет себя. Остальные пункты и так зовутся именами своих страниц.

   «Music» указывает на /music: каталог живёт там, а главная осталась
   витриной со свежим и случайным. Прежний адрес /releases переправляется
   сюда постоянным редиректом — на него уже ведут внешние ссылки.

   Пунктов четыре, а не семь, с 12 сентября 2026: витрина, каталог, клипы и
   «Explore». Последний ничего не открывает сам — он раскрывает четыре
   указателя: исполнителей, лейблы, жанры и подборки. Ни один из них не
   раздел каталога, все четыре — способы в него войти, и семью словами подряд
   меню перечисляло всё, что есть, вместо того чтобы предложить выбор.

   11 сентября 2026 те же четыре указателя полдня жили отдельной страницей
   /explore со свёрнутыми списками. Страница удалена: ради выбора из четырёх
   слов человек делал лишний переход, а сами списки на ней повторяли
   указатели — и весили 358 КБ разметки.

   Клипы вторым пунктом, сразу за Music, стояли до 7 сентября 2026, потом
   последними — их 87 против 1167 релизов. Теперь порядок снова свой: сперва
   то, ради чего приходят, потом способ найти. */
/* Тема на сайте одна — светлая, с 7 сентября 2026. Тёмная никуда не делась:
   её набор токенов лежит в global.css, кнопка с половинкой кружка — в
   разметке ниже, значок — в Icon.astro. Флаг снимает кнопку из шапки и
   заставляет скрипт ставить светлую всем, не спрашивая localStorage;
   поставить обратно true — вернуть переключатель как был. */
const ТЕМА_ПЕРЕКЛЮЧАЕТСЯ = false;

/* У последнего пункта вместо адреса — свои пункты: он ничего не открывает
   сам, а раскрывает четыре указателя. Отмечается он, когда открыт любой из
   них. */
const nav = [
  { href: '/',       label: 'Lucky Finds', key: 'home' },
  { href: '/music',  label: 'Music',       key: 'albums' },
  { href: '/videos', label: 'Video',       key: 'videos' },
  {
    label: 'Explore',
    items: [
      { href: '/artists',   label: 'Artists',   key: 'artists' },
      { href: '/labels',    label: 'Labels',    key: 'labels' },
      { href: '/genres',    label: 'Genres',    key: 'genres' },
      { href: '/playlists', label: 'Playlists', key: 'playlists' }
    ]
  }
];

/* Пункт с вложенными — тот, что раскрывает полосу второго уровня. Он один;
   ищем его, а не берём по номеру, чтобы порядок в списке выше можно было
   менять свободно. */
const explore = nav.find((item) => item.items);

/* Год в знаке охраны — от времени сборки, а не вписанный руками: сайт
   пересобирается ежечасно, так что первого января он сменится сам. */
const year = new Date().getFullYear();

/* Сборка идёт с format: 'file', поэтому внутри пути живут с расширением:
   /artists.html. Наружу Vercel с cleanUrls отдаёт /artists, а .html-адрес
   переправляет 308-м. Срезаем расширение, иначе канонической объявляется
   ссылка на редирект — ровно то, ради чего canonical и ставят. */
const canonical = new URL(
  Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, ''),
  Astro.site
);

/* Картинка карточки. Адрес обязан быть полным: разворачивают ссылку чужие
   серверы, и относительный путь им не от чего отсчитывать.

   Обложки лежат в webp. Telegram, куда эти ссылки и попадают чаще всего,
   его понимает; у части других сервисов поддержка неровная, и там карточка
   останется без картинки — но текст покажется в любом случае. Заводить
   ради них вторую копию каждой обложки в jpeg не стоит того. */
const cardImage = new URL(image ?? '/icons/icon-512.png?v=2026-08-08', Astro.site);

/* Три файла, которыми набрана вся страница на латинице: основной, моноширинный
   и шрифт логотипа. Остальные одиннадцать начертаний пакета — кириллица,
   вьетнамский, символы — браузер берёт сам и только если они на странице
   понадобились: у каждого лица свой unicode-range.

   Адреса берём у сборщика через ?url: в имени файла стоит отпечаток
   содержимого, и написать его руками нельзя. */

/* Во вкладке к заголовку приписано имя сайта — там ему неоткуда взяться
   иначе. В карточке оно уже стоит отдельной строкой в og:site_name, и
   вторым разом читалось бы заиканием. Срезаем по умолчанию; страница может
   задать свой cardTitle, как это делает главная. */
const cardHeading = cardTitle ?? title.replace(/\s·\sant brigade$/, '');

/* data-view стоит прямо на <html> в разметке, а не только в скрипте. Правила
   переключения вида ищут этот атрибут, и без него у каждой записи были бы
   видны обе разметки разом — и строка, и плитка: у того, кто отключил
   скрипты, список превратился бы в кашу. Инлайновый скрипт в <head>
   перебивает значение выбором человека до первой отрисовки.

   Пояснение живёт здесь, а не комментарием над тегом: комментарий между
   <!doctype> и <html> ломает разбор — Astro выбрасывает сам тег <html>
   вместе с lang, и страница уезжает в выдачу без языка. Проверено на
   сборке 4 сентября 2026. */
---
<!doctype html>
<html lang="en" data-view="list">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {/* Фон и color-scheme — прямо в разметке, до внешней таблицы стилей.

      Холст у браузера белый, пока таблица не разобрана, и на тёмном сайте
      каждый переход по ссылке начинался белой вспышкой. Таблица блокирует
      отрисовку, но сам холст она красит только когда доедет; эти две строки
      доезжают вместе с разметкой.

      Значения повторяют --bg обеих тем. Это единственное место, где цвет
      написан числом дважды: подставить сюда переменную нельзя — она живёт в
      той самой таблице, которой ещё нет. Меняете --bg — поправьте и здесь.

      Атрибут data-theme к этому времени уже стоит: скрипт ниже выполняется
      раньше первой отрисовки. */}
  <style is:inline>
    :root { color-scheme: light; background: #fbfaf8; }
    :root[data-theme='dark'] { color-scheme: dark; background: #0c0c0b; }
  </style>

  {/* Шрифты просим заранее: иначе браузер узнаёт о них только разобрав
      таблицу стилей, и первые кадры страница набрана системным шрифтом, а
      потом перебирается заново — то самое мерцание при загрузке. */}
  <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={grotesk} as="font" type="font/woff2" crossorigin />

  {/* Каноническая ссылка — только у страниц, которым место в выдаче.
      Ставить её на noindex значит говорить две вещи разом: «не бери» и
      «главный адрес этой страницы вот». Одного запрета достаточно. */}
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <link rel="canonical" href={canonical} />}

  {/* Карточка ссылки. Проект живёт тем, что ссылки кидают в переписку, и без
      этой разметки они разворачивались пустыми — ни обложки, ни подписи.
      Для поиска эти теги роли не играют, это про мессенджеры. */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ant brigade" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={cardHeading} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:image" content={cardImage} />

  {/* Крупная карточка, а не строчка с миниатюрой: обложка здесь и есть
      содержание. */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={cardHeading} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={cardImage} />

  {/* Комментарии здесь только в фигурных скобках: HTML-комментарии Astro
      отдаёт наружу, и на 2840 страницах это лишний мегабайт трафика.

      Установка на домашний экран. Service worker не нужен: Chrome убрал его
      из требований к установке, а кэширование добавим отдельно. */}
  <link rel="manifest" href="/manifest.webmanifest" />

  {/* Цвет полосы браузера — светлый, как фон единственной темы. Пока был
      переключатель, его переписывал скрипт при каждом нажатии. */}
  <meta name="theme-color" content="#fbfaf8" id="theme-color" />

  {/* Тема ставится здесь, в <head>, до того как отрисуется хоть что-то:
      поставь её ниже — и страница успела бы мигнуть чужим цветом.

      Тема одна, светлая: выбора нет, localStorage не спрашивается. Пока
      переключатель выключен флагом, значение проставляется всем одинаковое —
      набор тёмной темы при этом остаётся в стилях нетронутым. */}
  <script is:inline>
    (function () {
      var вид = null;
      try {
        вид = localStorage.getItem('view');
      } catch (e) {}

      document.documentElement.dataset.theme = 'light';

      /* Вид списков — такая же настройка человека, как тема: выбрал раз и
         дальше весь сайт показывает списки так. Строками по умолчанию:
         тысяча с лишним записей плитками — это про разглядывание, а
         строками про поиск, и приходят сюда чаще искать.

         Ставится здесь, до отрисовки: поставь ниже — и список успел бы
         мигнуть строками, прежде чем стать плитками. */
      document.documentElement.dataset.view = вид === 'grid' ? 'grid' : 'list';

      /* Метка «скрипты работают». По ней мобильная шапка складывается в одну
         строку, а меню уезжает под бургер. Стояла она до 6 сентября 2026 в
         теле, сразу за шапкой, и на телефоне меню успевало моргнуть
         развёрнутым: семь строк появлялись и пропадали. Здесь она стоит до
         первой отрисовки, как тема и вид. */
      document.documentElement.dataset.js = '';
    })();
  </script>

  {/* Метка версии в адресе — не украшение. Имена файлов иконок постоянны, и
      у тех, кто заходил до замены картинки, лежит старая копия; другой адрес
      — другая запись в кэше, поэтому свежую получают все. Менять метку при
      каждой замене иконок, здесь и в manifest.webmanifest. */}
  <link rel="icon" href="/icons/favicon-32.png?v=2026-08-08" sizes="32x32" type="image/png" />
  <link rel="icon" href="/icons/icon-192.png?v=2026-08-08" sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=2026-08-08" />

  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="ant brigade" />
  {/* Часы в статус-баре светлые, потому что страница под ними тёмная.

      Со светлой темой это расходится: значение читается при запуске
      установленного приложения и на ходу не меняется, как и theme_color в
      манифесте. То есть у поставившего приложение обрамление останется
      тем, каким было при установке. Трогать не стал: значение default
      вернуло бы обычную полосу с тёмными часами всем, включая тех, у кого
      тёмная тема, и отняло бы у них край в край. Задето это только у
      установленного приложения на iOS. */}
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="masthead">
    <div class="masthead__in shell">
      <a class="brand" href="/">ant brigade</a>

      {/* Кнопка есть в разметке всегда, но показывает её только мобильный
          медиазапрос и только при [data-js]: без скрипта нажимать было бы
          не на что, и меню там остаётся развёрнутым, как было. */}
      <button
        class="burger"
        type="button"
        id="burger"
        aria-controls="nav"
        aria-expanded="false"
        aria-label="Menu"
      >
        {/* Оба значка лежат друг на друге, видимый выбирает прозрачность по
            data-open на шапке. Так переход остаётся плавным и не требует
            скрипта: атрибут и без того ставит обработчик меню. */}
        <Icon name="list" class="burger__icon burger__icon--menu" />
        <Icon name="x" class="burger__icon burger__icon--close" />
      </button>

      {/* Подпись вплотную к тегу, без переноса строки: пробелы по краям
          попадают в ссылку, и подчёркивание с вывороткой вылезали бы за букву
          на пробел с каждой стороны. */}
      <nav class="nav" id="nav">
        {nav.map((item) => (item.items
          /* Раскрывающийся пункт — родное <details>, как свёрнутый блок
             «Info» на странице исполнителя: работает без скрипта, состояние
             помнит браузер. Оно же держит и полосу второго уровня под
             шапкой: её показывает CSS по `.masthead:has(.nav__drop[open])`,
             то есть без единой строчки скрипта.

             Открыт по умолчанию на своих четырёх страницах: пришёл к
             исполнителям — соседние указатели под рукой, и лишнее нажатие
             на то, что и так открыто, не нужно.

             Отметка текущего раздела — на самом пункте (он ведёт себя как
             ссылка на четыре страницы сразу) и на строке в полосе.
             aria-current остаётся при ссылке: у <summary> его читать
             нечему.

             Список внутри <details> остался для узкого экрана: там меню
             уезжает под бургер, полосы второго уровня нет, и четыре строки
             раскрываются прямо в этаже меню. Двойник в разметке, а не
             переезд стилями: перенести узел из одного контейнера в другой
             средствами CSS нельзя. */
          ? (
            <details
              class="nav__drop"
              open={item.items.some((s) => s.key === activeSection) || undefined}
              data-here={item.items.some((s) => s.key === activeSection) ? '' : undefined}
            >
              <summary class="nav__sum">
                {item.label}
                <span class="select__chevron nav__mark" aria-hidden="true"></span>
              </summary>

              <div class="nav__panel">
                {item.items.map((sub) => (
                  <a href={sub.href} aria-current={activeSection === sub.key ? 'page' : undefined}>{sub.label}</a>
                ))}
              </div>
            </details>
          ) : (
            <a href={item.href} aria-current={activeSection === item.key ? 'page' : undefined}>{item.label}</a>
          )
        ))}
      </nav>

      {/* Поиск живёт в шапке, а не на странице: ищут по каталогу целиком, а
          не по тому, что сейчас открыто, и место у поля одно на весь сайт.
          Стоит левее переключателя темы: тема и меню — про сайт целиком,
          поиск — про содержимое, и он ближе к нему.

          Так было и 5 сентября 2026; на день поле уезжало в полосу заголовка
          списка, где искало только по открытому списку. */}
      <SearchField />

      {/* Переключатель темы — последним в разметке, после меню. Выключен
          флагом с 7 сентября 2026: тема на сайте одна.


          На широком экране он встаёт справа от разделов, на узком меню
          уезжает под бургер и из потока выпадает, поэтому кнопка остаётся
          видимой и порядком встаёт перед бургером.

          Одна кнопка, а не пара сегментов, — и логика ровно как у кнопки
          вида на списках: показано то, что будет по нажатию, а не то, что
          сейчас. В тёмной теме нарисовано солнце, потому что нажатие
          включит светлую.

          Это и снимает двусмысленность, из-за которой значки в июле
          заменяли словами: солнце с полумесяцем сами по себе не говорят,
          текущее это состояние или будущее. Рядом стоит Show grid с той же
          логикой, и пара читается одинаково.

          Оба контура лежат в разметке всегда, видимый выбирает CSS по
          data-theme на <html> — значит он верен уже на первой отрисовке,
          до всякого скрипта. Скрипт доставляет только подпись для
          экранного диктора: текста у кнопки нет, а стилями её не задать. */}
      {ТЕМА_ПЕРЕКЛЮЧАЕТСЯ && (
        <button
          class="theme-toggle"
          type="button"
          id="theme"
          aria-label="Switch theme"
        >
          <Icon name="circle-half" class="theme-toggle__icon" />
        </button>
      )}
    </div>

    {/* Полоса второго уровня: четыре указателя под шапкой, ростом с полосу
        отбора на списках (та же --filters-h). Стоит внутри <header>, а не
        падает поверх страницы: это ещё одна строка шапки, и содержимое под
        ней должно сдвигаться, а не прятаться. Высоту шапки скрипт снимает с
        готовой вёрстки, поэтому липкие полосы разделов встают под неё сами.

        Показывает полосу CSS — по раскрытому <details> в меню. Скрипту
        достаётся только пересчёт высоты после переключения. */}
    {explore && (
      <div class="subhead">
        <div class="subnav shell">
          {explore.items.map((sub) => (
            <a href={sub.href} aria-current={activeSection === sub.key ? 'page' : undefined}>{sub.label}</a>
          ))}
        </div>
      </div>
    )}
  </header>

  <main id="main" class="shell">
    <slot />
  </main>

  {/* Слева — что это за сайт, справа — кто его сделал и куда написать.
      По три строки в каждой колонке: подвал у витрины должен читаться
      одним взглядом, а не разбираться. */}
  {/* Поля кадра держит сам подвал, а не ряд внутри него: ряд стоит на общей
      решётке и выходит из полей отрицательными полями, как все её блоки, —
      а выйти из собственных полей элемент не может. Пока shell висел на
      ряду, тот становился шире кадра на 12 и страница ехала вбок. */}
  <footer class="foot">
    <div class="foot__in">
      {/* Слева, от края кадра, — что это за сайт и кто его собрал. */}
      <div class="foot__note mono mono--sm">
        a personal music &amp; video archive<br />
        made for fun by <a href="https://t.me/kskv_dmtr" target="_blank" rel="noopener noreferrer">Dmitriy Kuskov</a>
      </div>

      {/* Правая половина подвала: каналы от центральной линии, справка о
          наполнении — у правого края. Обёртка нужна, чтобы у обеих был общий
          отсчёт: половина начинается ровно на средней вертикали решётки, и
          каналы встают на ту же линию, что текст в ячейке справки на странице
          релиза. */}
      <div class="foot__side">
        <div class="foot__links">
          <a class="foot__btn" href="https://t.me/antbrigade" target="_blank" rel="noopener noreferrer">
            @antbrigade
          </a>
          <a class="foot__btn" href="https://t.me/antbrigade_rar" target="_blank" rel="noopener noreferrer">
            @antbrigade_rar
          </a>
        </div>

        <div class="foot__note foot__note--end mono mono--sm">
          new releases · old favorites · strange finds<br />
          © {year} · 1723 · 1312
        </div>
      </div>
    </div>
  </footer>

  <script>
    /* Переключатель темы. Саму тему поставил инлайновый скрипт в <head>, а
       какой контур показать — решает CSS по data-theme. Здесь остаётся
       нажатие, запоминание и две вещи, которые стилями не задать: подпись
       для экранного диктора и цвет полосы браузера.

       Цвет берём из токена --bg, а не из своего списка: держать второй
       перечень цветов в скрипте — верный способ развести их при первой же
       правке палитры. */
    const themeBtn = document.getElementById('theme');

    if (themeBtn) {
      const paint = () => {
        // Подпись называет действие, а не состояние: у кнопки нет текста,
        // и диктору надо сказать, что произойдёт по нажатию — ровно то же,
        // что написано словами на кнопке вида.
        const дальше = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        themeBtn.setAttribute('aria-label', дальше === 'light'
          ? 'Switch to light theme'
          : 'Switch to dark theme');

        const meta = document.getElementById('theme-color');
        if (meta) {
          meta.content = getComputedStyle(document.documentElement)
            .getPropertyValue('--bg').trim();
        }
      };

      paint();

      themeBtn.addEventListener('click', () => {
        const дальше = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';

        document.documentElement.dataset.theme = дальше;
        try { localStorage.setItem('theme', дальше); } catch (err) {}
        paint();
      });
    }

    /* ------------------------------------------------------------------
       Цветной ховер, 7 сентября 2026.

       Набор цветов и сама заливка — в global.css. Здесь только
       жеребьёвка: при каждом новом наведении
       карточке достаётся один из пяти цветов, и дважды подряд один и тот
       же не выпадает — иначе переход с карточки на карточку читался бы
       как отсутствие отклика.

       Слушатель один на весь документ, а не по слушателю на карточку: их
       на Music больше тысячи. pointerover всплывает, и по closest всегда
       понятно, над чем курсор.

       Снять цвет — удалить этот блок: без data-hot заливка не включается,
       и отклик возвращается к прежнему. ---------------------------- */
    const ЦВЕТА = [
      ['var(--hot-1)', 'var(--hot-1-fg)'],
      ['var(--hot-2)', 'var(--hot-2-fg)'],
      ['var(--hot-3)', 'var(--hot-3-fg)'],
      ['var(--hot-4)', 'var(--hot-4-fg)'],
      ['var(--hot-5)', 'var(--hot-5-fg)'],
      ['var(--hot-6)', 'var(--hot-6-fg)'],
      ['var(--hot-7)', 'var(--hot-7-fg)'],
      ['var(--hot-8)', 'var(--hot-8-fg)']
    ];

    let подсвечена = null;
    let прошлый = -1;

    addEventListener('pointerover', (e) => {
      const карта = e.target instanceof Element
        ? e.target.closest('a, .more, .dig-again, .view-pick__opt, .nav__sum')
        : null;

      if (карта === подсвечена) return;

      if (подсвечена) {
        подсвечена.removeAttribute('data-hot');
        подсвечена.style.removeProperty('--hot');
        подсвечена.style.removeProperty('--hot-fg');
      }

      подсвечена = карта;
      if (!карта) return;

      let n;
      do { n = Math.floor(Math.random() * ЦВЕТА.length); } while (n === прошлый);
      прошлый = n;

      карта.style.setProperty('--hot', ЦВЕТА[n][0]);
      карта.style.setProperty('--hot-fg', ЦВЕТА[n][1]);
      карта.dataset.hot = '';
    }, { passive: true });

    /* Закрытия по нажатию мимо и по Escape у раскрывающегося пункта больше
       нет — оно было написано для панели, падавшей поверх страницы.
       12 сентября 2026 список стал полосой второго уровня внутри шапки: это
       не всплывающее окно, а ещё одна строка меню, и пропадать от нажатия
       где-то на странице она не должна. Закрывает её то же слово, которым
       открыли. */

    /* Бургер. Меню закрывается по Escape, по касанию мимо шапки и при
       переходе на широкий экран: там пункты снова стоят в строке, и
       забытое открытое состояние оставило бы крест вместо кнопки. */
    const masthead = document.querySelector('.masthead');
    const burger = document.getElementById('burger');

    if (burger) {
      const setOpen = (on) => {
        masthead.toggleAttribute('data-open', on);
        burger.setAttribute('aria-expanded', String(on));
      };

      burger.addEventListener('click', () => setOpen(!masthead.hasAttribute('data-open')));

      addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !masthead.hasAttribute('data-open')) return;
        setOpen(false);
        // Фокус возвращаем на кнопку: иначе он остался бы в закрытой панели.
        burger.focus();
      });

      addEventListener('click', (e) => {
        if (!masthead.contains(e.target)) setOpen(false);
      });

      matchMedia('(min-width: 641px)').addEventListener('change', (e) => {
        if (e.matches) setOpen(false);
      });
    }

    /* Высота шапки снимается с готовой вёрстки, а не задаётся числом: от неё
       отсчитывается положение липкой полосы, и расхождение даже в пиксель
       оставляет щель, сквозь которую едет содержимое. Числа в CSS остаются
       запасными — они работают до выполнения скрипта и остаются
       единственными, если он отключён.

       Ставим значение, только если запасное разошлось с настоящим больше чем
       на пиксель. Иначе скрипт двигал липкие полосы на доли пикселя сразу
       после первой отрисовки: замер на 1440 — запасные 62 против настоящих
       61,6, и обе полосы, заголовка и отбора, вздрагивали вместе со всеми
       подписями в них. Щель в полпикселя не видна, а движение видно.

       Сравнение работает только потому, что --head-h объявлена через @property
       в global.css: незаявленную переменную getComputedStyle отдал бы строкой
       «max(62px, 4.5rem)», parseFloat выдал бы NaN, и порог не сработал бы ни
       разу.

       Пересчитываем при смене размера окна и после загрузки шрифтов: до неё
       строку меряет запасной шрифт, и высота выходит другая. */
    if (masthead) {
      const setHeadHeight = () => {
        const измерено = masthead.getBoundingClientRect().height;
        const сейчас = parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue('--head-h')
        );

        if (!(Math.abs(измерено - сейчас) <= 1)) {
          document.documentElement.style.setProperty('--head-h', измерено + 'px');
        }
      };

      setHeadHeight();
      addEventListener('resize', setHeadHeight, { passive: true });
      document.fonts?.ready.then(setHeadHeight);

      /* Полоса второго уровня прибавляет шапке целый ряд, и липкие полосы
         разделов обязаны встать ниже ровно на него. Событие toggle у
         <details> приходит после перерисовки, так что мерить уже есть что. */
      for (const пункт of document.querySelectorAll('.nav__drop')) {
        пункт.addEventListener('toggle', setHeadHeight);
      }
    }

    /* Прилипла полоса раздела или ещё нет — в CSS не спросить, поэтому
       ставим атрибут сами: у прилипшей появляется линия снизу, потому что
       ряд обложек, который чертил её на месте, к этому моменту уехал вверх.

       Считаем по прокрутке, а не наблюдателем за пересечением. Наблюдатель
       здесь обманывает: он уведомляет только когда состояние «виден» само
       меняется, а при прыжке по странице — переход по якорю, восстановленное
       место, быстрый бросок колесом — полоса успевает уйти под шапку, ни
       разу не показавшись, и уведомления не приходит вовсе. Проверено.

       Место полосы снимается при выключенной липкости: у sticky-элемента
       getBoundingClientRect врёт ровно на то, что мы измеряем. Тот же приём
       и с той же причиной, что у липкой полосы списков ниже. */
    const полосы = [...document.querySelectorAll('.head--sticky, .filters-row')];

    if (полосы.length) {
      /* Отступ у каждой полосы свой: заголовок раздела встаёт под шапку, а
         полоса отбора на списках — под заголовок. Берём его из самого
         правила, а не считаем заново: в CSS он уже посчитан, и второй счёт
         разошёлся бы с первым. Читаем до подмены на static — у статического
         элемента top становится auto. */
      let верх = [];
      let якоря = [];

      const измерить = () => {
        верх = полосы.map((полоса) => parseFloat(getComputedStyle(полоса).top) || 0);

        якоря = полосы.map((полоса) => {
          const было = полоса.style.position;
          полоса.style.position = 'static';
          const место = полоса.getBoundingClientRect().top + scrollY;
          полоса.style.position = было;
          return место;
        });
      };

      const красить = () => {
        полосы.forEach((полоса, i) => {
          полоса.toggleAttribute('data-stuck', scrollY + верх[i] > якоря[i]);
        });
      };

      const пересчитать = () => { измерить(); красить(); };

      пересчитать();
      addEventListener('scroll', красить, { passive: true });
      addEventListener('resize', пересчитать, { passive: true });
      document.fonts?.ready.then(пересчитать);
    }

    /* Липкая полоса списков прячется при прокрутке вниз и возвращается при
       прокрутке вверх. Шапка при этом закреплена и видна всегда.

       Порог в 6 пикселей нужен, чтобы полоса не дёргалась от инерционной
       прокрутки и подрагивания тачпада: без него колебание в один пиксель
       считалось бы сменой направления. */
    const bar = document.querySelector('.sticky-bar');

    if (bar) {
      const STEP = 6;
      let last = window.scrollY;

      /* Место полосы в документе, снятое один раз и при выключенной
         липкости. Через offsetTop его не узнать: у sticky-элемента тот
         растёт вместе с прокруткой, и проверка «ещё не долистали» была бы
         верна всегда — полоса не пряталась бы никогда. */
      const prev = bar.style.position;
      bar.style.position = 'static';
      const anchorY = bar.getBoundingClientRect().top + window.scrollY;
      bar.style.position = prev;

      addEventListener('scroll', () => {
        const y = window.scrollY;

        // Пока полоса не дошла до липкого положения, прятать нечего:
        // иначе она дёргалась бы у начала страницы.
        if (y <= anchorY) bar.removeAttribute('data-hidden');
        else if (y > last + STEP) bar.setAttribute('data-hidden', '');
        else if (y < last - STEP) bar.removeAttribute('data-hidden');

        if (Math.abs(y - last) > STEP) last = y;
      }, { passive: true });

      /* Полоса живёт событиями прокрутки, а список под ней умеет внезапно
         укорачиваться: выбрали редкую букву — и от девятисот имён осталось
         два. Страница становится короче экрана, прокручивать нечего, новых
         событий не приходит, и спрятанная полоса остаётся спрятанной. Найти
         её тогда невозможно: она уехала под шапку, а вернуть нечем.

         Ловим это по самой правке разметки: фильтры прячут записи атрибутом
         hidden. Через ResizeObserver было бы прямее, но его вызовы привязаны
         к отрисовке кадров, а MutationObserver срабатывает всегда — в том
         числе в фоновой вкладке, где кадров не рисуют. */
      const следитьЗаСписком = new MutationObserver(() => {
        if (document.documentElement.scrollHeight <= innerHeight + STEP) {
          bar.removeAttribute('data-hidden');
          last = window.scrollY;
        }
      });
      следитьЗаСписком.observe(document.getElementById('main'), {
        subtree: true, attributes: true, attributeFilter: ['hidden']
      });
    }

    /* Косая черта фокусирует поиск, Escape его отпускает — как на GitHub. */
    const search = document.getElementById('search');

    if (search) {
      addEventListener('keydown', (e) => {
        // Сочетания не трогаем: Ctrl+/ и подобные принадлежат браузеру.
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;

        /* Если пользователь уже что-то набирает, косая черта должна
           набраться, а не увести фокус. */
        const el = document.activeElement;
        if (el && (el.isContentEditable ||
                   ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName))) return;

        e.preventDefault();
        // Полоса могла быть спрятана прокруткой — возвращаем, иначе фокус
        // уйдёт на элемент за пределами экрана.
        if (bar) bar.removeAttribute('data-hidden');
        search.focus();
        search.select();
      });

      search.addEventListener('keydown', (e) => {
        // Только снимаем фокус: набранное не стираем, иначе Escape рушил бы
        // выборку, которую человек собирал.
        if (e.key === 'Escape') search.blur();
      });
    }
  </script>
</body>
</html>

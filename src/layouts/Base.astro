---
import '../styles/global.css';
import { generatedAt } from '../lib/db.js';

const { title, description, activeSection } = Astro.props;
const nav = [
  { href: '/',         label: 'Альбомы', key: 'albums' },
  { href: '/artists/', label: 'Артисты', key: 'artists' },
  { href: '/labels/',  label: 'Лейблы',  key: 'labels' }
];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="color-scheme" content="dark light" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

  {/* Комментарии здесь только в фигурных скобках: HTML-комментарии Astro
      отдаёт наружу, и на 2546 страницах это лишний мегабайт трафика.

      Установка на домашний экран. Service worker не нужен: Chrome убрал его
      из требований к установке, а кэширование добавим отдельно. */}
  <link rel="manifest" href="/manifest.webmanifest" />

  {/* Цвет панели браузера подстраивается под тему страницы. В установленном
      приложении заголовок красит theme_color из манифеста. */}
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0d0f" />

  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/icons/icon-192.png" sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="music" />
  {/* default вместо black-translucent: последний делает часы белыми всегда,
      и на светлой теме они пропадают. Пересмотреть, когда будет макет. */}
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
</head>
<body>
  <a class="skip" href="#main">К содержимому</a>

  <header class="masthead">
    <a class="brand" href="/">music</a>
    <nav class="nav">
      {nav.map((item) => (
        <a href={item.href} aria-current={activeSection === item.key ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    Источник — база в Notion. Обновлено {generatedAt ? generatedAt.slice(0, 10) : '—'}.
  </footer>
</body>
</html>

---
import '../styles/global.css';
import { generatedAt } from '../lib/db.js';

const { title, description, activeSection } = Astro.props;

/* Разделы сайта те же, что были: макет рисовал Video и Info, но страниц под
   них нет, а ссылка в никуда хуже отсутствующего пункта. Переименован только
   первый — «Releases» из макета, и по смыслу это точнее: в базе не одни
   альбомы, там же синглы и EP. */
const nav = [
  { href: '/',        label: 'Releases', key: 'albums' },
  { href: '/artists', label: 'Artists',  key: 'artists' },
  { href: '/labels',  label: 'Labels',   key: 'labels' },
  { href: '/genres',  label: 'Genres',   key: 'genres' }
];

const year = new Date().getFullYear();

/* Сборка идёт с format: 'file', поэтому внутри пути живут с расширением:
   /artists.html. Наружу Vercel с cleanUrls отдаёт /artists, а .html-адрес
   переправляет 308-м. Срезаем расширение, иначе канонической объявляется
   ссылка на редирект — ровно то, ради чего canonical и ставят. */
const canonical = new URL(
  Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, ''),
  Astro.site
);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="color-scheme" content="dark" />
  <link rel="canonical" href={canonical} />

  {/* Комментарии здесь только в фигурных скобках: HTML-комментарии Astro
      отдаёт наружу, и на 2840 страницах это лишний мегабайт трафика.

      Установка на домашний экран. Service worker не нужен: Chrome убрал его
      из требований к установке, а кэширование добавим отдельно. */}
  <link rel="manifest" href="/manifest.webmanifest" />

  {/* Тема одна, тёмная — второй meta с media больше не нужен. */}
  <meta name="theme-color" content="#0c0c0b" />

  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/icons/icon-192.png" sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="ant brigade" />
  {/* Страница тёмная во всю высоту, поэтому часы в статус-баре светлые. */}
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="masthead">
    <div class="masthead__in shell">
      <a class="brand" href="/">ANTBRIGADE</a>
      <nav class="nav">
        {nav.map((item) => (
          <a href={item.href} aria-current={activeSection === item.key ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main" class="shell">
    <slot />
  </main>

  <footer class="foot">
    <div class="foot__in shell">
      <span class="display display--lg">Information</span>
      <span class="foot__note mono mono--sm">
        Source — a Notion database<br />
        Updated {generatedAt ? generatedAt.slice(0, 10) : '—'} · © {year} Antbrigade
      </span>
    </div>
  </footer>

  <script>
    /* Шапка прячется при прокрутке вниз и возвращается при прокрутке вверх.

       Порог в 6 пикселей нужен, чтобы шапка не дёргалась от инерционной
       прокрутки и от подрагивания тачпада: без него любое колебание в один
       пиксель считалось бы сменой направления. */
    const head = document.querySelector('.masthead');
    const STEP = 6;
    let last = window.scrollY;

    addEventListener('scroll', () => {
      const y = window.scrollY;

      // У самого верха шапка видна всегда, иначе она остаётся спрятанной
      // после возврата к началу страницы.
      if (y <= head.offsetHeight) head.removeAttribute('data-hidden');
      else if (y > last + STEP) head.setAttribute('data-hidden', '');
      else if (y < last - STEP) head.removeAttribute('data-hidden');

      if (Math.abs(y - last) > STEP) last = y;
    }, { passive: true });
  </script>
</body>
</html>

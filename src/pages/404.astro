---
/* Страница для несуществующих адресов.
 *
 * Отдаётся хостингом на любой промах: Vercel и Cloudflare Pages оба берут
 * dist/404.html сами, настраивать для этого нечего. Раньше её не было, и
 * промах упирался в серую заглушку хостинга — без шапки, без меню, без
 * пути назад. При трёх тысячах адресов и недавнем переезде каталога с
 * /releases на /music это не редкий случай.
 *
 * Собрана как остальные внутренние страницы — с 7 сентября 2026: имя в
 * первой строке, справка строками под ним, дальше раздел с полосой. До
 * этого у неё была своя шапка (.page-head) и свой абзац прозой (.lost) —
 * два элемента, которых больше нигде на сайте нет.
 *
 * Ряда кнопок с разделами здесь нет намеренно: он повторял бы меню в
 * шапке. Выход из тупика — само меню и находки ниже.
 *
 * Случайные релизы — тот же «Lucky Finds», что на главной, и назван так
 * же: это одна и та же вещь, заводить ей второе имя незачем. Тупик
 * превращается во вход в каталог, а не в извинение.
 */

import Base from '../layouts/Base.astro';
import AlbumCard from '../components/AlbumCard.astro';
import Icon from '../components/Icon.astro';
import { albums } from '../lib/db.js';

/* Показываем столько же, сколько на главной: при пяти колонках десятка
   ложится двумя полными рядами, а шестёрка — рядом из пяти и одинокой
   плиткой под ним, что читается как недогрузившаяся страница.

   Пул втрое меньше, чем на главной (там 150): это страница-промах, её вес
   платят те, кто уже ошибся адресом. Пять подборок подряд без повторов —
   с запасом, дольше здесь никто не задержится. */
const POOL = 50;
// Ряд на расчётных 1920 — семь обложек, показываем два полных ряда.
const SHOW = 12;

/* Фишер — Йетс, как на главной. Не `sort(() => Math.random() - 0.5)`: та
   перестановка заметно смещённая, часть записей оседает у краёв. */
function shuffle(list) {
  const a = list.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/* Свежие не исключаем, в отличие от главной: там раздел Latest Releases
   стоит прямо над находками и повтор был бы виден, здесь его нет. */
const pool = shuffle(albums).slice(0, POOL);
---
<Base
  title="Page not found · ant brigade"
  description={`No page at this address. The collection is where it was: ${albums.length} releases, covers, genres, labels.`}
  noindex
>
  {/* Первая строка — как у исполнителя, лейбла и жанра: имя во всю ширину
      кадра, под ним справка строками. Код ответа и объяснение идут теми же
      строками с подписью через двоеточие, что страна и переходы наружу:
      других способов сказать служебное на сайте нет. */}
  <div class="lead">
    <h1 class="item__title">Page not found</h1>

    <dl class="item__facts">
      <div class="item__fact">
        <dt>Status:</dt>
        <dd>404</dd>
      </div>

      <div class="item__fact">
        <dt>Reason:</dt>
        <dd>The address was renamed, or the link lost a piece on the way here.</dd>
      </div>
    </dl>
  </div>

  {/* Полоса раздела — та же, что у находок на главной: кружок с именем
      слева, «Dig again» в последнем столбце. Линия сверху у неё своя: под
      ней стоит первая строка, а не решётка, и стыковать нечего. */}
  <section class="section">
    <div class="head head--sticky head--bare head--dot">
      <div class="head__lead">
        <h2 class="display display--md"><Icon name="circle" class="mark" />Lucky Finds</h2>
      </div>
      {/* Без скрипта кнопки не видно: подборку меняет он, а сервер отдаёт
          всем один и тот же HTML. */}
      <button type="button" class="dig-again" id="dig-again"><span class="btn-label">Dig again</span></button>
    </div>

    {/* Пул отдаётся целиком, но видны только первые SHOW: без скрипта
        страница показывает осмысленную выборку и не мигает подменой
        картинок сразу после загрузки. */}
    <ul class="tiles tiles--auto" id="dig" data-show={SHOW}>
      {pool.map((a, i) => <AlbumCard album={a} hidden={i >= SHOW} />)}
    </ul>

    {/* Тот же двойник кнопки, что на главной: на телефоне она стоит под
        подборкой и липнет к низу экрана, пока раздел на виду. */}
    <button type="button" class="dig-again dig-again--below" id="dig-again-below"><span class="btn-label">Dig again</span></button>
  </section>
</Base>

<script>
  /* Тот же механизм, что у находок на главной: пул лежит в разметке,
     браузер тасует его при загрузке и показывает первые data-show, а
     нажатие листает дальше — не тасует заново.

     Почему листает, а не тасует: при повторной жеребьёвке шести из
     полусотни время от времени одна и та же обложка оставалась бы на
     месте, и нажатие читалось бы как сбой, а не как обновление. */
  const dig   = document.getElementById('dig');
  const items = Array.from(dig.children);
  const show  = Number(dig.dataset.show) || 10;
  const agains = document.querySelectorAll('.dig-again');

  /* Неполной подборки в конце быть не должно: ряд, оборванный на середине,
     читается как недогрузившийся. Остаток пула ждёт следующей тасовки. */
  const pages = Math.max(1, Math.floor(items.length / show));

  let order = items;
  let page = 0;

  function shuffle() {
    order = items.slice();
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }

    // Переставляем и в разметке, иначе выбранные шли бы вразнобой по сетке.
    const frag = document.createDocumentFragment();
    for (const el of order) frag.appendChild(el);
    dig.appendChild(frag);
  }

  function render() {
    const start = page * show;
    for (const [i, el] of order.entries()) el.hidden = i < start || i >= start + show;

    /* Следующая подборка подгружается заранее: у скрытых плиток картинки
       ленивые и к нажатию не скачаны — без этого на их месте секунду
       держалась бы пустая штриховка. */
    for (const el of order.slice(start + show, start + show * 2)) {
      for (const img of el.querySelectorAll('img[loading="lazy"]')) img.loading = 'eager';
    }
  }

  shuffle();
  render();

  /* Обе кнопки — в полосе и под сеткой — делают одно и то же. */
  for (const again of agains) {
    again.addEventListener('click', () => {
      page += 1;
      // Пул кончился — тасуем заново, и следующий круг идёт в другом порядке.
      if (page >= pages) {
        shuffle();
        page = 0;
      }
      render();
    });
  }
</script>

---
import Base from '../../layouts/Base.astro';
import GenreChips from '../../components/GenreChips.astro';
import ListenLinks from '../../components/ListenLinks.astro';
import {
  albums, artistsOf, labelsOf, coverSrc, formatDate
} from '../../lib/db.js';

export function getStaticPaths() {
  return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}

const { album } = Astro.props;
const artists = artistsOf(album.artistIds);
const labels  = labelsOf(album.labelIds);
const title   = `${album.artist} — ${album.album}`;
const cover   = coverSrc(album, 800);
---
<Base
  title={`${title} · ant brigade`}
  description={`${title}${album.year ? `, ${album.year}` : ''}. ${album.genres.join(', ')}.`}
  activeSection="albums"
>
  <article class="detail">
    {/* Та же полоса, что ведёт главную: обложка целиком на размытой копии
        себя самой, заголовок рядом. Страница релиза и главная так читаются
        как одно место, а не как две разные вёрстки. */}
    <div class="detail__banner bleed">
      {cover && <img class="hero__backdrop" src={cover} alt="" aria-hidden="true" decoding="async" />}
      {cover && (
        <img class="detail__art" src={cover} width="800" height="800"
             alt={`${album.album} cover`} fetchpriority="high" />
      )}
      <div class="detail__head">
        <p class="detail__kicker">
          {[album.types.join(' / '), album.year].filter(Boolean).join(' · ')}
        </p>
        <h1 class="detail__title">{album.album}</h1>
        <p class="detail__artist">
          {artists.length > 0
            ? artists.map((a, i) => (
                <>
                  {i > 0 && <span class="sep"> / </span>}
                  <a href={`/artists/${a.slug}`}>{a.name}</a>
                </>
              ))
            : album.artist}
        </p>
      </div>
    </div>

    <div class="detail__body">
      <div>
        <ListenLinks album={album} />
      </div>

      <dl class="facts facts--wide">
        {album.released && (
          <>
            <dt>Release date</dt>
            <dd>{formatDate(album.released)}</dd>
          </>
        )}

        {labels.length > 0 && (
          <>
            <dt>{labels.length > 1 ? 'Labels' : 'Label'}</dt>
            <dd>
              {labels.map((l, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/labels/${l.slug}`}>{l.name}</a>
                </>
              ))}
            </dd>
          </>
        )}

        {album.genres.length > 0 && (
          <>
            <dt>Genres</dt>
            <dd><GenreChips names={album.genres} /></dd>
          </>
        )}
      </dl>
    </div>
  </article>
</Base>

---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import VideoCard from '../../components/VideoCard.astro';
import GenreLinks from '../../components/GenreLinks.astro';
/* Breadcrumbs со страницы релиза убран 5 сентября 2026: первый экран занят
   обложкой во весь рост, и строка пути над ней читалась подписью к
   картинке. Компонент остаётся в проекте — он стоит на страницах клипа,
   артиста, лейбла и жанра. */
import BackBar from '../../components/BackBar.astro';
import PageBar from '../../components/PageBar.astro';
import ListenLinks from '../../components/ListenLinks.astro';
import {
  albums, albumsOf, artistsOf, labelsOf, videosOf, coverSrc, formatDate, artistLine
} from '../../lib/db.js';

export function getStaticPaths() {
  return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}

const { album } = Astro.props;
const artists = artistsOf(album.artistIds);
const labels  = labelsOf(album.labelIds);
/* artistLine, а не album.artist: в сырой строке из Notion соавторы разделены
   косой чертой, и она попадала в заголовок вкладки и в описание страницы. */
const title   = `${artistLine(album)} — ${album.album}`;
const cover   = coverSrc(album, 800);

/* Поправка на длинное название — `longTitle`, кегль помельче начиная с 60
   знаков — удалена 5 сентября 2026 вместе с полосой: она стояла ради
   overflow: hidden у неё, где пятая строка заголовка обрезала кнопки
   площадок. В ячейке решётки высота от содержимого, и длинное название
   просто переносится. */
const dateText = formatDate(album.released);

/* Переходы наружу в полосах разделов: дискография — на Bandcamp
   исполнителя, клипы — на его канал YouTube. У релиза своих таких ссылок
   нет: album.link и площадки ведут на сам альбом и стоят кнопками выше.

   Берём первую заполненную: у совместного релиза двое исполнителей, и
   вести куда-то надо одному. Поля заполняются вручную и чаще пусты —
   тогда на месте кнопки стоит временная пометка. */
const bandcamp = artists.find((a) => a.bandcamp)?.bandcamp ?? null;
const youtube  = artists.find((a) => a.youtube)?.youtube ?? null;

/* Год оригинала есть только у переизданий и допечаток. Показываем его здесь
   и больше нигде: порядок, отбор по годам и подпись на плитке держит дата
   издания, иначе плитка говорила бы один год, а отбор находил бы другой.

   Год, а не полная дата: 5 сентября 2026 колонка в Notion стала списком
   годов. Форматировать его нечем и незачем — берём как есть. */
const origText = album.origYear;

/* Другие релизы тех же исполнителей — то же, что «More Videos» на странице
   клипа. Через Map, а не через фильтр: у релиза бывает двое исполнителей,
   и совместная работа иначе попала бы в список дважды.

   Порядок — от свежих к старым, как везде на сайте по умолчанию. Брать
   его из albumIds нельзя: там он идёт из Notion и ничего не значит. */
const more = [...new Map(
  artists
    .flatMap((a) => albumsOf(a.albumIds))
    .filter((a) => a.id !== album.id)
    .map((a) => [a.id, a])
).values()].sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));

/* Клипы тех же исполнителей — тем же приёмом и в том же порядке, что релизы
   выше: через Map от повторов у совместных работ, от свежих к старым. Дата
   у клипов появилась 29 августа 2026, до неё сортировать было не по чему. */
const clips = [...new Map(
  artists.flatMap((a) => videosOf(a.videoIds)).map((v) => [v.id, v])
).values()].sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));
---
<Base
  title={`${title} · ant brigade`}
  description={`${title}${album.year ? `, ${album.year}` : ''}. ${album.genres.join(', ')}.`}
  image={coverSrc(album, 800)}
  activeSection="albums"
>
  <BackBar />

  {/* Релиз стоит на той же решётке, что каталог: обложка занимает два
      первых столбца, а справа от неё ячейка с именем и справкой во всю
      оставшуюся ширину. Первый экран отдан им двоим целиком — блок высотой
      в окно за вычетом шапки.

      Приём с обложкой взят с главной целиком: поле 16 вокруг, штриховка
      под ней на случай, если файла нет, перемычки чертят сами ячейки
      левой и нижней границей. Так обложка релиза встаёт на те же
      вертикали, что обложки в «More Releases» ниже, и страница читается
      продолжением каталога, а не отдельным разворотом.

      Полоса 16:7 с обложкой в два столбца и текстом рядом стояла здесь до
      5 сентября 2026. Сетки в ней не было вовсе: ширину обложке задавала
      своя переменная --two-cols, а высоту — содержимое, и с решёткой под
      ней полоса не сходилась ни одной линией. */}
  <article class="album">
    <div class="album__art">
      <div class="album__cover">
        {cover && (
          <img src={cover} width="800" height="800"
               alt={`${album.album} cover`} fetchpriority="high" />
        )}
      </div>
    </div>
    {/* Три опоры и воздух между ними: имя с названием к верху ячейки,
        справка посередине, кнопки площадок к низу. Так низ ячейки с текстом
        приходится на низ обложки, а не обрывается посреди неё.

        Порядок сверху вниз тот же, что у плитки на витрине: имя, потом
        название. У полосы он был обратный — тип, название, имя, — потому
        что надстрочной строкой там стоял вид издания; теперь вид ушёл в
        справку, к остальным выходным данным, и первой строкой встало имя. */}
    <div class="album__head">
      <div class="album__name">
        <p class="album__artist">
          {artists.length > 0
            ? artists.map((a, i) => (
                <>
                  {i > 0 && <span class="sep"> · </span>}
                  <a href={`/artists/${a.slug}`}>{a.name}</a>
                </>
              ))
            : album.artist}
        </p>

        <h1 class="album__title">{album.album}</h1>
      </div>

      {/* Справка строками, как трек-лист у Warp: подпись слева, значение
          справа, между строками мягкая черта. Это те же строки, что в
          списках артистов и жанров, — подпись моноширинным с двоеточием,
          как имена отборов в полосе, — и читаются они одинаково на всём
          сайте.

          Трек-листа у нас нет: в Notion лежат сведения об издании, а не о
          записи. Строки заняты тем, что есть, — вид, дата, лейбл, жанры. */}
      <dl class="album__facts">
        {album.types.length > 0 && (
          <div class="album__fact">
            <dt>Type:</dt>
            <dd>{album.types.join(' · ')}</dd>
          </div>
        )}

        {dateText && (
          <div class="album__fact">
            <dt>Released:</dt>
            {/* Дата оригинала — уточнением в той же строке, а не отдельной:
                это одна и та же справка о выпуске, и вторая строка «Released»
                читалась бы вторым релизом. */}
            <dd>
              {dateText}
              {origText && <span class="album__faint"> · originally {origText}</span>}
            </dd>
          </div>
        )}

        {labels.length > 0 && (
          <div class="album__fact">
            <dt>Label:</dt>
            <dd>
              {labels.map((l, i) => (
                <>
                  {i > 0 && <span class="sep"> · </span>}
                  <a href={`/labels/${l.slug}`}>{l.name}</a>
                </>
              ))}
            </dd>
          </div>
        )}

        {album.genres.length > 0 && (
          <div class="album__fact">
            <dt>Genres:</dt>
            <dd><GenreLinks names={album.genres} inline /></dd>
          </div>
        )}
      </dl>

      <ListenLinks album={album} />
    </div>
  </article>

  {more.length > 0 && (
    <section class="section">
      {/* Просто «Releases»: «More» стояло здесь, пока раздел был единственным
          продолжением страницы. Теперь в правой половине полосы стоит переход
          «More on Bandcamp», и слово «ещё» звучало бы дважды за одну строку.

          Без имени исполнителя: оно уже стоит на обложке над разделом — в
          заголовке шло бы вторым разом за один экран. */}
      <PageBar as="h2" title="Releases" count={more.length}>
        {bandcamp
          ? <a class="view-all" href={bandcamp} target="_blank" rel="noopener noreferrer">More on Bandcamp</a>
          : <span class="view-all view-all--empty">[bandcamp link temporary empty]</span>}
      </PageBar>
      {/* Имя показываем только у совместных релизов. У сольного все плитки
          принадлежат тому же исполнителю, что и страница, и подпись была бы
          повтором — как в дискографии на его странице. А вот у дуэта сюда
          попадают и сольные работы каждого, и без имени сольник читался бы
          как ещё одна работа дуэта. */}
      <ul class="tiles tiles--auto">
        {more.map((a) => <AlbumCard album={a} showArtist={artists.length > 1} />)}
      </ul>
    </section>
  )}

  {clips.length > 0 && (
    <section class="section">
      {/* Назван так же, как раздел на странице исполнителя: это тот же
          список, только собранный от релиза. */}
      <PageBar as="h2" title="Videos" count={clips.length}>
        {youtube
          ? <a class="view-all" href={youtube} target="_blank" rel="noopener noreferrer">More on YouTube</a>
          : <span class="view-all view-all--empty">[youtube link temporary empty]</span>}
      </PageBar>
      {/* По столбцам решётки, как список клипов плитками на /videos: четыре
          в ряд на расчётной ширине. Своя раскладка .tiles--video набирала
          столбцы от минимальной ширины плитки и давала их шесть — кадры
          выходили мельче, чем на самой странице клипов. */}
      <ul class="tiles tiles--auto">
        {clips.map((v) => <VideoCard video={v} />)}
      </ul>
    </section>
  )}
</Base>

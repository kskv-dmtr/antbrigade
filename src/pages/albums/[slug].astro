---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import VideoCard from '../../components/VideoCard.astro';
import GenreLinks from '../../components/GenreLinks.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ListenLinks from '../../components/ListenLinks.astro';
import {
  albums, albumsOf, artistsOf, labelsOf, videosOf, coverSrc, formatDate, artistLine
} from '../../lib/db.js';

export function getStaticPaths() {
  return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}

const { album } = Astro.props;
const artists = artistsOf(album.artistIds);
const labels  = labelsOf(album.labelIds);
/* artistLine, а не album.artist: в сырой строке из Notion соавторы разделены
   косой чертой, и она попадала в заголовок вкладки и в описание страницы. */
const title   = `${artistLine(album)} — ${album.album}`;
const cover   = coverSrc(album, 800);

/* Длинному названию — кегль помельче. В правой колонке полосы у заголовка
   бюджет в четыре строки: дальше блок с площадками выходит за полосу, а у
   неё overflow: hidden, и кнопки просто обрезало бы.

   Порог в 60 знаков берёт три релиза из 1102, и самый длинный из них — 83
   знака — при обычном кегле занимал пять строк. Тот же приём и та же
   причина, что у заголовка на странице клипа. */
const longTitle = album.album.length > 60;

/* Дата и лейбл стоят одной строкой внизу полосы, поэтому дата нужна ещё и
   отдельно: по ней решается, ставить ли перед первым лейблом разделитель. */
const dateText = formatDate(album.released);

/* Дата оригинала есть только у переизданий и допечаток. Показываем её здесь
   и больше нигде: порядок, отбор по годам и подпись на плитке держит дата
   издания, иначе плитка говорила бы один год, а отбор находил бы другой. */
const origText = formatDate(album.origReleased);

/* Другие релизы тех же исполнителей — то же, что «More Videos» на странице
   клипа. Через Map, а не через фильтр: у релиза бывает двое исполнителей,
   и совместная работа иначе попала бы в список дважды.

   Порядок — от свежих к старым, как везде на сайте по умолчанию. Брать
   его из albumIds нельзя: там он идёт из Notion и ничего не значит. */
const more = [...new Map(
  artists
    .flatMap((a) => albumsOf(a.albumIds))
    .filter((a) => a.id !== album.id)
    .map((a) => [a.id, a])
).values()].sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));

/* Клипы тех же исполнителей — тем же приёмом и в том же порядке, что релизы
   выше: через Map от повторов у совместных работ, от свежих к старым. Дата
   у клипов появилась 29 августа 2026, до неё сортировать было не по чему. */
const clips = [...new Map(
  artists.flatMap((a) => videosOf(a.videoIds)).map((v) => [v.id, v])
).values()].sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));
---
<Base
  title={`${title} · ant brigade`}
  description={`${title}${album.year ? `, ${album.year}` : ''}. ${album.genres.join(', ')}.`}
  image={coverSrc(album, 800)}
  activeSection="albums"
>
  <Breadcrumbs
    trail={artists.map((a) => ({ href: `/artists/${a.slug}`, label: a.name }))}
    name={album.album}
  />

  <article class="detail">
    {/* Обложка целиком слева, заголовок рядом.

        Без `bleed`: с ним полоса вылезала на ширину полей за текстовую
        колонку, и обложка начиналась левее всего остального на странице. */}
    <div class="detail__banner">
      {cover && (
        <img class="detail__art" src={cover} width="800" height="800"
             alt={`${album.album} cover`} fetchpriority="high" />
      )}
      {/* Две опоры и воздух между ними: имя прижато к верху полосы,
          служебное — к низу, и обе колонки заканчиваются на одной линии.
          Раньше весь блок жался к низу, а лейбл с жанрами и кнопками стояли
          отдельным этажом под полосой. */}
      <div class="detail__head">
        {/* Сверху вниз: тип, название, исполнитель. Тот же порядок, что на
            странице клипа: там надстрочной строкой стоит вид ролика, а имя
            уходит под заголовок. Дата ушла вниз, к лейблу: обе — справка о
            выпуске, и стоять им вместе.

            Под именем, за линейкой, — жанры. Они ближе к названию, чем к
            выходным данным: жанр отвечает на «что это за музыка», а дата с
            лейблом — на «когда и у кого вышло». */}
        <div class="detail__name">
          <p class="detail__kicker">{album.types.join(' · ')}</p>

          <h1 class:list={['detail__title', longTitle && 'detail__title--long']}>
            {album.album}
          </h1>

          <p class="detail__artist">
            {artists.length > 0
              ? artists.map((a, i) => (
                  <>
                    {i > 0 && <span class="sep"> · </span>}
                    <a href={`/artists/${a.slug}`}>{a.name}</a>
                  </>
                ))
              : album.artist}
          </p>

          {/* Линейка та же, что перед кнопками площадок, и просветы у неё
              такие же: 20 сверху, 20 снизу. Сверху их складывают gap блока
              и поле — сам gap здесь 10, он держит три верхние строки
              плотнее. */}
          {album.genres.length > 0 && (
            <div class="detail__genres">
              <GenreLinks names={album.genres} />
            </div>
          )}
        </div>

        <div class="detail__meta">
          {/* Кнопки площадок сверху, дата с лейблом под линейкой. Подписей
              «Label» и «Genres» больше нет: колонка в 130 пикселей
              под них съедала треть ширины, а угадать по строке, что
              «Sacred Bones» — лейбл, а «Post-Punk» — жанр, можно и без них.
              Поэтому и не список определений: терминов в нём не осталось. */}
          <ListenLinks album={album} />

          <div class="detail__dates">
          {(dateText || labels.length > 0) && (
            <p class="detail__fact">
              {dateText}
              {/* Точка, а не запятая, между лейблами: в дате слева уже есть
                  запятая («August 21, 2026»), и вторая в той же строке
                  встала бы с ней на равных. */}
              {labels.map((l, i) => (
                <>
                  {(i > 0 || dateText) && <span class="sep"> · </span>}
                  <a href={`/labels/${l.slug}`}>{l.name}</a>
                </>
              ))}
            </p>
          )}

          {origText && (
            <p class="detail__fact detail__fact--faint">Originally released {origText}</p>
          )}
          </div>
        </div>
      </div>
    </div>
  </article>

  {more.length > 0 && (
    <section class="section">
      <div class="head">
        {/* Без имени исполнителя: оно уже стоит в полосе над разделом и в
            пути наверху — в заголовке шло бы третьим разом за один экран.
            Так же названо и на странице клипа. */}
        <h2 class="display display--md">More Releases</h2>
        <span class="mono">[{more.length}]</span>
      </div>
      {/* Имя показываем только у совместных релизов. У сольного все плитки
          принадлежат тому же исполнителю, что и страница, и подпись была бы
          повтором — как в дискографии на его странице. А вот у дуэта сюда
          попадают и сольные работы каждого, и без имени сольник читался бы
          как ещё одна работа дуэта. */}
      <ul class="tiles tiles--auto">
        {more.map((a) => <AlbumCard album={a} showArtist={artists.length > 1} />)}
      </ul>
    </section>
  )}

  {clips.length > 0 && (
    <section class="section">
      <div class="head">
        {/* Назван так же, как раздел на странице исполнителя: это тот же
            список, только собранный от релиза. */}
        <h2 class="display display--md">Videos</h2>
        <span class="mono">[{clips.length}]</span>
      </div>
      <ul class="tiles tiles--auto tiles--video">
        {clips.map((v) => <VideoCard video={v} />)}
      </ul>
    </section>
  )}
</Base>

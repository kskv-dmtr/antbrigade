---
import Base from '../../layouts/Base.astro';
import GenreChips from '../../components/GenreChips.astro';
import ListenLinks from '../../components/ListenLinks.astro';
import {
  albums, artistsOf, labelsOf, coverSrc, formatDate, flag
} from '../../lib/db.js';

export function getStaticPaths() {
  return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}

const { album } = Astro.props;
const artists = artistsOf(album.artistIds);
const labels  = labelsOf(album.labelIds);
const title   = `${album.artist} — ${album.album}`;
---
<Base
  title={`${title} · music`}
  description={`${title}${album.year ? `, ${album.year}` : ''}. ${album.genres.join(', ')}.`}
  activeSection="albums"
>
  <article class="detail">
    <div class="detail__art">
      {album.cover && (
        <img
          src={coverSrc(album, 800)}
          width="800" height="800"
          alt={`Обложка альбома ${album.album}`}
        />
      )}
    </div>

    <div class="detail__body">
      <p class="detail__kicker">
        {album.types.join(' · ')}
      </p>

      <h1 class="detail__title">{album.album}</h1>

      <p class="detail__artist">
        {artists.length > 0
          ? artists.map((a, i) => (
              <>
                {i > 0 && <span class="sep"> / </span>}
                <a href={`/artists/${a.slug}/`}>{a.name}</a>
              </>
            ))
          : album.artist}
      </p>

      <ListenLinks album={album} />

      <dl class="facts">
        {album.released && (
          <>
            <dt>Дата релиза</dt>
            <dd>{formatDate(album.released)}</dd>
          </>
        )}

        {labels.length > 0 && (
          <>
            <dt>{labels.length > 1 ? 'Лейблы' : 'Лейбл'}</dt>
            <dd>
              {labels.map((l, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/labels/${l.slug}/`}>{l.name}</a>
                  {l.country && <span class="flag" title={l.country}> {flag(l.country)}</span>}
                </>
              ))}
            </dd>
          </>
        )}

        {album.genres.length > 0 && (
          <>
            <dt>Жанры</dt>
            <dd>
              <GenreChips names={album.genres} />
            </dd>
          </>
        )}
      </dl>
    </div>
  </article>
</Base>

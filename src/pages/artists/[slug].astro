---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import VideoCard from '../../components/VideoCard.astro';
import ProfileLinks from '../../components/ProfileLinks.astro';
import GenreLinks from '../../components/GenreLinks.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { artists, albumsOf, labelsOf, videosOf, countryName, plural, coverSrc } from '../../lib/db.js';

export function getStaticPaths() {
  return artists.map((artist) => ({ params: { slug: artist.slug }, props: { artist } }));
}

const { artist } = Astro.props;
const discography = albumsOf(artist.albumIds);
const labels = labelsOf(artist.labelIds);
const clips  = videosOf(artist.videoIds);

/* От свежих к старым, как дискография выше и как везде на сайте по
   умолчанию. Прежде официальные клипы шли вперёд, живые записи следом, а
   внутри по названию — так сложилось, когда даты у клипов не было. Дата
   появилась 29 августа 2026, и все три раздела «Videos» сортируются теперь
   одинаково.

   Вид ролика при этом никуда не делся: он стоит подписью на каждой плитке и
   отдельным отбором на /videos. */
const clipsSorted = clips.slice()
  .sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));

/* Раздел ссылок наружу показываем, только когда есть что показать: поля в
   Notion заполняются руками, и у большинства записей они пустые. */
const hasLinks = Boolean(artist.website || artist.bandcamp || artist.youtube);
---
<Base
  title={`${artist.name} · ant brigade`}
  description={`${artist.name}: ${plural(discography.length, 'release', 'releases')} in the collection${
    artist.genres.length ? `, ${artist.genres.slice(0, 4).join(', ')}` : ''
  }.`}
  {/* В карточке ссылки — обложка самого свежего релиза: своей картинки у
      артиста нет, а плитка в сетке берёт ту же. */}
  image={coverSrc(discography.find((a) => a.cover), 800)}
  activeSection="artists"
>
  <Breadcrumbs name={artist.name} place />

  {/* Счёт релизов только в заголовке раздела ниже — здесь он дублировался.

      Страна стоит справа от имени, по нижней его линии, и набрана тем же,
      чем счётчики на списках: скобки на сайте означают служебное число или
      пометку, и страна здесь именно пометка. Выключку даёт сам .page-head —
      он для того и собран, на списках так же стоит счётчик. */}
  <div class="page-head page-head--country">
    <h1>{artist.name}</h1>
    {artist.country && <p class="counter">[{countryName(artist.country)}]</p>}
  </div>

  {/* Ссылки наружу — своим разделом, наравне с дискографией и клипами, а не
      строкой в справке. Заголовок и линейка под ним те же, что у соседей;
      кнопки под линейкой, слева.

      Счётчика в заголовке нет намеренно: у соседей он говорит, сколько
      плиток под ним, а тут кнопок одна или две и они целиком на виду —
      число пересказывало бы картинку. Так же собран заголовок на странице
      жанра. */}
  {hasLinks && (
    <section class="section">
      <div class="head">
        <h2 class="display display--md">Links</h2>
      </div>
      <ProfileLinks website={artist.website} bandcamp={artist.bandcamp} youtube={artist.youtube} />
    </section>
  )}

  {/* Жанры — своим разделом, как лейблы. Стоят перед ними: на полосе
      релиза жанры тоже идут выше строки с лейблом.

      Заголовок склоняется по числу, счётчик справа всегда — как у соседей. */}
  {artist.genres.length > 0 && (
    <section class="section">
      <div class="head">
        <h2 class="display display--md">{artist.genres.length > 1 ? 'Genres' : 'Genre'}</h2>
        <span class="mono">[{artist.genres.length}]</span>
      </div>
      <p class="meta-line">
        <GenreLinks names={artist.genres} inline />
      </p>
    </section>
  )}

  {/* Лейблы — своим разделом, как ссылки наружу. Заголовок склоняется по
      числу, а счётчик стоит справа всегда — как у соседних разделов.

      Имена набраны и разделены точкой так же, как состав на странице лейбла
      и жанры в шапке: ссылка на страницу списка везде выглядит одинаково. */}
  {labels.length > 0 && (
    <section class="section">
      <div class="head">
        <h2 class="display display--md">{labels.length > 1 ? 'Labels' : 'Label'}</h2>
        <span class="mono">[{labels.length}]</span>
      </div>
      <p class="meta-line">
        {labels.map((l, i) => (
          <>
            {i > 0 && <span class="sep"> · </span>}
            <a href={`/labels/${l.slug}`}>{l.name}</a>
          </>
        ))}
      </p>
    </section>
  )}

  {/* Сначала релизы, клипы под ними: страница артиста — прежде всего его
      дискография, а клипы есть у полутора десятков из девятисот. */}
  <section class="section">
    <div class="head">
      <h2 class="display display--md">Discography</h2>
      {/* Пустой счётчик вместо «[0]»: раздел и так объясняет, что релизов нет. */}
      {discography.length > 0 && <span class="mono">[{discography.length}]</span>}
    </div>
    {discography.length > 0 ? (
      <ul class="tiles tiles--auto">
        {discography.map((a) => <AlbumCard album={a} showArtist={false} />)}
      </ul>
    ) : (
      <p class="empty">No releases by this artist yet.</p>
    )}
  </section>

  {clipsSorted.length > 0 && (
    <section class="section">
      <div class="head">
        <h2 class="display display--md">Videos</h2>
        <span class="mono">[{clipsSorted.length}]</span>
      </div>
      <ul class="tiles tiles--auto tiles--video">
        {clipsSorted.map((v) => <VideoCard video={v} />)}
      </ul>
    </section>
  )}
</Base>

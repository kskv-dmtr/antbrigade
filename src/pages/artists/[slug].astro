---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import VideoCard from '../../components/VideoCard.astro';
import ProfileLinks from '../../components/ProfileLinks.astro';
import GenreLinks from '../../components/GenreLinks.astro';
/* Полоса «назад» и строка пути удалены из проекта 6 сентября 2026 вместе с
   компонентами BackBar и Breadcrumbs. Путь дублировал то, что и так стоит на
   странице, а кнопка «назад» повторяла кнопку браузера — и занимала целую
   полосу поперёк первого экрана. Достать их можно из истории. */
import PageBar from '../../components/PageBar.astro';
import { artists, albumsOf, labelsOf, videosOf, countryName, plural, coverSrc } from '../../lib/db.js';

export function getStaticPaths() {
  return artists.map((artist) => ({ params: { slug: artist.slug }, props: { artist } }));
}

const { artist } = Astro.props;
const releases = albumsOf(artist.albumIds);
const labels = labelsOf(artist.labelIds);
const clips  = videosOf(artist.videoIds);

/* От свежих к старым, как дискография выше и как везде на сайте по
   умолчанию. Прежде официальные клипы шли вперёд, живые записи следом, а
   внутри по названию — так сложилось, когда даты у клипов не было. Дата
   появилась 29 августа 2026, и все три раздела «Videos» сортируются теперь
   одинаково.

   Вид ролика при этом никуда не делся: он стоит подписью на каждой плитке и
   отдельным отбором на /videos. */
const clipsSorted = clips.slice()
  .sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));

/* Раздел ссылок наружу показываем, только когда есть что показать: поля в
   Notion заполняются руками, и у большинства записей они пустые. */
const hasLinks = Boolean(artist.bandcamp || artist.youtube);
---
<Base
  title={`${artist.name} · ant brigade`}
  description={`${artist.name}: ${plural(releases.length, 'release', 'releases')} in the collection${
    artist.genres.length ? `, ${artist.genres.slice(0, 4).join(', ')}` : ''
  }.`}
  {/* В карточке ссылки — обложка самого свежего релиза: своей картинки у
      артиста нет, а плитка в сетке берёт ту же. */}
  image={coverSrc(releases.find((a) => a.cover), 800)}
  activeSection="artists"
>
  {/* Первый блок — тот же, что на страницах релиза и клипа: слева половина
      решётки, справа половина. Слева только имя, справа справка строками —
      страна, жанры, лейблы, переходы наружу.

      Счёт релизов сюда не идёт: он стоит в полосе раздела ниже. */}
  <article class="item item--page">
    <div class="item__lead">
      <h1 class="item__title">{artist.name}</h1>
    </div>

    <div class="item__head">
      <dl class="item__facts">
        {artist.country && (
          <div class="item__fact">
            <dt>Country:</dt>
            <dd>{countryName(artist.country)}</dd>
          </div>
        )}

        {/* Жанры перед лейблами: в справке релиза они идут в том же
            порядке. */}
        {artist.genres.length > 0 && (
          <div class="item__fact">
            <dt>{artist.genres.length > 1 ? 'Genres:' : 'Genre:'}</dt>
            <dd><GenreLinks names={artist.genres} inline /></dd>
          </div>
        )}

        {labels.length > 0 && (
          <div class="item__fact">
            <dt>{labels.length > 1 ? 'Labels:' : 'Label:'}</dt>
            <dd>
              {labels.map((l, i) => (
                <>
                  {i > 0 && <span class="sep"> · </span>}
                  <a href={`/labels/${l.slug}`}>{l.name}</a>
                </>
              ))}
            </dd>
          </div>
        )}

        {/* Переходы наружу — последней строкой: сперва про самого
            исполнителя, потом куда пойти дальше. Тот же счёт, что на
            странице релиза, где кнопки площадок стоят под справкой. */}
        {hasLinks && (
          <div class="item__fact">
            <dt>Links:</dt>
            <dd><ProfileLinks bandcamp={artist.bandcamp} youtube={artist.youtube} /></dd>
          </div>
        )}
      </dl>
    </div>
  </article>

  {/* Сначала релизы, клипы под ними: страница артиста — прежде всего его
      дискография, а клипы есть у полутора десятков из девятисот. */}
  <section class="section">
    {/* Счётчика нет вовсе, когда релизов нет: «[0]» ничего не сообщает,
        кроме того, что и так видно по пустому месту под полосой.

        Сообщения «релизов пока нет» тоже нет: пустое место под полосой
        говорит то же самое и не занимает экран строкой служебного текста.
        Такие сообщения убраны по всему сайту 6 сентября 2026. */}
    <PageBar as="h2" title="Releases"
             count={releases.length > 0 ? releases.length : null} />
    {releases.length > 0 && (
      <ul class="tiles tiles--auto">
        {releases.map((a) => <AlbumCard album={a} showArtist={false} />)}
      </ul>
    )}
  </section>

  {clipsSorted.length > 0 && (
    <section class="section">
      <PageBar as="h2" title="Videos" count={clipsSorted.length} />
      <ul class="tiles tiles--auto">
        {clipsSorted.map((v) => <VideoCard video={v} />)}
      </ul>
    </section>
  )}
</Base>

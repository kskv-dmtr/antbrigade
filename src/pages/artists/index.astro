---
import Base from '../../layouts/Base.astro';
import NameTile from '../../components/NameTile.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import { artists, albumsOf, plural } from '../../lib/db.js';

// Группировка по первой букве, чтобы 931 имя можно было просматривать глазами.
function bucket(name) {
  const ch = name.trim()[0]?.toUpperCase() ?? '#';
  return /[A-Z]/.test(ch) ? ch : '#';
}

const groups = new Map();
for (const a of artists) {
  const key = bucket(a.name);
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key).push(a);
}
// «#» — цифры и символы — в конец списка
const ordered = [...groups.entries()].sort(([a], [b]) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});
---
<Base
  title="Artists · ant brigade"
  description={`${artists.length} artists in the collection.`}
  activeSection="artists"
>
  <div class="page-head">
    <h1>Artists</h1>
    <p class="counter" id="counter" aria-live="polite">
      {plural(artists.length, 'artist', 'artists')}
    </p>
  </div>

  <div class="controls">
    <div class="search">
      <input type="search" id="search" placeholder="Artist name" autocomplete="off"
             spellcheck="false" aria-label="Search by artist name" />
    </div>
    <div class="filters">
      <div class="filters__group">
        <ViewSwitch />
      </div>
    </div>
    <nav class="alphabet">
      {ordered.map(([letter]) => <a href={`#letter-${letter === '#' ? 'other' : letter}`}>{letter}</a>)}
    </nav>
  </div>

  <p class="empty" id="empty" hidden>Nothing found.</p>

  <div id="list" data-view="index">
    {ordered.map(([letter, items]) => (
      <section class="letter" data-letter={letter} id={`letter-${letter === '#' ? 'other' : letter}`}>
        <h2 class="letter__head">
          {letter}
          <span class="mono mono--sm">{items.length}</span>
        </h2>
        <ul class="names">
          {items.map((a) => (
            <li data-search={a.name.toLowerCase()}>
              <a class="names__link view-row" href={`/artists/${a.slug}`}>
                <span class="names__name">{a.name}</span>
                <span class="names__country">{a.country ?? ''}</span>
                <span class="names__count">{a.albumIds.length || ''}</span>
              </a>
              <NameTile
                class="view-tile"
                href={`/artists/${a.slug}`}
                name={a.name}
                country={a.country}
                releases={albumsOf(a.albumIds)}
              />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<script>
  const search   = document.getElementById('search');
  const empty    = document.getElementById('empty');
  const counter  = document.getElementById('counter');
  const list     = document.getElementById('list');
  const viewsEl  = document.getElementById('views');
  const sections = Array.from(document.querySelectorAll('.letter'));
  const items    = Array.from(document.querySelectorAll('.names li'));
  const total    = items.length;

  viewsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    list.dataset.view = btn.dataset.view;
    for (const b of viewsEl.children) b.setAttribute('aria-pressed', String(b === btn));
  });

  const plural = (n) => `${n} ${n === 1 ? 'artist' : 'artists'}`;

  let timer;
  search.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      for (const li of items) {
        const ok = !q || li.dataset.search.includes(q);
        li.hidden = !ok;
        if (ok) shown++;
      }
      // прячем буквы, внутри которых ничего не осталось
      for (const s of sections) {
        s.hidden = !s.querySelector('.names li:not([hidden])');
      }
      empty.hidden = shown > 0;
      counter.textContent = shown === total ? plural(total) : shown + ' of ' + total;
    }, 120);
  });
</script>

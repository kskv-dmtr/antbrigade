---
import Base from '../../layouts/Base.astro';
import Select from '../../components/Select.astro';
import PageBar from '../../components/PageBar.astro';
import FilterBar from '../../components/FilterBar.astro';
import FilterCell from '../../components/FilterCell.astro';
import MultiSelect from '../../components/MultiSelect.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import BriefCard from '../../components/BriefCard.astro';
import { artists, plural } from '../../lib/db.js';

// Группировка по первой букве, чтобы 935 имён можно было просматривать глазами.
function bucket(name) {
  const ch = name.trim()[0]?.toUpperCase() ?? '#';
  return /[A-Z]/.test(ch) ? ch : '#';
}

const groups = new Map();
for (const a of artists) {
  const key = bucket(a.name);
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key).push(a);
}
// «#» — цифры и символы — в конец списка
const ordered = [...groups.entries()].sort(([a], [b]) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});

/* Всего строк в списке: по нему сервер решает, показывать ли «показать
   ещё» и с каким числом. */
const всего = ordered.reduce((n, [, items]) => n + items.length, 0);

/* Сколько записей показывать сразу и сколько добавлять по нажатию — как на
   Music. Сорок восемь, а не пятьдесят: с 11 сентября 2026 у указателей есть
   плиточный вид, и 48 делится и на четыре столбца, и на три, и на два, а 50
   оставляло последний ряд первого разворота наполовину пустым. */
const PAGE = 48;

/* Сколько строк уже вывели: список сгруппирован по буквам, и сквозного
   номера у записи внутри группы нет. Считаем сами — по нему сервер метит
   всё, что за первым разворотом. */
let выведено = 0;

---
<Base
  title="Artists · ant brigade"
  description={`${artists.length} artists in the collection.`}
  activeSection="explore"
>
  {/* Счётчика в полосе нет: число уже стоит в каждой строке — сколько
      релизов у артиста, — и второе число рядом с заголовком считало бы
      другое и о том же. Он простоял здесь 5 сентября 2026 около часа. */}
  <PageBar title="Artists" />

  {/* Всё управление в липкой полосе, одинаково на списках релизов, артистов,
      лейблов и жанров: и поиск, и буквы, и сортировка возвращаются на экран
      при прокрутке вверх.

      Устройство то же, что на Music: поиск и всё управление — одной
      строкой, слева направо от «что ищем» к «как показывать». Полоса из
      двадцати восьми букв стояла отдельной строкой ниже и удалена 3
      сентября 2026: тот же выбор делает список «All letters» в общем
      ряду, и целая строка под него больше не нужна. */}
  {/* Вид переключается с 11 сентября 2026 — тем же переключателем, что на
      Music. Плитки стояли тут и раньше, до 5 сентября: в них были обложки
      чужих релизов и ничего, чего нет в строке. Нынешняя карточка говорит
      больше строки — в неё влезают обе величины сразу. */}
  <FilterBar>
    {/* Первая буква — такой же отбор с множественным выбором, как тип, жанр
        и год на Music: можно отметить сразу несколько. Полоса из двадцати
        восьми кнопок стояла здесь до 3 сентября 2026 и занимала собой целую
        строку ради того же выбора. */}
    <FilterCell name="Letters:">
      <MultiSelect id="letter" label="First letter" allLabel="All" manyLabel="Chosen" axis="letter"
                   items={ordered.map(([letter, items]) => ({ value: letter, label: letter, count: items.length }))} />
    </FilterCell>

    <FilterCell name="Sort by:">
      <Select id="sort" label="Sorting" initial="A → Z">
        <option value="az">A → Z</option>
        <option value="za">Z → A</option>
        <option value="releases">Most releases</option>
      </Select>
    </FilterCell>

    {/* Вид общий для всего сайта: тот же переключатель, что на Music. */}
    <FilterCell name="View:"><ViewSwitch /></FilterCell>
  </FilterBar>

  {/* Заголовков с буквами в списке нет: буква выбирается кнопкой в полосе
      фильтров, и заголовок над выдачей повторял бы нажатое, а в общем
      списке — резал бы его на два десятка кусков без всякой нужды.
      Группировка осталась только как порядок записей. */}
  {/* Первые PAGE строк сервер отдаёт видимыми, остальные метит data-over, и
      прячет их CSS — только при работающем скрипте: без него список показан
      целиком, как и был. До 7 сентября 2026 сервер отдавал видимыми все, а
      прятал их первый расчёт скрипта — уже после первой отрисовки: страница
      успевала нарисоваться во всю длину и тут же схлопывалась, и вместе с
      полосой прокрутки дёргались липкие полосы заголовка и отбора. */}
  <ul class="names names--two" id="list" data-first>
    {ordered.map(([letter, items]) => (
      <>
        {items.map((a) => (
          <li
            class="names__item"
            data-over={выведено++ >= PAGE ? '' : undefined}
            data-name={a.name.toLowerCase()}
            data-count={a.albumIds.length}
            data-letter={letter}
          >
            {/* Как у лейблов и жанров: два столбца, в каждом имя слева и
                величина справа. У артиста это страна — код из двух букв в
                скобках, в том же наборе, что счётчики у соседей: скобки
                говорят, что это пометка при имени, а не часть его.

                Счёт релизов и клипов из строки ушёл: в половину строки две
                величины рядом с именем не встают, а оба числа стоят на
                странице самого исполнителя. Страна из них полезнее — по ней
                каталог и просматривают, и повторить её больше негде.

                Если страны нет, место остаётся пустым: пустые скобки
                читались бы нулём. Такой в базе один — Various Artists. */}
            {/* В строке при имени стоит счёт релизов: по нему список и
                сортируется («Most releases»), и он же — то, ради чего
                исполнителя открывают. Страна стояла тут до 11 сентября
                2026 и переехала в карточку, где для неё есть место. */}
            <div class="view-row">
              <a class="row row--brief" href={`/artists/${a.slug}`}>
                <span class="row__title">{a.name}</span>
                <span class="row__val">[{a.albumIds.length}]</span>
              </a>
            </div>

            {/* Пустых скобок у страны не бывает: если её нет, пометки нет
                вовсе. Такой в базе один — Various Artists. */}
            <BriefCard
              href={`/artists/${a.slug}`}
              name={a.name}
              note={a.country ? `[${a.country}]` : null}
              left={plural(a.albumIds.length, 'release', 'releases')}
            />
          </li>
        ))}
      </>
    ))}
  </ul>

  {/* Кнопка появляется только со скриптом: без него показаны все записи,
      и «показать ещё» было бы нечего делать. */}
  <button type="button" id="more" class="more" data-page={PAGE} hidden={всего <= PAGE}>Show more [{Math.min(PAGE, всего - PAGE)}]</button>
</Base>

<script>
  const list     = document.getElementById('list');
  const sortEl   = document.getElementById('sort');
  const letterEl = document.getElementById('letter');

  const more = document.getElementById('more');

  const items = Array.from(list.querySelectorAll('.names__item'));
  const PAGE = Number(more.dataset.page) || 50;

  // Порядок с сервера — алфавитный; запоминаем как исходный, чтобы возврат
  // к нему не пришлось собирать заново.
  const initialOrder = items.slice();

  /* Порядок, в котором записи сейчас лежат в разметке. Именно по нему
     отсчитываются первые PAGE: считать по исходному массиву нельзя — после
     сортировки «первыми» станут не те. */
  let current = initialOrder;

  // Сколько записей показано. Сбрасывается при любой смене выборки.
  let limit = PAGE;

  let letters = [];

  function apply() {
    // Видимость складывается из двух условий: запись подходит под выборку
    // и попадает в текущие первые limit подходящих.
    let count = 0;

    for (const li of current) {
      const ok = (!letters.length || letters.includes(li.dataset.letter));
      if (ok) count++;
      li.hidden = !ok || count > limit;
    }

    const rest = count - limit;
    more.hidden = rest <= 0;
    if (rest > 0) more.textContent = `Show more [${Math.min(PAGE, rest)}]`;

    // Порядок A → Z — то, с чем страница открывается, поэтому он же
    // считается нетронутым состоянием.
  }

  // Любая смена выборки возвращает список к первой странице.
  function rewind() { limit = PAGE; }

  function sort() {
    const by = sortEl.value;
    if (by === 'az') current = initialOrder;
    else if (by === 'za') current = items.slice().reverse();
    else current = items.slice().sort(
      (a, b) => Number(b.dataset.count) - Number(a.dataset.count)
             || a.dataset.name.localeCompare(b.dataset.name)
    );

    const frag = document.createDocumentFragment();
    for (const el of current) frag.appendChild(el);
    list.appendChild(frag);
  }

  more.addEventListener('click', () => {
    limit += PAGE;
    apply();
  });

  /* Первую букву выбирают двумя контролами — полосой кнопок на широком
     экране и списком на узком, — а значение у них одно. Смена идёт через
     общую функцию, и второй контрол переставляется следом: человек может
     повернуть телефон, и выбор должен пережить смену ширины.

     Списку после программной смены значения посылаем input: по нему скрипт
     компонента заново подгоняет ширину кнопки под выбранный пункт. */
  /* Отбор по букве отдаёт обычное change, как отдавал список; читаем из
     него не одно значение, а перечень отмеченных. */
  letterEl.addEventListener('change', () => {
    letters = [...letterEl.querySelectorAll('input:checked')].map((b) => b.value);
    rewind();
    apply();
  });


  sortEl.addEventListener('change', () => { sort(); rewind(); apply(); });


  /* У <select> нет состояния «раскрыт» в CSS, поэтому отмечаем его сами. */
  for (const wrap of document.querySelectorAll('.select')) {
    const field = wrap.querySelector('select');
    const close = () => wrap.removeAttribute('data-open');
    field.addEventListener('mousedown', () => wrap.toggleAttribute('data-open'));
    field.addEventListener('keydown', (e) => {
      if (['Enter', ' ', 'ArrowDown', 'ArrowUp'].includes(e.key)) wrap.setAttribute('data-open', '');
    });
    field.addEventListener('change', close);
    field.addEventListener('blur', close);
  }

  /* Первый расчёт: до него в разметке видны все записи — так страница
     работает без скрипта и целиком достаётся поисковикам. */
  apply();
  list.removeAttribute('data-first');
</script>

---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { genres, albumsOf, relatedGenres, plural, coverSrc } from '../../lib/db.js';


export function getStaticPaths() {
  return genres.map((genre) => ({ params: { slug: genre.slug }, props: { genre } }));
}

const { genre } = Astro.props;
const releases = albumsOf(genre.albumIds);
const related = relatedGenres(genre);
---
<Base
  title={`${genre.name} · ant brigade`}
  description={`${genre.name}: ${plural(releases.length, 'release', 'releases')} in the collection.`}
  image={coverSrc(releases.find((a) => a.cover), 800)}
  activeSection="genres"
>
  <Breadcrumbs name={genre.name} place />

  <div class="page-head">
    <h1>{genre.name}</h1>
    <p class="counter">[{releases.length}]</p>
  </div>

  {/* Related в строку: подпись и сами жанры на одной горизонтали, а не
      двумя колонками, как в остальных списках фактов. */}
  {related.length > 0 && (
    <div class="related">
      <span class="related__label mono mono--sm">Related</span>
      <p class="meta-line">
        {related.map((g, i) => (
          <>
            {i > 0 && <span class="sep"> · </span>}
            <a href={`/genres/${g.slug}`}>{g.name}</a>
          </>
        ))}
      </p>
    </div>
  )}

  <section class="section">
    <ul class="tiles tiles--auto">
      {releases.map((album) => <AlbumCard album={album} />)}
    </ul>
  </section>
</Base>

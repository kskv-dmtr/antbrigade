---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
/* Полоса «назад» и строка пути удалены из проекта 6 сентября 2026 вместе с
   компонентами BackBar и Breadcrumbs. Путь дублировал то, что и так стоит на
   странице, а кнопка «назад» повторяла кнопку браузера — и занимала целую
   полосу поперёк первого экрана. Достать их можно из истории. */
import PageBar from '../../components/PageBar.astro';
import { genres, albumsOf, artistsOf, plural, coverSrc } from '../../lib/db.js';

export function getStaticPaths() {
  return genres.map((genre) => ({ params: { slug: genre.slug }, props: { genre } }));
}

const { genre } = Astro.props;
const releases = albumsOf(genre.albumIds);

/* Исполнители жанра — из его же релизов. Через Map, а не через фильтр: у
   релиза бывает двое исполнителей, и у одного исполнителя обычно несколько
   релизов в жанре, иначе имя попало бы в строку несколько раз.

   По алфавиту, как список на /artists. Порядок, в котором имена приходят из
   albumIds, идёт из Notion и ничего не значит — тот же довод, что у
   «More Releases» на странице релиза. */
const roster = [...new Map(
  releases.flatMap((a) => artistsOf(a.artistIds)).map((a) => [a.id, a])
).values()].sort((a, b) => a.name.localeCompare(b.name));
---
<Base
  title={`${genre.name} · ant brigade`}
  description={`${genre.name}: ${plural(releases.length, 'release', 'releases')} in the collection.`}
  image={coverSrc(releases.find((a) => a.cover), 800)}
  activeSection="genres"
>
  {/* Полоса «назад» — как на остальных внутренних страницах. */}
  {/* Первый блок — тот же, что у исполнителя и лейбла: слева имя, справа
      справка строками. У жанра справки всего одна — исполнители. */}
  <article class="item item--page">
    <div class="item__lead">
      <h1 class="item__title">{genre.name}</h1>
    </div>

    <div class="item__head">
      <dl class="item__facts">
        {roster.length > 0 && (
          <div class="item__fact">
            <dt>{roster.length > 1 ? 'Artists:' : 'Artist:'}</dt>
            <dd>
              {roster.map((a, i) => (
                <>
                  {i > 0 && <span class="sep"> · </span>}
                  <a href={`/artists/${a.slug}`}>{a.name}</a>
                </>
              ))}
            </dd>
          </div>
        )}
      </dl>
    </div>
  </article>

  <section class="section">
    <PageBar as="h2" title="Releases" count={releases.length} />
    <ul class="tiles tiles--auto">
      {releases.map((album) => <AlbumCard album={album} />)}
    </ul>
  </section>
</Base>

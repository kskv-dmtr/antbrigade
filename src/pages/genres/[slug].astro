---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { genres, albumsOf, relatedGenres, plural } from '../../lib/db.js';

export function getStaticPaths() {
  return genres.map((genre) => ({ params: { slug: genre.slug }, props: { genre } }));
}

const { genre } = Astro.props;
const releases = albumsOf(genre.albumIds);
const related = relatedGenres(genre);

const years = releases.map((a) => a.year).filter(Boolean);
const span = years.length ? [Math.min(...years), Math.max(...years)] : null;
---
<Base
  title={`${genre.name} · music`}
  description={`${genre.name}: ${plural(releases.length, 'релиз', 'релиза', 'релизов')} в коллекции.`}
  activeSection="genres"
>
  <div class="page-head">
    <h1>{genre.name}</h1>
    <p class="counter">
      {plural(releases.length, 'релиз', 'релиза', 'релизов')}
      {span && span[0] !== span[1] && <span class="counter__span"> · {span[0]}–{span[1]}</span>}
      {span && span[0] === span[1] && <span class="counter__span"> · {span[0]}</span>}
    </p>
  </div>

  {related.length > 0 && (
    <dl class="facts facts--wide">
      <dt>Рядом</dt>
      <dd class="chips">
        {related.map((g) => (
          <a class="chip chip--link" href={`/genres/${g.slug}/`}>{g.name}</a>
        ))}
      </dd>
    </dl>
  )}

  <section class="section">
    <ul class="grid">
      {releases.map((album) => <AlbumCard album={album} />)}
    </ul>
  </section>
</Base>

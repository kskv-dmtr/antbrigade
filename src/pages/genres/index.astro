---
import Base from '../../layouts/Base.astro';
import NameTile from '../../components/NameTile.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import SearchField from '../../components/SearchField.astro';
import Select from '../../components/Select.astro';
import { genres, albumsOf } from '../../lib/db.js';

/* Раскладка та же, что у артистов и лейблов: по первой букве, порядок
   алфавитный. Прежний, «сначала крупные жанры», остался в сортировке под
   именем Most releases. */
function bucket(name) {
  const ch = name.trim()[0]?.toUpperCase() ?? '#';
  return /[A-Z]/.test(ch) ? ch : '#';
}

const byName = genres.slice().sort((a, b) => a.name.localeCompare(b.name));

const groups = new Map();
for (const g of byName) {
  const key = bucket(g.name);
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key).push(g);
}
const ordered = [...groups.entries()].sort(([a], [b]) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});

const solo = genres.filter((g) => g.count === 1).length;
---
<Base
  title="Genres · ant brigade"
  description={`${genres.length} genres in the collection.`}
  activeSection="genres"
>
  <div class="page-head">
    <h1>Genres</h1>
    {/* Счётчик пуст, пока не фильтруют: общее число в шапке не нужно, а
        обратная связь по поиску — нужна. */}
    <p class="counter" id="counter" aria-live="polite"></p>
  </div>

  <div class="sticky-bar">
    <div class="controls__top">
      <SearchField label="Search by genre name" />
      <ViewSwitch />
    </div>

    <div class="filters filters--scroll">
      {/* Первая буква — тот же сегментированный переключатель, что тип
          релиза на Music и вид ролика на Videos: кнопка «все» и дальше по
          кнопке на букву. Отсеивает список, а не уводит к заголовку. */}
      <div class="seg seg--letters" id="alphabet" role="group" aria-label="First letter">
        <button type="button" data-letter="" aria-pressed="true">All</button>
        {ordered.map(([letter]) => (
          <button type="button" data-letter={letter} aria-pressed="false">{letter}</button>
        ))}
      </div>

      <div class="filters__group filters__group--end">
        <Select id="sort" label="Sorting">
          <option value="az">A → Z</option>
          <option value="za">Z → A</option>
          <option value="releases">Most releases</option>
        </Select>
      </div>
    </div>
  </div>

  <p class="empty" id="empty" hidden>Nothing found.</p>

  {/* Заголовков с буквами в списке нет: буква выбирается кнопкой в полосе
      фильтров, и заголовок над выдачей повторял бы нажатое, а в общем
      списке — резал бы его на два десятка кусков без всякой нужды.
      Группировка осталась только как порядок записей. */}
  <ul class="names" id="list" data-view="list">
    {ordered.map(([letter, items]) => (
      <>
        {items.map((genre) => (
          <li
            class="names__item"
            data-search={genre.name.toLowerCase()}
            data-name={genre.name.toLowerCase()}
            data-count={genre.count}
            data-letter={letter}
          >
            <a class="row row--name view-row" href={`/genres/${genre.slug}`}>
              <span class="row__title">{genre.name}</span>
              <span class="row__num">[{genre.count}]</span>
            </a>
            <NameTile
              class="view-tile"
              href={`/genres/${genre.slug}`}
              name={genre.name}
              releases={albumsOf(genre.albumIds)}
            />
          </li>
        ))}
      </>
    ))}
  </ul>

  <p class="foot-note">
    {solo} of them {solo === 1 ? 'has' : 'have'} a single release.
  </p>
</Base>

<script>
  const search  = document.getElementById('search');
  const empty   = document.getElementById('empty');
  const counter = document.getElementById('counter');
  const list     = document.getElementById('list');
  const viewsEl  = document.getElementById('views');
  const sortEl   = document.getElementById('sort');
  const alphabet = document.getElementById('alphabet');

  const items = Array.from(list.querySelectorAll('.names__item'));
  const total = items.length;

  // Порядок с сервера — алфавитный; запоминаем как исходный, чтобы возврат
  // к нему не пришлось собирать заново.
  const initialOrder = items.slice();

  let query = '';
  let letter = '';

  function apply() {
    let count = 0;

    for (const li of items) {
      const ok = (!query || li.dataset.search.includes(query)) &&
                 (!letter || li.dataset.letter === letter);
      li.hidden = !ok;
      if (ok) count++;
    }

    empty.hidden = count > 0;
    // Пусто, пока не фильтруют: общее число в шапке ни к чему.
    counter.textContent = (query || letter) ? count + ' of ' + total : '';
  }

  function sort() {
    const by = sortEl.value;
    let order;
    if (by === 'az') order = initialOrder;
    else if (by === 'za') order = items.slice().reverse();
    else order = items.slice().sort(
      (a, b) => Number(b.dataset.count) - Number(a.dataset.count)
             || a.dataset.name.localeCompare(b.dataset.name)
    );

    const frag = document.createDocumentFragment();
    for (const el of order) frag.appendChild(el);
    list.appendChild(frag);
  }

  alphabet.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    letter = btn.dataset.letter;
    for (const b of alphabet.children) b.setAttribute('aria-pressed', String(b === btn));
    apply();
  });

  viewsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    list.dataset.view = btn.dataset.view;
    for (const b of viewsEl.children) b.setAttribute('aria-pressed', String(b === btn));
  });

  sortEl.addEventListener('change', () => { sort(); apply(); });

  let timer;
  search.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      query = search.value.trim().toLowerCase();
      apply();
    }, 120);
  });

  for (const wrap of document.querySelectorAll('.select')) {
    const field = wrap.querySelector('select');
    const close = () => wrap.removeAttribute('data-open');
    field.addEventListener('mousedown', () => wrap.toggleAttribute('data-open'));
    field.addEventListener('keydown', (e) => {
      if (['Enter', ' ', 'ArrowDown', 'ArrowUp'].includes(e.key)) wrap.setAttribute('data-open', '');
    });
    field.addEventListener('change', close);
    field.addEventListener('blur', close);
  }
</script>

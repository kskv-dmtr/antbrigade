---
import Base from '../../layouts/Base.astro';
import { genres, plural } from '../../lib/db.js';

// genres уже отсортированы по числу релизов — крупные жанры сверху
const solo = genres.filter((g) => g.count === 1).length;
---
<Base
  title="Genres · ant brigade"
  description={`${genres.length} genres in the collection.`}
  activeSection="genres"
>
  <div class="page-head">
    <h1>Genres</h1>
    <p class="counter" id="counter" aria-live="polite">
      {plural(genres.length, 'genre', 'genres')}
    </p>
  </div>

  <div class="controls">
    <div class="search">
      <input type="search" id="search" placeholder="Genre name" autocomplete="off"
             spellcheck="false" aria-label="Search by genre name" />
    </div>
  </div>

  <p class="empty" id="empty" hidden>Nothing found.</p>

  <ul class="genre-cloud" id="list">
    {genres.map((genre) => (
      <li data-search={genre.name.toLowerCase()}>
        <a href={`/genres/${genre.slug}/`}>
          <span class="genre-cloud__name">{genre.name}</span>
          <span class="genre-cloud__count">{genre.count}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="foot-note">
    {solo} of them {solo === 1 ? 'has' : 'have'} a single release.
  </p>
</Base>

<script>
  const search  = document.getElementById('search');
  const empty   = document.getElementById('empty');
  const counter = document.getElementById('counter');
  const items   = Array.from(document.querySelectorAll('#list li'));
  const total   = items.length;

  const plural = (n) => `${n} ${n === 1 ? 'genre' : 'genres'}`;

  let timer;
  search.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      for (const li of items) {
        const ok = !q || li.dataset.search.includes(q);
        li.hidden = !ok;
        if (ok) shown++;
      }
      empty.hidden = shown > 0;
      counter.textContent = shown === total ? plural(total) : shown + ' of ' + total;
    }, 120);
  });
</script>

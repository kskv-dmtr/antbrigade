---
import Base from '../layouts/Base.astro';
import RandomPicks from '../components/RandomPicks.astro';
import { albums } from '../lib/db.js';

/* Главная — витрина, а не каталог: весь список живёт на /music.

   Раздел на ней с 11 сентября 2026 один — случайная подборка. «Latest
   Releases», двенадцать свежих обложек, стоял первым до того дня: свежее
   и так лежит первым на /music, куда ведёт и меню, и кнопка; на витрине этот
   раздел повторял её начало.

   Сам раздел — общий компонент RandomPicks: та же вещь стоит на странице
   промаха, и с 12 сентября 2026 у них одна разметка и один скрипт. */

/* Фишер — Йетс. Не `sort(() => Math.random() - 0.5)`: та перестановка
   заметно смещённая, часть записей оседает у краёв. */
function shuffle(list) {
  const a = list.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/* Пул — весь каталог, с 12 сентября 2026. Случайность на статике даёт
   браузер: при каждой загрузке он берёт из пула случайный разворот, а
   кнопка листает дальше — и теперь ему есть из чего выбирать, сколько ни
   нажимай.

   Раньше в пул отбиралась верхушка перетасованного списка — шестьдесят
   записей, потом полтораста, потом двести, — и разнообразие держалось не
   глубиной пула, а тем, что сайт пересобирается часто: каждая сборка
   тасовала каталог заново. Выходило, что витрине нужен частый деплой ради
   одной только жеребьёвки, а деплой — это выгрузка всей сборки целиком, со
   всеми обложками. Полный пул это развязывает: подборка перестала зависеть
   от того, как часто собирается сайт.

   Платит за это разметка витрины: карточка с обложкой весит 612 байт, и
   страница выросла со 136 КБ до восьмисот с лишним. Плитки за первым
   разворотом помечены hidden — картинки у них ленивые и не скачиваются,
   пока до них не долистают.

   Тасуется на сборке, то есть порядок одинаков для всех, кто открыл сайт
   между двумя сборками; браузер выбирает в нём место, а не сам порядок.
   Тасовать в браузере нельзя — первая отрисовка пошла бы с подменой
   обложек, ровно тем миганием, от которого ушли 7 сентября 2026. */
const pool = shuffle(albums);
---
<Base
  title="ant brigade"
  cardTitle="ant brigade — a personal music & video archive"
  description={`Covers, genres, labels and where to listen. ${albums.length} releases, synced from Notion.`}
  activeSection="home"
  shortcuts="random"
>
  {/* Имя страницы — первой строкой и в тот же кегль 72, что имя исполнителя,
      лейбла, жанра и заголовок подборок. До 11 сентября 2026 своего имени у
      витрины не было вовсе: её открывал заголовок раздела «Latest Releases»
      в 32, и страница читалась началом списка, а не отдельной страницей.

      Под именем — строка о том, как собрана подборка: тем же набором и на
      том же месте, где на странице промаха стоят «Status» и «Reason». Строка
      без подписи, в отличие от тех: подписывать нечем — это не сведение о
      странице, а объяснение, по какому правилу она себя ведёт.

      Обещаний в ней два, и оба проверяемы: случайные и без порядка. Третьим
      стояло «The pool rotates every hour» — обещание, которое держалось на
      почасовой сборке. Сборка идёт не каждый час (GitHub запускает
      расписание пять-семь раз в сутки), а с полным пулом обновлять его
      сборкой больше и не нужно: каталог в разметке весь.

      Набрана строка тремя предложениями, а не одним с запятой: каждое —
      отдельное обещание, и точка делит их ровнее.

      Оба коротких обещания обёрнуты в неразрывное: перенос приходится как раз
      на них, и «no» оставалось висеть в конце строки, а «algorithm» или
      «order» уезжало на следующую.

      На телефоне (до 640) строка ломается всегда в одном месте — после
      «releases.»: первой строкой описание, второй оба обещания вместе. Так
      решено 17 сентября 2026; перенос задан стилем (lead__note--steps), а не
      оставлен ширине экрана, которая ломала то после «No algorithm.», то
      после «releases.». От 641 всё в одну строку.

      Набрана как в предложении, а не прописными, как остальные такие строки
      сайта (lead__note--sentence), — решение владельца 21 сентября 2026:
      это фраза, а не служебная пометка. */}
  <div class="lead">
    <h1 class="item__title">Lucky Finds</h1>
    <p class="lead__note lead__note--steps lead__note--sentence"><span>Some random releases.</span> <span class="nb">No algorithm.</span> <span class="nb">No order.</span></p>
  </div>

  <RandomPicks pool={pool} />
</Base>

<script>
  /* Клавиша R — «Dig again», новая горсть случайных релизов (22 сентября
     2026, просьба владельца). Только на главной: на странице промаха тот же
     раздел, но клавиши там не просили. Как F, S и I: по коду клавиши (в
     русской раскладке — «К»), без сочетаний — Ctrl+R и Cmd+R остаются
     перезагрузкой, — и не пока набирают текст. Нажимаем саму кнопку: её
     обработчик листает пул, подгружает следующую горсть и тасует заново,
     когда пул кончился. Кнопок две — в полосе и под подборкой; обработчик
     у них общий, так что годится любая. */
  const копать = document.querySelector('.dig-again');
  if (копать) {
    addEventListener('keydown', (e) => {
      if (e.code !== 'KeyR' || e.metaKey || e.ctrlKey || e.altKey || e.repeat) return;
      const el = document.activeElement;
      if (el && (el.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName))) return;
      e.preventDefault();
      копать.click();
    });
  }
</script>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AlbumCard from '../components/AlbumCard.astro';
import ReleaseRow from '../components/ReleaseRow.astro';
import Select from '../components/Select.astro';
import ViewSwitch from '../components/ViewSwitch.astro';
import { albums, plural } from '../lib/db.js';

// Карточки рендерятся на сервере все сразу: так страница работает без JS
// и её видят поисковики. Фильтры лишь прячут лишнее.
const types = [...new Set(albums.flatMap((a) => a.types))].sort();

const genreCounts = new Map();
for (const a of albums) {
  for (const g of a.genres) genreCounts.set(g, (genreCounts.get(g) || 0) + 1);
}
const genres = [...genreCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const years = [...new Set(albums.map((a) => a.year).filter(Boolean))].sort((a, b) => b - a);
const span = years.length ? `${years[0]} — ${years[years.length - 1]}` : '';

/* Порядок с сервера — «сначала новые», поэтому ведущая работа и три плитки
   это просто первые четыре записи.

   В макете индекс начинался с пятой: вынесенные наверх релизы в список не
   попадали. Здесь они попадают — иначе поиск по самому свежему альбому
   отвечал бы «ничего не найдено», а фильтры молча теряли бы четыре записи. */
const [lead, ...rest] = albums;
const featured = rest.slice(0, 3);
---
<Base
  title="ant brigade — album collection"
  description={`A collection of ${albums.length} releases: covers, genres, labels and links to listen.`}
  activeSection="albums"
>
  {lead && <Hero album={lead} />}

  {featured.length > 0 && (
    <section class="section">
      <ul class="tiles">
        {featured.map((a) => <AlbumCard album={a} />)}
      </ul>
    </section>
  )}

  <section class="section">
    <div class="head">
      <h1 class="display display--md">Releases</h1>
      <span class="mono" id="counter" aria-live="polite">
        {plural(albums.length, 'release', 'releases')}{span && ` · ${span}`}
      </span>
    </div>

    <div class="controls">
      <div class="search">
        <input type="search" id="search" placeholder="Artist or album" autocomplete="off"
               spellcheck="false" aria-label="Search by artist or album" />
      </div>

      <div class="filters">
        <div class="filters__group">
          <div class="seg" id="types" role="group" aria-label="Release type">
            <button type="button" data-type="" aria-pressed="true">All</button>
            {types.map((t) => <button type="button" data-type={t} aria-pressed="false">{t}</button>)}
          </div>

          {/* Индекс строками — вид по умолчанию, как в макете. Стена обложек
              осталась вторым видом: в каталоге пластинок обложка — это тоже
              содержание, и терять её целиком было бы неправильно. */}
          <ViewSwitch />
        </div>

        <div class="filters__group">
          <Select id="genre" label="Genre">
            <option value="">All genres</option>
            {genres.map(([g, n]) => <option value={g}>{g} ({n})</option>)}
          </Select>

          <Select id="year" label="Year">
            <option value="">All years</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </Select>

          <Select id="sort" label="Sorting">
            <option value="new">Newest first</option>
            <option value="old">Oldest first</option>
            <option value="artist">By artist</option>
            <option value="album">By album</option>
          </Select>

          <button type="button" id="reset" class="reset" hidden>Reset</button>
        </div>
      </div>
    </div>

    <p class="empty" id="empty" hidden>Nothing found.</p>

    {/* Один <li> на релиз, внутри обе разметки: строка и плитка. Видимую
        выбирает data-view на списке, поэтому фильтру достаточно спрятать
        сам <li> — переключение вида его не касается. */}
    <ul class="releases" id="grid" data-view="index">
      {albums.map((a, i) => (
        <li
          class="release"
          data-search={`${a.artist} ${a.album}`.toLowerCase()}
          data-genres={a.genres.join('|')}
          data-types={a.types.join('|')}
          data-year={a.year ?? ''}
          data-released={a.released ?? ''}
          data-artist={a.artist.toLowerCase()}
          data-album={(a.album || '').toLowerCase()}
        >
          <div class="view-row"><ReleaseRow album={a} n={i + 1} /></div>
          <AlbumCard album={a} as="div" class="view-tile" />
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  const grid    = document.getElementById('grid');
  const cards   = Array.from(grid.children);
  const counter = document.getElementById('counter');
  const empty   = document.getElementById('empty');
  const reset   = document.getElementById('reset');
  const search  = document.getElementById('search');
  const typesEl = document.getElementById('types');
  const viewsEl = document.getElementById('views');
  const genreEl = document.getElementById('genre');
  const yearEl  = document.getElementById('year');
  const sortEl  = document.getElementById('sort');

  const total = cards.length;
  const state = { q: '', type: '', genre: '', year: '', sort: 'new' };

  // Порядок с сервера — «сначала новые»; запоминаем его как исходный.
  const initialOrder = cards.slice();

  // Хвост подписи («· 2026 — 2019») переживает фильтрацию: он про каталог,
  // а не про выборку.
  const span = (counter.textContent.split('·')[1] || '').trim();
  const label = (n) => {
    const head = n === total ? `${n} ${n === 1 ? 'release' : 'releases'}` : `${n} of ${total}`;
    return span ? `${head} · ${span}` : head;
  };

  function matches(el) {
    const d = el.dataset;
    if (state.q && !d.search.includes(state.q)) return false;
    if (state.type && !d.types.split('|').includes(state.type)) return false;
    if (state.genre && !d.genres.split('|').includes(state.genre)) return false;
    if (state.year && d.year !== state.year) return false;
    return true;
  }

  function apply() {
    let shown = 0;
    for (const el of cards) {
      const ok = matches(el);
      el.hidden = !ok;
      if (ok) shown++;
    }

    empty.hidden = shown > 0;
    counter.textContent = label(shown);

    const dirty = state.q || state.type || state.genre || state.year || state.sort !== 'new';
    reset.hidden = !dirty;
  }

  function sort() {
    const by = state.sort;
    let order;
    if (by === 'new') {
      order = initialOrder;
    } else {
      order = cards.slice().sort((a, b) => {
        if (by === 'artist') return a.dataset.artist.localeCompare(b.dataset.artist);
        if (by === 'album')  return a.dataset.album.localeCompare(b.dataset.album);
        const da = a.dataset.released, db = b.dataset.released;
        // релизы без даты всегда в конце
        if (!da && !db) return 0;
        if (!da) return 1;
        if (!db) return -1;
        return da.localeCompare(db);
      });
    }
    const frag = document.createDocumentFragment();
    for (const el of order) frag.appendChild(el);
    grid.appendChild(frag);
  }

  let timer;
  search.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      state.q = search.value.trim().toLowerCase();
      apply();
    }, 120);
  });

  typesEl.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    state.type = btn.dataset.type;
    for (const b of typesEl.children) b.setAttribute('aria-pressed', String(b === btn));
    apply();
  });

  viewsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    grid.dataset.view = btn.dataset.view;
    for (const b of viewsEl.children) b.setAttribute('aria-pressed', String(b === btn));
  });

  genreEl.addEventListener('change', () => { state.genre = genreEl.value; apply(); });
  yearEl.addEventListener('change',  () => { state.year  = yearEl.value;  apply(); });
  sortEl.addEventListener('change',  () => { state.sort  = sortEl.value;  sort(); apply(); });

  /* У <select> нет состояния «раскрыт» в CSS, поэтому отмечаем его сами:
     стрелка должна смотреть вверх, пока список открыт. */
  for (const wrap of document.querySelectorAll('.select')) {
    const field = wrap.querySelector('select');
    const close = () => wrap.removeAttribute('data-open');
    field.addEventListener('mousedown', () => {
      wrap.toggleAttribute('data-open');
    });
    field.addEventListener('keydown', (e) => {
      if (['Enter', ' ', 'ArrowDown', 'ArrowUp'].includes(e.key)) wrap.setAttribute('data-open', '');
    });
    field.addEventListener('change', close);
    field.addEventListener('blur', close);
  }

  reset.addEventListener('click', () => {
    Object.assign(state, { q: '', type: '', genre: '', year: '', sort: 'new' });
    search.value = '';
    genreEl.value = '';
    yearEl.value = '';
    sortEl.value = 'new';
    for (const [i, b] of [...typesEl.children].entries()) {
      b.setAttribute('aria-pressed', String(i === 0));
    }
    sort();
    apply();
    window.scrollTo({ top: 0 });
  });
</script>

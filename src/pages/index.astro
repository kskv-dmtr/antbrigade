---
import Base from '../layouts/Base.astro';
import AlbumCard from '../components/AlbumCard.astro';
import Icon from '../components/Icon.astro';
import { albums } from '../lib/db.js';

/* Главная — витрина, а не каталог: весь список живёт на /music.

   Раздел на ней с 11 сентября 2026 один — случайная подборка. «Latest
   Releases», двенадцать свежих обложек, стоял первым до того дня: свежее
   и так лежит первым на /music, куда ведёт и меню, и кнопка; на витрине этот
   раздел повторял её начало.

   SHOW — сколько видно за раз: восемь, два полных ряда по четыре на
   расчётных 1920. Двенадцать, три ряда, стояли до 11 сентября 2026: витрина
   с одним разделом занимала ими полтора экрана, а её дело — показать горсть
   и отпустить в каталог.

   Восемь ложится на четыре столбца и на два; на трёх (от 900 до 1280) в
   последнем ряду остаются две обложки из трёх — там ряд и так неполный при
   любом числе, кратном четырём.

   POOL — глубина пула, из которого кнопка листает дальше. */
const POOL = 150;
const SHOW = 8;

/* Фишер — Йетс. Не `sort(() => Math.random() - 0.5)`: та перестановка
   заметно смещённая, часть записей оседает у краёв. */
function shuffle(list) {
  const a = list.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}


/* Пул выбирается на сборке и потому одинаков для всех, кто открыл сайт в
   один час. Случайность на статике даёт браузер: он тасует пул при каждой
   загрузке и показывает из него SHOW штук, а кнопка листает дальше. Пул
   пересобирается вместе с сайтом, а сайт пересобирается ежечасно из-за
   синхронизации с Notion — так что и он не застаивается.

   Полтораста записей — это пятнадцать подборок подряд без повторов и
   примерно 55 КБ разметки сверх прежних шестидесяти. Больше брать смысла
   мало: до конца пула долистывают единицы, а вес платят все.

   Берём из всего каталога: раздела со свежими на витрине больше нет, и
   исключать из пула нечего. До 11 сентября 2026 первые двенадцать записей
   пропускались — они стояли выше своим разделом. */
const pool = shuffle(albums).slice(0, POOL);
---
<Base
  title="ant brigade"
  cardTitle="ant brigade — a personal music archive"
  description={`Covers, genres, labels and where to listen. ${albums.length} releases, synced hourly from Notion.`}
  activeSection="home"
>
  {/* Имя страницы — первой строкой и в тот же кегль 72, что имя исполнителя,
      лейбла, жанра и заголовок подборок. До 11 сентября 2026 своего имени у
      витрины не было вовсе: её открывал заголовок раздела «Latest Releases»
      в 32, и страница читалась началом списка, а не отдельной страницей. */}
  <div class="lead">
    <h1 class="item__title">Lucky Finds</h1>
  </div>

  <section class="section">
    {/* Полоса липкая, как у разделов на внутренних страницах: пока листаешь
        две дюжины обложек, должно быть видно, что именно листаешь. */}
    <div class="head head--sticky head--bare head--dot">
      <div class="head__lead">
        <h2 class="display display--md"><Icon name="circle" class="mark" />Random Pick</h2>
      </div>

      {/* Без скрипта кнопки не видно: подборку меняет он, а сервер отдаёт
          всем один и тот же HTML. */}
      <button type="button" class="dig-again"><span class="btn-label">Dig again</span></button>
    </div>

    {/* Пул отдаётся целиком, но видны только первые SHOW: без скрипта
        страница показывает осмысленную выборку и не мигает подменой
        картинок сразу после загрузки. */}
    <ul class="tiles tiles--auto" id="dig" data-show={SHOW}>
      {pool.map((a, i) => <AlbumCard album={a} hidden={i >= SHOW} />)}
    </ul>

    {/* На телефоне кнопка стоит под подборкой и липнет к низу экрана, пока
        этот раздел на виду: листать две дюжины обложек, чтобы дотянуться до
        «ещё», — не дело. Двойник в разметке, а не переезд стилями — перенести
        узел из одного контейнера в другой средствами CSS нельзя. Виден ровно
        один: второй скрыт медиазапросом и в дерево доступности не попадает. */}
    <button type="button" class="dig-again dig-again--below"><span class="btn-label">Dig again</span></button>
  </section>
</Base>

<script>
  /* Случайные релизы при каждой загрузке и новая подборка по нажатию.

     Сайт статический: сервер отдаёт всем один и тот же HTML, поэтому
     выбирает браузер. В разметке лежит пул, отсюда тасуем его и оставляем
     видимыми первые data-show.

     Нажатие не тасует пул заново, а листает его дальше. При повторной
     жеребьёвке десяти из полутораста ожидаемое пересечение с предыдущей
     подборкой — две трети плитки, и время от времени одна и та же обложка
     оставалась бы на месте: нажатие читалось бы как сбой, а не как
     обновление. Листание же даёт пятнадцать подборок подряд, у которых нет
     ни одного общего релиза. */
  const dig   = document.getElementById('dig');
  const items = Array.from(dig.children);
  const базово = Number(dig.dataset.show) || 8;
  const agains = document.querySelectorAll('.dig-again');

  /* Ряд всегда полный. Столбцов в решётке бывает четыре, три или два — их
     число задано в --cols и меняется медиазапросами, — а показываем мы
     восемь обложек. На трёх столбцах восьмёрка оставила бы в последнем ряду
     две обложки из трёх, поэтому округляем вверх до кратного: 8 при четырёх
     и двух столбцах, 9 при трёх.

     Читаем --cols, а не считаем столбцы по ширине окна: правило про
     количество столбцов живёт в CSS, и второй такой же расчёт в скрипте
     разошёлся бы с ним при первой же правке медиазапросов. */
  const столбцов = () =>
    Number(getComputedStyle(document.documentElement).getPropertyValue('--cols')) || 4;

  let show  = базово;
  let pages = 1;

  function пересчитать() {
    const c = столбцов();
    show = Math.ceil(базово / c) * c;

    /* Неполной подборки в конце пула быть не должно: ряд, оборванный на
       середине, читается как недогрузившийся. Остаток просто ждёт следующей
       тасовки. */
    pages = Math.max(1, Math.floor(items.length / show));
  }

  пересчитать();

  let order = items;
  let page = 0;

  // Фишер — Йетс. Не `sort(() => Math.random() - 0.5)`: та перестановка
  // заметно смещённая, часть записей оседает у краёв.
  function shuffle() {
    order = items.slice();
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }

    // Переставляем и в разметке, иначе выбранные шли бы вразнобой по сетке.
    const frag = document.createDocumentFragment();
    for (const el of order) frag.appendChild(el);
    dig.appendChild(frag);
  }

  function render() {
    const start = page * show;
    for (const [i, el] of order.entries()) el.hidden = i < start || i >= start + show;

    /* Следующая подборка подгружается заранее: у скрытых плиток картинки
       ленивые и к нажатию не скачаны — без этого на их месте секунду
       держалась бы пустая штриховка. */
    for (const el of order.slice(start + show, start + show * 2)) {
      for (const img of el.querySelectorAll('img[loading="lazy"]')) img.loading = 'eager';
    }
  }

  /* При загрузке показываем то, что отдал сервер: его выборка уже случайна —
     пул тасуется на сборке, а она идёт каждый час. Тасовать ещё и в браузере
     значит подменить обложки сразу после первой отрисовки: те, что сервер
     начал грузить, прячутся, а на их место встают ленивые и ещё не скачанные.
     Ровно это и мигало при каждом заходе до 7 сентября 2026.

     Нажатие листает пул дальше, а когда он кончился — тасует. */
  render();

  /* Кнопок две — в полосе раздела и под подборкой; видна всегда одна, но
     обработчик нужен обеим. */
  for (const again of agains) again.addEventListener('click', () => {
    page += 1;
    // Пул кончился — тасуем заново, и следующий круг идёт в другом порядке.
    if (page >= pages) {
      shuffle();
      page = 0;
    }
    render();
  });

  /* Столбцов при повороте телефона или растягивании окна становится больше
     или меньше, и подборку надо пересчитать: на трёх столбцах показываем
     девять, на четырёх и двух — восемь. Страница при этом остаётся та же,
     только её край подвинется; если от новой длины она уехала за конец пула,
     возвращаемся к первой.

     Следим за самой решёткой, а не за окном: ResizeObserver срабатывает на
     любое изменение её коробки, включая те, что окном не объясняются, —
     появилась полоса прокрутки, изменился масштаб страницы. Пересчёт меняет
     только видимость плиток, ширины решётки не трогает, так что бесконечного
     круга не выйдет; лишний вызов и вовсе отсекается сравнением. */
  const переложить = () => {
    const было = show;
    пересчитать();
    if (show === было) return;
    if (page >= pages) page = 0;
    render();
  };

  new ResizeObserver(переложить).observe(dig);

  /* И по событию окна заодно: наблюдатель и resize приходят из разных мест —
     первый от вёрстки, второй от окна, — и стоят дёшево оба. Пересчёт
     сравнивает число с прежним и на совпадении выходит сразу, так что двойной
     вызов ничего не стоит. */
  addEventListener('resize', переложить);
</script>

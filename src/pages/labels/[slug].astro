---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import ProfileLinks from '../../components/ProfileLinks.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { labels, albumsOf, artistsOf, countryName, plural, coverSrc } from '../../lib/db.js';

export function getStaticPaths() {
  return labels.map((label) => ({ params: { slug: label.slug }, props: { label } }));
}

const { label } = Astro.props;
const releases = albumsOf(label.albumIds);
const roster   = artistsOf(label.artistIds);
---
<Base
  title={`${label.name} · ant brigade`}
  description={`${label.name}: ${plural(releases.length, 'release', 'releases')} in the collection.`}
  image={coverSrc(releases.find((a) => a.cover), 800)}
  activeSection="labels"
>
  <Breadcrumbs section={{ href: "/labels", label: "Labels" }} name={label.name} />

  <div class="page-head">
    {/* Счёт релизов только в заголовке раздела ниже — здесь он дублировался. */}
    <h1>{label.name}</h1>
  </div>

  <ProfileLinks bandcamp={label.bandcamp} youtube={label.youtube} />

  {/* Список раньше показывался только при непустом составе — теперь в нём
      живёт ещё и страна, поэтому условие переехало на сами строки. */}
  {(label.country || roster.length > 0) && (
    <dl class="facts facts--wide">
      {label.country && (
        <>
          <dt>Country</dt>
          <dd>{countryName(label.country)}</dd>
        </>
      )}

      {roster.length > 0 && (
        <>
          <dt>{plural(roster.length, 'Artist', 'Artists')}</dt>
          <dd class="chips">
            {roster.map((a) => <a class="chip chip--link" href={`/artists/${a.slug}`}>{a.name}</a>)}
          </dd>
        </>
      )}
    </dl>
  )}

  <section class="section">
    <div class="head">
      <h2 class="display display--md">Releases</h2>
      <span class="mono">[{releases.length}]</span>
    </div>
    <ul class="tiles tiles--auto">
      {releases.map((a) => <AlbumCard album={a} />)}
    </ul>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import ProfileLinks from '../../components/ProfileLinks.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { labels, albumsOf, artistsOf, countryName, plural, coverSrc } from '../../lib/db.js';

export function getStaticPaths() {
  return labels.map((label) => ({ params: { slug: label.slug }, props: { label } }));
}

const { label } = Astro.props;
const releases = albumsOf(label.albumIds);
const roster   = artistsOf(label.artistIds);
---
<Base
  title={`${label.name} · ant brigade`}
  description={`${label.name}: ${plural(releases.length, 'release', 'releases')} in the collection.`}
  image={coverSrc(releases.find((a) => a.cover), 800)}
  activeSection="labels"
>
  <Breadcrumbs name={label.name} place />

  {/* Устройство то же, что на странице исполнителя: счёт релизов только в
      заголовке раздела ниже, а справа от имени — страна в квадратных
      скобках, по нижней его линии. */}
  <div class="page-head">
    <h1>{label.name}</h1>
    {label.country && <p class="counter">[{countryName(label.country)}]</p>}
  </div>

  {/* Под именем линейка, под ней состав во всю ширину. Полоса здесь в одну
      колонку, а не в две, как у исполнителя: справа от состава ставить
      нечего, того, что у исполнителя лежит справа, у лейбла нет. Подписи
      «Artists» нет — по именам видно, что это состав. */}
  {roster.length > 0 && (
    <div class="profile-bar profile-bar--wide">
      {/* Имена набраны и подчёркнуты так же, как жанры у исполнителя и лейбл
          внизу полосы релиза: ссылка на страницу списка везде выглядит
          одинаково. */}
      <p class="meta-line">
        {roster.map((a, i) => (
          <>
            {i > 0 && <span class="sep"> · </span>}
            <a href={`/artists/${a.slug}`}>{a.name}</a>
          </>
        ))}
      </p>
    </div>
  )}

  {/* Ссылки наружу — своим разделом, как у исполнителя: тот же заголовок,
      та же линейка, кнопки под ней слева, счётчика нет. */}
  {(label.website || label.bandcamp || label.youtube) && (
    <section class="section">
      <div class="head">
        <h2 class="display display--md">Links</h2>
      </div>
      <ProfileLinks website={label.website} bandcamp={label.bandcamp} youtube={label.youtube} />
    </section>
  )}

  <section class="section">
    <div class="head">
      <h2 class="display display--md">Releases</h2>
      <span class="mono">[{releases.length}]</span>
    </div>
    <ul class="tiles tiles--auto">
      {releases.map((a) => <AlbumCard album={a} />)}
    </ul>
  </section>
</Base>

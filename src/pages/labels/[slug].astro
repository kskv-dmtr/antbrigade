---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import TilesMore from '../../components/TilesMore.astro';
import ProfileLinks from '../../components/ProfileLinks.astro';
import GenreLinks from '../../components/GenreLinks.astro';
/* Полоса «назад» и строка пути удалены из проекта 6 сентября 2026 вместе с
   компонентами BackBar и Breadcrumbs. Путь дублировал то, что и так стоит на
   странице, а кнопка «назад» повторяла кнопку браузера — и занимала целую
   полосу поперёк первого экрана. Достать их можно из истории. */
import PageBar from '../../components/PageBar.astro';
import WholeWords from '../../components/WholeWords.astro';
import Icon from '../../components/Icon.astro';
import { labels, albumsOf, artistsOf, countryName, plural, coverSrc } from '../../lib/db.js';

export function getStaticPaths() {
  return labels.map((label) => ({ params: { slug: label.slug }, props: { label } }));
}

const { label } = Astro.props;
const releases = albumsOf(label.albumIds);
const roster   = artistsOf(label.artistIds);

/* Жанры лейбла — из его релизов: своего поля жанров у лейбла в Notion нет,
   да и не нужно, оно повторяло бы то же самое руками. Порядок по частоте:
   чем больше релизов лейбла в жанре, тем вернее он говорит, чем лейбл
   занимается. Одинаково частые — по алфавиту, чтобы порядок не плавал от
   сборки к сборке. */
const genreCounts = new Map();
for (const a of releases) {
  for (const g of a.genres ?? []) genreCounts.set(g, (genreCounts.get(g) ?? 0) + 1);
}
const genres = [...genreCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([g]) => g);

/* Подпись по числу ссылок: одна — «Link:», две и больше — «Links:»
   (22 сентября 2026, просьба владельца), как «Label:» / «Labels:». */
const linkCount = [label.bandcamp, label.bandcamp2, label.youtube].filter(Boolean).length;
---
<Base
  title={`${label.name} · ant brigade`}
  description={`${label.name}: ${plural(releases.length, 'release', 'releases')} in the collection.`}
  image={coverSrc(releases.find((a) => a.cover), 800)}
  shortcuts="info"
>
  {/* Полоса «назад» стоит на всех внутренних страницах одинаково: релиза,
      клипа, исполнителя, лейбла и жанра. На лейбле и жанре её не было до
      6 сентября 2026 — возвращаться оттуда было нечем, кроме браузерной
      стрелки. */}
  {/* Три строки, как у исполнителя: имя, полоса «Info», справка столбцами —
      Country, Links, Artists, Genres; сколько заполнено, столько столбцов,
      поровну (с 22 сентября 2026). */}
  <div class="lead">
    <h1 class="item__title"><WholeWords text={label.name} /></h1>

  </div>

  {/* Полоса «Info» сворачивает блок под собой. Родное <details>, а не
      кнопка со скриптом: работает без него, состояние помнит сам браузер, и
      найти текст поиском по странице он тоже умеет.

      Треугольник тот же, что у дропдаунов отбора, и поворачивается так же —
      вниз, когда раскрыто. Открыто по умолчанию: справка коротка, прятать
      её при первом заходе не за чем. */}
  {/* Раздел есть всегда: страна есть у каждого лейбла (у «Not on Label» —
      Worldwide, как в теге на /labels). */}
  <section class="section">
    <details class="fold" open>
      <summary class="fold__head">
        <div class="head head--sticky head--dot head--page head--wide">
          <div class="head__lead">
            <p class="display display--md"><Icon name="circle" class="mark" />Info</p>
            <span class="select__chevron fold__mark" aria-hidden="true"></span>
          </div>
        </div>
      </summary>

      {/* Справка — столбцами по порядку: Country, Links, Artists, Genres
          (22 сентября 2026, просьба владельца; страна и ссылки до того стояли
          под названием). Пустых столбцов нет, оставшиеся делят ширину
          поровну. */}
      {/* Столбец Country — всегда одна четверть, как первый из четырёх:
          когда ссылок нет (или страны — у «Not on Label», Worldwide),
          остальное делят перечни (22 сентября 2026, просьба владельца). */}
      <div class="info info--auto info--narrow-first">
        <dl class="item__facts">
          {/* Страна есть у всех, кроме «Not on Label»: у него — Worldwide
              (20 сентября 2026, просьба владельца). */}
          <div class="item__fact">
            <dt>Country:</dt>
            <dd>{label.country ? countryName(label.country) : 'Worldwide'}</dd>
          </div>
        </dl>

        {(label.bandcamp || label.bandcamp2 || label.youtube) && (
          <dl class="item__facts">
            <div class="item__fact">
              <dt>{linkCount > 1 ? 'Links:' : 'Link:'}</dt>
              <dd><ProfileLinks bandcamp={label.bandcamp} bandcamp2={label.bandcamp2} youtube={label.youtube} /></dd>
            </div>
          </dl>
        )}

        {roster.length > 0 && (
          <dl class="item__facts">
            <div class="item__fact">
              <dt>{roster.length > 1 ? 'Artists:' : 'Artist:'}</dt>
              <dd>
                {roster.map((a, i) => (
                  <>
                    {i > 0 && <span class="sep"> · </span>}
                    <a href={`/artists/${a.slug}`}><WholeWords text={a.name} /></a>
                  </>
                ))}
              </dd>
            </div>
          </dl>
        )}

        {/* Жанры — из релизов лейбла, а не из его собственного поля: такого
            поля в Notion нет. Ссылки те же, что у жанров исполнителя. */}
        {genres.length > 0 && (
          <dl class="item__facts">
            <div class="item__fact">
              <dt>{genres.length > 1 ? 'Genres:' : 'Genre:'}</dt>
              <dd><GenreLinks names={genres} inline /></dd>
            </div>
          </dl>
        )}
      </div>
    </details>
  </section>

  <section class="section">
    <PageBar as="h2" title="Releases" count={releases.length} />
    {/* Первые 48, дальше по кнопке — как на Music. */}
    <TilesMore count={releases.length}>
      {releases.map((a) => <AlbumCard album={a} />)}
    </TilesMore>
  </section>
</Base>

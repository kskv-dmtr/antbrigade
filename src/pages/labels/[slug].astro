---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import ProfileLinks from '../../components/ProfileLinks.astro';
/* Breadcrumbs убран со всех страниц 6 сентября 2026: путь дублировал то, что
   и так стоит на странице — имя исполнителя ссылкой, название раздела в
   шапке, — а возвращаться есть чем, полосой «назад». Компонент остаётся в
   проекте: понадобится — вернуть недолго. */
import PageBar from '../../components/PageBar.astro';
import BackBar from '../../components/BackBar.astro';
import { labels, albumsOf, artistsOf, countryName, plural, coverSrc } from '../../lib/db.js';

export function getStaticPaths() {
  return labels.map((label) => ({ params: { slug: label.slug }, props: { label } }));
}

const { label } = Astro.props;
const releases = albumsOf(label.albumIds);
const roster   = artistsOf(label.artistIds);
---
<Base
  title={`${label.name} · ant brigade`}
  description={`${label.name}: ${plural(releases.length, 'release', 'releases')} in the collection.`}
  image={coverSrc(releases.find((a) => a.cover), 800)}
  activeSection="labels"
>
  {/* Полоса «назад» стоит на всех внутренних страницах одинаково: релиза,
      клипа, исполнителя, лейбла и жанра. На лейбле и жанре её не было до
      6 сентября 2026 — возвращаться оттуда было нечем, кроме браузерной
      стрелки. */}
  <BackBar />

  {/* Устройство то же, что на странице исполнителя: счёт релизов только в
      заголовке раздела ниже, а страна — справа от имени, по нижней его
      линии, тем же набором, что счётчики на списках. */}
  <div class="page-head page-head--country">
    <h1>{label.name}</h1>
    {label.country && <p class="counter">[{countryName(label.country)}]</p>}
  </div>

  {/* Ссылки наружу стоят прямо под именем, без заголовка и линейки — как и
      у исполнителя: заголовок «Links» с чертой во всю ширину ради одной-двух
      кнопок весил больше, чем сами кнопки, а рядом такие же заголовки ведут
      к спискам и сеткам.

      Просвет до имени держит поле .page-head, а свой отступ снизу — ряд
      кнопок; ниже он схлопывается с полем первого раздела. */}
  {(label.bandcamp || label.youtube) && (
    <ProfileLinks bandcamp={label.bandcamp} youtube={label.youtube} />
  )}

  {/* Состав — той же полосой, что разделы с плитками: кружок, название,
      счётчик слева, перечень имён в правой половине. Так же собраны жанры и
      лейблы на странице исполнителя.

      Имена набраны и подчёркнуты так же, как жанры у исполнителя и лейбл
      в справке релиза: ссылка на страницу списка везде выглядит
      одинаково. */}
  {roster.length > 0 && (
    <section class="section">
      <PageBar as="h2" title={roster.length > 1 ? 'Artists' : 'Artist'} count={roster.length}>
        <p class="meta-line">
          {roster.map((a, i) => (
            <>
              {i > 0 && <span class="sep"> · </span>}
              <a href={`/artists/${a.slug}`}>{a.name}</a>
            </>
          ))}
        </p>
      </PageBar>
    </section>
  )}

  <section class="section">
    <PageBar as="h2" title="Releases" count={releases.length} />
    <ul class="tiles tiles--auto">
      {releases.map((a) => <AlbumCard album={a} />)}
    </ul>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import ProfileLinks from '../../components/ProfileLinks.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { labels, albumsOf, artistsOf, countryName, plural, coverSrc } from '../../lib/db.js';

export function getStaticPaths() {
  return labels.map((label) => ({ params: { slug: label.slug }, props: { label } }));
}

const { label } = Astro.props;
const releases = albumsOf(label.albumIds);
const roster   = artistsOf(label.artistIds);
---
<Base
  title={`${label.name} · ant brigade`}
  description={`${label.name}: ${plural(releases.length, 'release', 'releases')} in the collection.`}
  image={coverSrc(releases.find((a) => a.cover), 800)}
  activeSection="labels"
>
  <Breadcrumbs name={label.name} place />

  {/* Устройство то же, что на странице исполнителя: счёт релизов только в
      заголовке раздела ниже, а страна — справа от имени, по нижней его
      линии, тем же набором, что счётчики на списках. */}
  <div class="page-head page-head--country">
    <h1>{label.name}</h1>
    {label.country && <p class="counter">[{countryName(label.country)}]</p>}
  </div>

  {/* Ссылки наружу стоят прямо под именем, без заголовка и линейки — как и
      у исполнителя: заголовок «Links» с чертой во всю ширину ради одной-двух
      кнопок весил больше, чем сами кнопки, а рядом такие же заголовки ведут
      к спискам и сеткам.

      Просвет до имени держит поле .page-head, а свой отступ снизу — ряд
      кнопок; ниже он схлопывается с полем первого раздела. */}
  {(label.website || label.bandcamp || label.youtube) && (
    <ProfileLinks website={label.website} bandcamp={label.bandcamp} youtube={label.youtube} />
  )}

  {/* Состав — своим разделом, как лейблы на странице исполнителя. Заголовок склоняется по числу, а счётчик
      стоит справа всегда — как у соседних разделов.

      Имена набраны и подчёркнуты так же, как жанры у исполнителя и лейбл
      внизу полосы релиза: ссылка на страницу списка везде выглядит
      одинаково. */}
  {roster.length > 0 && (
    <section class="section">
      <div class="head">
        <h2 class="display display--md">{roster.length > 1 ? 'Artists' : 'Artist'}</h2>
        <span class="mono">[{roster.length}]</span>
      </div>
      <p class="meta-line">
        {roster.map((a, i) => (
          <>
            {i > 0 && <span class="sep"> · </span>}
            <a href={`/artists/${a.slug}`}>{a.name}</a>
          </>
        ))}
      </p>
    </section>
  )}

  <section class="section">
    <div class="head">
      <h2 class="display display--md">Releases</h2>
      <span class="mono">[{releases.length}]</span>
    </div>
    <ul class="tiles tiles--auto">
      {releases.map((a) => <AlbumCard album={a} />)}
    </ul>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoRow from '../components/VideoRow.astro';
import SearchField from '../components/SearchField.astro';
import Select from '../components/Select.astro';
import ViewSwitch from '../components/ViewSwitch.astro';
import { videos, videoTitle, videoArtists } from '../lib/db.js';
import { fold } from '../lib/fold.js';

/* Клипы были разбросаны по страницам артистов, и увидеть их все было негде.
   Здесь они собраны в один список — тем же устройством, что релизы: строка
   или плитка, поиск, вид и сортировка.

   Порядок по умолчанию — по исполнителю. Сортировки «сначала свежие» здесь
   нет и быть не может: даты у клипов не хранится. */
/* Порядок фильтра задан руками, а не алфавитом: клипов официального вида в
   базе полсотни, живых выступлений — единицы, и по алфавиту редкий вид
   вставал первым. Виды, которых в списке нет, уходят в конец по алфавиту —
   новый вид из Notion появится в полосе сам, просто не впереди.

   Сверяем в нижнем регистре: имена приходят из Notion как есть, и однажды
   их там уже переписали — «Official Video» стал «Official video». Точное
   сравнение тогда молча перестало совпадать, и полоса вернулась к
   алфавиту, никак об этом не сообщив.

   Подписи тоже свои: в Notion вид записан в единственном числе, а на кнопке
   фильтра читается множественное — нажимаешь не на один ролик, а на все
   сразу. Ключом фильтра остаётся значение из Notion, подпись только
   показывается. */
const KIND_LABELS = new Map([
  ['official video', 'Official Videos'],
  ['live performance', 'Live Performances'],
  ['official visualizer', 'Official Visualizers']
]);
const rank = (k) => {
  const i = [...KIND_LABELS.keys()].indexOf(k.toLowerCase());
  return i < 0 ? KIND_LABELS.size : i;
};

const kinds = [...new Set(videos.map((v) => v.kind).filter(Boolean))]
  .sort((a, b) => rank(a) - rank(b) || a.localeCompare(b))
  .map((value) => ({ value, label: KIND_LABELS.get(value.toLowerCase()) ?? value }));

/* Порядок с сервера — от свежих к старым, как на Music: с ним страница
   открывается, к нему возвращает Reset, и он же остаётся без скрипта.
   Дальше по имени и названию — чтобы у клипов одной даты порядок был
   устойчивым, а не зависел от порядка в выгрузке. */
const list = videos
  .slice()
  .sort((a, b) =>
    (b.released ?? '').localeCompare(a.released ?? '') ||
    videoArtists(a).localeCompare(videoArtists(b)) ||
    videoTitle(a).localeCompare(videoTitle(b)));

// Сколько записей показывать сразу и сколько добавлять по нажатию — как на Music.
const PAGE = 50;
---
<Base
  title="Videos · ant brigade"
  description={`${videos.length} music videos and live sets from the collection.`}
  activeSection="videos"
>
  <div class="page-head">
    <h1>Videos</h1>
    {/* Число в квадратных скобках, как на Music. До выполнения скрипта видны
        все клипы — значение в разметке совпадает с первым расчётом. */}
    <p class="counter" id="counter" aria-live="polite">[{videos.length}]</p>
  </div>

  <div class="sticky-bar">
    <div class="controls__top">
      <SearchField label="Search by artist or title" />
      <ViewSwitch />
    </div>

    {/* Вид ролика слева, сортировка справа — та же расстановка, что на
        Music: выборка у левого края, порядок у правого. Одной группой у
        правого края они уже стояли, и сортировка читалась приклеенной к
        тегам, а не отдельным органом управления. */}
    <div class="filters">
      {/* Вид ролика показан двумя способами разом, и лишний прячет
          медиазапрос: на широком экране полоса кнопок, на узком — список
          рядом с сортировкой. Как тип релиза на Music. */}
      <div class="filters__group filters__group--strip">
        <div class="seg" id="kinds" role="group" aria-label="Video kind">
          <button type="button" data-kind="" aria-pressed="true">All</button>
          {kinds.map((k) => (
            <button type="button" data-kind={k.value} aria-pressed="false">{k.label}</button>
          ))}
        </div>
      </div>

      <div class="filters__group filters__group--end">
        <Select id="kind" label="Video kind" class="select--strip">
          <option value="">All</option>
          {kinds.map((k) => <option value={k.value}>{k.label}</option>)}
        </Select>

        {/* Порядок пунктов тот же, что на Music: сначала по дате, потом по
            алфавиту, и у каждой оси обе стороны. По умолчанию тоже как на
            Music — «Newest first»: с ним страница открывается и к нему
            возвращает Reset. */}
        <Select id="sort" label="Sorting">
          <option value="new" selected>Newest first</option>
          <option value="old">Oldest first</option>
          <option value="artist-az">Artists A → Z</option>
          <option value="artist-za">Artists Z → A</option>
          <option value="title-az">Titles A → Z</option>
          <option value="title-za">Titles Z → A</option>
        </Select>

        {/* Появляется, только когда есть что сбрасывать, — как на Music. */}
        <button type="button" id="reset" class="reset" hidden>Reset</button>
      </div>
    </div>
  </div>

  <p class="empty" id="empty" hidden>Nothing found.</p>

  {/* Один <li> на клип, внутри обе разметки: строка и плитка. Видимую
      выбирает data-view на списке. */}
  <ul class="releases videos" id="list" data-view="list">
    {list.map((v) => (
      <li
        class="release"
        data-search={fold(`${videoArtists(v)} ${videoTitle(v)}`)}
        data-kind={v.kind ?? ''}
        data-artist={videoArtists(v).toLowerCase()}
        data-title={videoTitle(v).toLowerCase()}
        data-released={v.released ?? ''}
      >
        <div class="view-row"><VideoRow video={v} /></div>
        <VideoCard video={v} as="div" class="view-tile" showArtist />
      </li>
    ))}
  </ul>

  {/* Кнопка появляется только со скриптом: без него показаны все записи,
      и «показать ещё» было бы нечего делать. */}
  <button type="button" id="more" class="more" data-page={PAGE} hidden></button>
</Base>

<script>
  import { fold } from '../lib/fold.js';

  const list    = document.getElementById('list');
  const cards   = Array.from(list.children);
  const counter = document.getElementById('counter');
  const empty   = document.getElementById('empty');
  const search  = document.getElementById('search');
  const kindsEl = document.getElementById('kinds');
  const kindEl  = document.getElementById('kind');
  const viewsEl = document.getElementById('views');
  const sortEl  = document.getElementById('sort');
  const reset   = document.getElementById('reset');
  const more    = document.getElementById('more');

  const total = cards.length;
  const PAGE  = Number(more.dataset.page) || 50;
  const state = { q: '', kind: '' };

  // Порядок с сервера — «сначала новые»; запоминаем его как исходный.
  const initialOrder = cards.slice();

  /* Порядок, в котором записи сейчас лежат в разметке. Именно по нему
     отсчитываются первые PAGE: считать по исходному массиву нельзя — после
     сортировки «первыми» станут не те. */
  let current = initialOrder;

  // Сколько записей показано. Сбрасывается при любой смене выборки.
  let limit = PAGE;

  function apply() {
    // Видимость складывается из двух условий: запись подходит под выборку
    // и попадает в текущие первые limit подходящих.
    let shown = 0;
    for (const el of current) {
      const d = el.dataset;
      const ok = (!state.q || d.search.includes(state.q)) &&
                 (!state.kind || d.kind === state.kind);
      if (ok) shown++;
      el.hidden = !ok || shown > limit;
    }
    empty.hidden = shown > 0;
    // Как на Music: пока ничего не отсеяно — одно число, дальше «сколько
    // из скольких».
    counter.textContent = shown === total ? `[${shown}]` : `[${shown} / ${total}]`;

    const rest = shown - limit;
    more.hidden = rest <= 0;
    if (rest > 0) more.textContent = `Show more [${Math.min(PAGE, rest)}]`;

    // Порядок по исполнителю — то, с чем страница открывается, поэтому он
    // же считается нетронутым состоянием.
    reset.hidden = !(state.q || state.kind || sortEl.value !== 'new');
  }

  // Любая смена выборки возвращает список к первой странице.
  function rewind() { limit = PAGE; }

  function sort() {
    const by = sortEl.value;
    if (by === 'new') {
      current = initialOrder;
    } else if (by === 'artist-az') {
      current = cards.slice().sort((a, b) => a.dataset.artist.localeCompare(b.dataset.artist));
    } else if (by === 'artist-za') {
      /* Разворачиваем по имени, а не переворачиваем весь список: сортировка
         устойчива, и у клипов одного исполнителя порядок остаётся тем же,
         что в прямую сторону, — от свежих к старым. Полный reverse
         перевернул бы и его. */
      current = cards.slice().sort((a, b) => b.dataset.artist.localeCompare(a.dataset.artist));
    } else if (by === 'title-az') {
      current = cards.slice().sort((a, b) => a.dataset.title.localeCompare(b.dataset.title));
    } else if (by === 'title-za') {
      current = cards.slice().sort((a, b) => b.dataset.title.localeCompare(a.dataset.title));
    } else {
      /* По дате. Сортировка устойчива, поэтому у клипов с одной датой
         сохраняется порядок с сервера — по исполнителю. Клипы без даты
         всегда в конце: сейчас дата есть у всех 78, но колонка в Notion
         заполняется руками, и новая запись может прийти без неё. */
      current = cards.slice().sort((a, b) => {
        const da = a.dataset.released, db = b.dataset.released;
        if (!da && !db) return 0;
        if (!da) return 1;
        if (!db) return -1;
        return by === 'old' ? da.localeCompare(db) : db.localeCompare(da);
      });
    }

    const frag = document.createDocumentFragment();
    for (const el of current) frag.appendChild(el);
    list.appendChild(frag);
  }

  more.addEventListener('click', () => {
    limit += PAGE;
    apply();
  });

  /* Вид ролика выбирают двумя контролами — полосой кнопок на широком экране
     и списком на узком, — а значение у них одно. Смена идёт через общую
     функцию, и второй контрол переставляется следом: человек может
     повернуть телефон, и выбор должен пережить смену ширины.

     Списку после программной смены значения посылаем input: по нему скрипт
     компонента заново подгоняет ширину кнопки под выбранный пункт. */
  function setKind(value) {
    state.kind = value;
    for (const b of kindsEl.children) {
      b.setAttribute('aria-pressed', String(b.dataset.kind === value));
    }
    if (kindEl.value !== value) {
      kindEl.value = value;
      kindEl.dispatchEvent(new Event('input'));
    }
    rewind();
    apply();
  }

  kindsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (btn) setKind(btn.dataset.kind);
  });

  kindEl.addEventListener('change', () => setKind(kindEl.value));

  viewsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn) return;
    list.dataset.view = btn.dataset.view;
    for (const b of viewsEl.children) b.setAttribute('aria-pressed', String(b === btn));
  });

  sortEl.addEventListener('change', () => { sort(); rewind(); apply(); });

  reset.addEventListener('click', () => {
    Object.assign(state, { q: '', kind: '' });
    search.value = '';
    kindEl.value = '';
    sortEl.value = 'new';
    /* Значения поставлены из кода, и сами по себе событий не рождают —
       сообщаем о смене, чтобы списки пересчитали свою ширину. */
    for (const el of [kindEl, sortEl]) el.dispatchEvent(new Event('input'));
    for (const [i, b] of [...kindsEl.children].entries()) {
      b.setAttribute('aria-pressed', String(i === 0));
    }
    sort();
    rewind();
    apply();
    window.scrollTo({ top: 0 });
  });

  let timer;
  search.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      state.q = fold(search.value.trim());
      rewind();
      apply();
    }, 120);
  });

  /* У <select> нет состояния «раскрыт» в CSS, поэтому отмечаем его сами. */
  for (const wrap of document.querySelectorAll('.select')) {
    const field = wrap.querySelector('select');
    const close = () => wrap.removeAttribute('data-open');
    field.addEventListener('mousedown', () => wrap.toggleAttribute('data-open'));
    field.addEventListener('keydown', (e) => {
      if (['Enter', ' ', 'ArrowDown', 'ArrowUp'].includes(e.key)) wrap.setAttribute('data-open', '');
    });
    field.addEventListener('change', close);
    field.addEventListener('blur', close);
  }

  /* Первый расчёт: до него в разметке видны все записи — так страница
     работает без скрипта и целиком достаётся поисковикам. */
  apply();
</script>

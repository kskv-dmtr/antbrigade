---
/* Страница клипа — та же полоса с кадром и заголовком, что у релиза.
   Отличается пропорцией кадра: 16:9 вместо квадратной обложки.

   Проигрывателя здесь нет и не будет: встроенный плеер тянет скрипты и
   кадры с доменов YouTube, а их в России режут — на странице осталась бы
   серая дыра. Поэтому кадр свой, скачанный, а смотреть уводим ссылкой. */

import Base from '../../layouts/Base.astro';
import VideoCard from '../../components/VideoCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { videos, artistsOf, videosOf, thumbSrc, videoTitle, formatDate } from '../../lib/db.js';

export function getStaticPaths() {
  return videos.map((video) => ({ params: { slug: video.slug }, props: { video } }));
}

const { video } = Astro.props;
const artists = artistsOf(video.artistIds);
const title = videoTitle(video);
const thumb = thumbSrc(video, 960);

/* Дата выхода — той же строкой внизу полосы, что «дата · лейбл» у релиза.
   Колонка «Release Date» в таблице клипов заполнена не у всех, поэтому
   строка условная: без даты внизу остаётся одна кнопка. */
const dateText = formatDate(video.released);

/* Другие клипы тех же исполнителей. Через Map, а не через фильтр: у клипа
   бывает двое исполнителей, и общий ролик иначе попал бы в список дважды. */
const rest = [...new Map(
  artists
    .flatMap((a) => videosOf(a.videoIds))
    .filter((v) => v.id !== video.id)
    .map((v) => [v.id, v])
).values()];
---
<Base
  title={`${title} · ant brigade`}
  description={`${artists.map((a) => a.name).join(' · ')} — ${title}${video.kind ? `. ${video.kind}.` : '.'}`}
  image={thumb}
  activeSection="videos"
>
  <Breadcrumbs
    trail={artists.map((a) => ({ href: `/artists/${a.slug}`, label: a.name }))}
    name={title}
  />

  <article class="detail">
    <div class="detail__banner detail__banner--video">
      {thumb && (
        <img class="detail__art detail__art--video" src={thumb} width="960" height="540"
             alt={`${title} still`} fetchpriority="high" />
      )}
      {/* Две опоры и воздух между ними, как на странице релиза: вид ролика,
          название и имя прижаты к верху полосы, кнопка — к низу, и обе
          колонки заканчиваются на одной линии.

          Внизу дата выхода — та же строка, что «дата · лейбл» у релиза, но
          без лейбла: его в записи клипа нет. Жанров тоже нет, поэтому
          линейка одна, перед кнопкой, а не две. */}
      <div class="detail__head">
        <div class="detail__name">
          {video.kind && <p class="detail__kicker">{video.kind}</p>}
          <h1 class="detail__title detail__title--video">{title}</h1>
          <p class="detail__artist">
            {artists.map((a, i) => (
              <>
                {i > 0 && <span class="sep"> · </span>}
                <a href={`/artists/${a.slug}`}>{a.name}</a>
              </>
            ))}
          </p>
        </div>

        <div class="detail__meta">
          {dateText && <p class="detail__fact">{dateText}</p>}

          {/* Тот же ряд, что «где послушать» у релиза: название площадки без
              пояснений и без стрелки — на странице релиза кнопки набраны так
              же, и «Watch on» рядом с ними выглядело бы объяснением
              очевидного. Ряд переехал из этажа под полосой внутрь неё, туда
              же, где кнопки площадок у релиза. */}
          <div class="listen">
            <a class="listen__platform" href={video.url} target="_blank" rel="noopener noreferrer">
              YouTube
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  {rest.length > 0 && (
    <section class="section">
      <div class="head">
        {/* Без имени исполнителя: оно уже стоит в полосе над разделом, и
            в заголовке повторялось бы третий раз за экран. */}
        <h2 class="display display--md">More Videos</h2>
        <span class="mono">[{rest.length}]</span>
      </div>
      <ul class="tiles tiles--auto tiles--video">
        {rest.map((v) => <VideoCard video={v} />)}
      </ul>
    </section>
  )}
</Base>

---
/* Страница клипа — та же полоса с кадром и заголовком, что у релиза.
   Отличается пропорцией кадра: 16:9 вместо квадратной обложки.

   Проигрывателя здесь нет и не будет: встроенный плеер тянет скрипты и
   кадры с доменов YouTube, а их в России режут — на странице осталась бы
   серая дыра. Поэтому кадр свой, скачанный, а смотреть уводим ссылкой. */

import Base from '../../layouts/Base.astro';
import WholeWords from '../../components/WholeWords.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import VideoCard from '../../components/VideoCard.astro';
/* Полоса «назад» и строка пути удалены из проекта 6 сентября 2026 вместе с
   компонентами BackBar и Breadcrumbs. Путь дублировал то, что и так стоит на
   странице, а кнопка «назад» повторяла кнопку браузера — и занимала целую
   полосу поперёк первого экрана. Достать их можно из истории. */
import PageBar from '../../components/PageBar.astro';
import Icon from '../../components/Icon.astro';
import { videos, artistsOf, videosOf, albumsOf, thumbSrc, videoTitle, formatDate } from '../../lib/db.js';

/* Номер записи в базе — тот, что стоит в полосе заголовка справа. Считается
   на сборке: порядковое место в том же перечне, из которого собираются все
   страницы. Место это не вечное — пополнилась база, и номер уехал, — но он и
   не адрес: адрес у страницы свой, в нём slug. Номер здесь говорит «столько
   всего, и вот где мы среди них», как счётчик отбора в списках. */
export function getStaticPaths() {
  return videos.map((video, i) => ({
    params: { slug: video.slug },
    props: { video, номер: i + 1 }
  }));
}

const { video, номер } = Astro.props;
const artists = artistsOf(video.artistIds);
const title = videoTitle(video);
const thumb = thumbSrc(video, 960);

/* Дата выхода — той же строкой внизу полосы, что «дата · лейбл» у релиза.
   Колонка «Release Date» в таблице клипов заполнена не у всех, поэтому
   строка условная: без даты внизу остаётся одна кнопка. */
const dateText = formatDate(video.released);

/* Вид ролика и дата одной строкой под названием: «Official Video ·
   September 6, 2023» — как тип и дата у релиза. */
const выпуск = [video.kind, dateText].filter(Boolean).join(' · ');

/* Год оригинала — у роликов, выложенных много позже съёмки. Показывается
   только здесь: порядок в списках держит released, как и у релиза.

   Год, а не полная дата: 5 сентября 2026 колонка в Notion стала списком
   годов — у клипов так же, как у релизов. Форматировать нечем и незачем. */
const origText = video.origYear;

/* Другие клипы тех же исполнителей. Через Map, а не через фильтр: у клипа
   бывает двое исполнителей, и общий ролик иначе попал бы в список дважды.

   Порядок — от свежих к старым, как у дискографии ниже и как везде на сайте
   по умолчанию. Порядок из videoIds брать нельзя: в выгрузке клипы
   отсортированы по названию, потому что даты у них тогда не было. */
const rest = [...new Map(
  artists
    .flatMap((a) => videosOf(a.videoIds))
    .filter((v) => v.id !== video.id)
    .map((v) => [v.id, v])
).values()].sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));

/* Релизы тех же исполнителей — тем же приёмом и в том же порядке, что
   «More Releases» на странице релиза: через Map от повторов у совместных
   работ, от свежих к старым. */
const releases = [...new Map(
  artists.flatMap((a) => albumsOf(a.albumIds)).map((a) => [a.id, a])
).values()].sort((a, b) => (b.released ?? '').localeCompare(a.released ?? ''));
---
<Base
  title={`${title} · ant brigade`}
  description={`${artists.map((a) => a.name).join(' · ')} — ${title}${video.kind ? `. ${video.kind}.` : '.'}`}
  image={thumb}
>
  {/* Клип стоит на той же решётке и в том же блоке, что релиз: кадр в двух
      первых столбцах, справа ячейка с именем и справкой во всю оставшуюся
      ширину. Разница одна — кадр 16:9 вместо квадрата, и высоту блока
      задаёт он сам: правило «первый экран во весь рост» здесь не нужно,
      кадр вдвое ниже обложки и растягивать под него экран не за чем.

      Полоса 16:7 с кадром в 58% ширины стояла здесь до 6 сентября 2026. */}
  {/* Первой строкой — полоса «Video»: кружок, название и номер, как у разделов
      ниже. Она называет блок под собой и ставит его в один ряд с ними — до неё
      блок висел под шапкой сам по себе.

      «Info» полоса звалась до 7 сентября 2026: слово называло не то, на что
      смотришь, а род сведений — и повторялось на трёх страницах подряд.

      Не сворачивается, в отличие от такой же полосы у исполнителя, лейбла и
      жанра: там под ней справка в две строки, а здесь — обложка и всё, ради
      чего страницу открыли. Треугольника поэтому нет. */}
  <section class="section">
    <PageBar as="p" title="Video" count={`${номер} / ${videos.length}`} />

    <article class="item item--video">
      <div class="item__art">
        {/* Без кадра на его месте остаётся заштрихованная заготовка тех же
            пропорций: блок не должен складываться из-за недокачанного файла.
            Сейчас кадры есть у всех. */}
        <div class="item__cover">
          {thumb && (
            <img src={thumb} width="960" height="540"
                 alt={`${title} still`} fetchpriority="high" />
          )}
        </div>
      </div>

      {/* Три опоры и воздух между ними, как у релиза: имя с названием к верху,
          справка посередине, кнопка к низу. */}
      <div class="item__head">
        {/* Имя, название и справка — одним липким блоком: при прокрутке он
            стоит под шапкой и съезжает вниз вместе с ячейкой, пока не упрётся
            в ряд кнопок снизу. Останов держит нижнее поле блока: липкий
            элемент считается по внешним полям, и поле в высоту ряда плюс
            шестнадцать оставляет ровно этот просвет. */}
        <div class="item__top">
        <div class="item__name">
          <p class="item__artist">
            {artists.map((a, i) => (
              <>
                {i > 0 && <span class="sep"> · </span>}
                <a href={`/artists/${a.slug}`}><WholeWords text={a.name} /></a>
              </>
            ))}
          </p>

          <h1 class="item__title">{title}</h1>

          {/* Вид ролика и год под названием, как тип и год у релиза. */}
          {выпуск && (
            <p class="item__meta">
              {выпуск}
              {origText && <span class="item__faint"> · originally {origText}</span>}
            </p>
          )}
        </div>

        {/* Справка строками, как у релиза. Лейбла и жанров у клипа нет, вид
            ролика стоит на месте типа издания. */}
        <dl class="item__facts">

          {/* Где смотреть — последней строкой той же справки, как площадки у
              релиза. */}
          <div class="item__fact">
            <dt>Where to watch:</dt>
            <dd><a href={video.url} target="_blank" rel="noopener noreferrer">YouTube</a></dd>
          </div>
        </dl>
        </div>

      </div>

    </article>
  </section>

  {rest.length > 0 && (
    <section class="section">
      {/* Без имени исполнителя: оно уже стоит в полосе над разделом, и
          в заголовке повторялось бы третий раз за экран. */}
      <PageBar as="h2" title="More Videos" count={rest.length} />
      <ul class="tiles tiles--auto">
        {rest.map((v) => <VideoCard video={v} />)}
      </ul>
    </section>
  )}

  {releases.length > 0 && (
    <section class="section">
      {/* Назван так же, как раздел на странице исполнителя: это тот же
          список, только собранный от клипа. */}
      <PageBar as="h2" title="Releases" count={releases.length} />
      {/* Имя на плитках — только у совместных клипов, по тому же доводу,
          что у «Releases» на странице релиза: у сольного все плитки
          принадлежат тому же исполнителю, а у дуэта сюда попадают и сольные
          работы каждого. */}
      <ul class="tiles tiles--auto">
        {releases.map((a) => <AlbumCard album={a} showArtist={artists.length > 1} />)}
      </ul>
    </section>
  )}
</Base>
